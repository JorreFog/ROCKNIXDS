+        unlock(&mu);
+    }
+    shader_on = on;
     if (!shader_on) LOG("[dsflip] shader \"%s\" unavailable: zero-copy\n", shader_nm);
+    __sync_synchronize();                          /* the output sizes and shader_on, before shader_done is seen */
