#!/bin/bash
# ROCKNIXDS: ROCKNIX's RG DS battery LED monitor (quirks/devices/Anbernic RG DS/bin/battery_led_status, GPL-2.0,
# Copyright (C) 2026 ROCKNIX), the same LEDs, thresholds, overrides and 1 s poll, without starting processes.
#
# ROCKNIX's loop starts ~12 processes a second: $(cat ...) for two sysfs files, awk (get_setting) for the LED
# brightness setting twice per poll, subshells for its helpers, and sleep. Measured with its children: 6.5% of a
# core, half of what an idle menu used after the 1.4 menu work. Here sysfs is read with bash's read, the brightness
# setting is re-read from system.cfg only when the file changed (bash, no awk), and the poll waits in read -t on a
# FIFO instead of sleep: ~0.2% of a core. install.sh points batteryledstatus.service at this only while ROCKNIX's script is the version this copy
# follows (md5 b4ce44b02bf400a915964f3f2e392f28), so a ROCKNIX change to the LEDs is never masked.
#
# Upper LED (green:power + red:status): green = normal (>20%), red = low (<=20%), blink = critical (<=5%).
# Lower LED (amber:charging): amber = charging, off = discharging / full.
# Overrides as in ROCKNIX's: THRESHOLD_LOW, THRESHOLD_CRITICAL, POLL_INTERVAL.

LED_PATH="/sys/class/leds"
BAT=/sys/class/power_supply/battery
CFG=/storage/.config/system/configs/system.cfg

THRESHOLD_LOW=${THRESHOLD_LOW:-20}
THRESHOLD_CRITICAL=${THRESHOLD_CRITICAL:-5}
POLL_INTERVAL=${POLL_INTERVAL:-1}

BRI=255
STAMP=/run/rocknixds-led-cfg        # when system.cfg was last read (a redirection sets it: no process)
read_brightness() {                 # led.brightness from system.cfg (get_setting's plain key lookup)
    # parsing the whole file in bash is the expensive part (~1% of a core every 5 s), so only when it changed
    [[ -e $STAMP && ! $CFG -nt $STAMP ]] && return
    : > $STAMP
    local k v val=
    while IFS='=' read -r k v; do [[ $k == led.brightness ]] && val=$v; done < "$CFG"
    case $val in
        mid) BRI=63 ;;
        min) BRI=15 ;;
        *)   BRI=255 ;;
    esac
}

pick_leds() {                       # UPPER/LOWER from capacity and status; LOWER is 0 or BRI
    local CAP=$1 STAT=$2
    LOWER=0
    if (( CAP <= THRESHOLD_CRITICAL )); then UPPER=blink_red
    elif (( CAP <= THRESHOLD_LOW )); then UPPER=red
    else UPPER=green; fi
    case ${STAT} in
        Charging)
            # No blinking while charging, show battery level colour + amber lower
            [ "${UPPER}" = "blink_red" ] && UPPER="red"
            LOWER=${BRI}
        ;;
        Full|"Not charging")
            UPPER="green"
        ;;
        Discharging)
            :
        ;;
        *)
            UPPER="green"
        ;;
    esac
}

led_upper() {
    case ${1} in
        green)
            echo "none" >${LED_PATH}/red:status/trigger
            echo ${BRI} >${LED_PATH}/green:power/brightness
            echo 0      >${LED_PATH}/red:status/brightness
        ;;
        red)
            echo "none" >${LED_PATH}/red:status/trigger
            echo 0      >${LED_PATH}/green:power/brightness
            echo ${BRI} >${LED_PATH}/red:status/brightness
        ;;
        blink_red)
            echo 0 >${LED_PATH}/green:power/brightness
            local BLINK; read -r BLINK < ${LED_PATH}/red:status/brightness
            [ "${BLINK}" = "0" ] && echo ${BRI} >${LED_PATH}/red:status/brightness \
                                 || echo 0      >${LED_PATH}/red:status/brightness
        ;;
    esac
}

led_lower() {
    [ "${1}" = "0" ] && echo 0      >${LED_PATH}/amber:charging/brightness \
                     || echo ${BRI} >${LED_PATH}/amber:charging/brightness
}

selftest() {
    local d
    d=$(mktemp -d)
    fail() { echo "battery-led-status selftest: $*" >&2; rm -rf "$d"; exit 1; }
    CFG=$d/system.cfg
    STAMP=$d/stamp
    printf 'led.brightness=min\nled.brightness=mid\n' > "$CFG"
    touch -d '2 minutes ago' "$CFG"
    touch "$STAMP"
    BRI=7
    read_brightness
    [ "$BRI" = 7 ] || fail "re-read system.cfg that had not changed"
    touch "$CFG"
    touch -d '2 minutes ago' "$STAMP"
    read_brightness
    [ "$BRI" = 63 ] || fail "mid brightness, got $BRI"
    printf 'led.brightness=min\n' > "$CFG"
    touch -d '2 minutes ago' "$STAMP"
    read_brightness
    [ "$BRI" = 15 ] || fail "min brightness, got $BRI"
    printf 'led.brightness=high\n' > "$CFG"
    touch -d '2 minutes ago' "$STAMP"
    read_brightness
    [ "$BRI" = 255 ] || fail "unknown brightness, got $BRI"

    BRI=255
    pick_leds 21 Discharging; [ "$UPPER $LOWER" = "green 0" ] || fail "21% discharging: $UPPER $LOWER"
    pick_leds 20 Discharging; [ "$UPPER $LOWER" = "red 0" ] || fail "20% discharging: $UPPER $LOWER"
    pick_leds 6 Discharging; [ "$UPPER $LOWER" = "red 0" ] || fail "6% discharging: $UPPER $LOWER"
    pick_leds 5 Discharging; [ "$UPPER $LOWER" = "blink_red 0" ] || fail "5% discharging: $UPPER $LOWER"
    pick_leds 0 Discharging; [ "$UPPER $LOWER" = "blink_red 0" ] || fail "0% discharging: $UPPER $LOWER"
    pick_leds 5 Charging; [ "$UPPER $LOWER" = "red 255" ] || fail "5% charging: $UPPER $LOWER"
    pick_leds 50 Charging; [ "$UPPER $LOWER" = "green 255" ] || fail "50% charging: $UPPER $LOWER"
    pick_leds 3 Full; [ "$UPPER $LOWER" = "green 0" ] || fail "full: $UPPER $LOWER"
    pick_leds 3 "Not charging"; [ "$UPPER $LOWER" = "green 0" ] || fail "not charging: $UPPER $LOWER"
    pick_leds 4 Unknown; [ "$UPPER $LOWER" = "green 0" ] || fail "unknown status: $UPPER $LOWER"
    THRESHOLD_LOW=30 THRESHOLD_CRITICAL=10
    pick_leds 10 Discharging; [ "$UPPER" = blink_red ] || fail "override critical: $UPPER"
    pick_leds 11 Discharging; [ "$UPPER" = red ] || fail "override low: $UPPER"
    pick_leds 30 Discharging; [ "$UPPER" = red ] || fail "override low edge: $UPPER"
    pick_leds 31 Discharging; [ "$UPPER" = green ] || fail "override normal: $UPPER"
    THRESHOLD_LOW=20 THRESHOLD_CRITICAL=5

    LED_PATH=$d/leds
    mkdir -p "$LED_PATH/red:status" "$LED_PATH/green:power" "$LED_PATH/amber:charging"
    echo timer > "$LED_PATH/red:status/trigger"
    echo 0 > "$LED_PATH/red:status/brightness"
    echo 9 > "$LED_PATH/green:power/brightness"
    echo 9 > "$LED_PATH/amber:charging/brightness"
    BRI=255
    led_upper blink_red
    [ "$(cat "$LED_PATH/red:status/trigger")" = timer ] || fail "blink changed the trigger"
    [ "$(cat "$LED_PATH/green:power/brightness")" = 0 ] || fail "blink left green on"
    [ "$(cat "$LED_PATH/red:status/brightness")" = 255 ] || fail "blink did not light red"
    led_upper blink_red
    [ "$(cat "$LED_PATH/red:status/brightness")" = 0 ] || fail "blink did not toggle off"
    led_upper green
    [ "$(cat "$LED_PATH/red:status/trigger")" = none ] || fail "green did not clear the red trigger"
    [ "$(cat "$LED_PATH/green:power/brightness")" = 255 ] || fail "green brightness"
    [ "$(cat "$LED_PATH/red:status/brightness")" = 0 ] || fail "green left red on"
    BRI=15
    led_lower 0
    [ "$(cat "$LED_PATH/amber:charging/brightness")" = 0 ] || fail "amber off"
    led_lower 255
    [ "$(cat "$LED_PATH/amber:charging/brightness")" = 15 ] || fail "amber follows BRI, not the argument"
    rm -rf "$d"
    echo "battery-led-status selftest ok"
}

if [ "${1:-}" = "--selftest" ]; then
    selftest
    exit 0
fi

# only while ROCKNIX's script is the one this follows: after a ROCKNIX update that changed it, run theirs instead
ORIG="/usr/lib/autostart/quirks/devices/Anbernic RG DS/bin/battery_led_status"
set -- $(md5sum "$ORIG" 2>/dev/null)
[ "$1" = b4ce44b02bf400a915964f3f2e392f28 ] || exec /usr/bin/battery_led_status

# the poll's wait: read -t on a FIFO nobody writes (a builtin; sleep would be a process per poll)
WAIT=/run/rocknixds-led-wait
[ -p $WAIT ] || { rm -f $WAIT; mkfifo $WAIT; }
exec 3<>$WAIT

PREV_UPPER=""
PREV_LOWER=""
PREV_BRI=""

while true; do
    read -r CAP < $BAT/capacity
    read -r STAT < $BAT/status
    read_brightness
    pick_leds "$CAP" "$STAT"

    BRI_CHANGED=0
    [ "${BRI}" != "${PREV_BRI}" ] && BRI_CHANGED=1 && PREV_BRI="${BRI}"

    # Always call led_upper for blink_red (needs to toggle every poll), otherwise only on state or brightness change
    if [ "${UPPER}" = "blink_red" ] || [ "${UPPER}" != "${PREV_UPPER}" ] || [ "${BRI_CHANGED}" = "1" ]; then
        led_upper ${UPPER}
        PREV_UPPER="${UPPER}"
    fi
    if [ "${LOWER}" != "${PREV_LOWER}" ] || [ "${BRI_CHANGED}" = "1" ]; then
        led_lower ${LOWER}
        PREV_LOWER="${LOWER}"
    fi

    read -t ${POLL_INTERVAL} -u 3 _ 2>/dev/null
done
