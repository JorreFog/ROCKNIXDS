+# the shader picked for this game in the in-game menu (data/menu.cfg: "shader.<game>=<picked> <the shader it was picked
+# over>"), while that is still the shader asked for here: SuperDrastic uses it, and the GPU's clock below follows it
+for ROM; do :; done
+G=$(basename "$ROM"); G=${G%.*}; B=$SHADER; [ "$B" = bilinear ] && B=none
+PICK=$(awk -v k="shader.$G=" 'index($0, k) == 1 { v = substr($0, length(k) + 1) } END { print v }' "$DSFLIP_DATA/menu.cfg" 2>/dev/null)
+[ -n "$PICK" ] && [ "${PICK#* }" = "$B" ] && SHADER=${PICK%% *}
 
