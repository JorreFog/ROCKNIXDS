 | `DSFLIP_AUDIO_PUMP` | 1 | 0 = DraStic's own SDL audio |
diff --git a/src/dsflip.c b/src/dsflip.c
index e390b9e..94b4815 100644
--- a/src/dsflip.c
+++ b/src/dsflip.c
@@ -41,6 +41,7 @@
 #include <unistd.h>
