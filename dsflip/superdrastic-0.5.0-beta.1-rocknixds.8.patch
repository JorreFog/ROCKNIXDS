+    if (n > 0) { ow = 256 * n; oh = 192 * n; }
+    if (ow <= 0 || oh <= 0 || ow > pw || oh > ph) { ow = pw; oh = ph; }   /* no fit: the panel itself */
+    out_w = ow; out_h = oh;
+    *w = ow; *h = oh;
+    return ow != pw || oh != ph;
+}
