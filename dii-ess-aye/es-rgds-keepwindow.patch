+// ROCKNIXDS (es-rgds-keepwindow.patch): fast switching. A DS game run by ROCKNIXDS's DraStic launcher switches the
+// console to another VT, so seatd hands the display to the game and back afterwards while ES waits for it: nothing
+// restarts, and the menu is back about a second after the game, whatever the size of the library. For that ES must
+// keep its window and renderer during the game: torn down (HideWindow, ROCKNIX's default on this hardware), its GL
+// re-init after the VT round trip fails (glGenTextures, SIGSEGV). So such a launch keeps them whatever HideWindow
+// says, and every other launch (other systems, DS with fast switching off) follows HideWindow as before.
+// RGDS_ES_KEEPS_WINDOW in the game's environment tells the launcher (dsflip/drastic-wrapper.sh) which it got, so both
+// sides always take the same path. dsflip/vt-switch is the switch (dsflip/fast-switch on|off), read at every launch.
+static bool rgdsKeepsWindow(FileData* game)
+{
+	if (game == nullptr || game->getSystemName() != "nds" || game->getEmulator() != "drastic")
+		return false;
+	return Utils::FileSystem::exists("/storage/.config/drastic/dsflip/vt-switch", false) &&
+		Utils::FileSystem::exists("/storage/.config/drastic/dsflip/libdsflip.so", false) &&
+		!Utils::FileSystem::exists("/storage/.config/drastic/nodsflip", false);
+}
+
+// ROCKNIXDS (es-rgds-keepwindow.patch): whether a fast-switching DS game ran. ES records the play count, time played
+// and last played only when the launch command ends with 0, and for DraStic it never does any more: ROCKNIX's
+// start_drastic.sh ends with "kill -9 $(pidof gptokeyb)" after the game, ROCKNIXDS's launcher has already stopped
+// gptokeyb (it would turn the buttons into keys under the game), so that kill fails (2) whatever the game did, and
+// since ROCKNIX 20260917 runemu.sh passes a launch's status on (as 1) instead of always 0. DS games stopped counting
+// as played and the Nintendo DS's "last played" stayed on an older game (ROCKNIXDS issue 50; GBA's RetroArch ends with
+// 0). The launcher's own verdict decides instead: libdsflip writes "ready" to /tmp/dsflip-state once the game has the
+// screens, the condition session.sh records a play on when ES is stopped for the game (fast switching off). Test
+// launches (/tmp/rocknixds-testing) don't count, as there.
+static bool rgdsGameRan(time_t since)
+{
+	struct stat st;
+	if (Utils::FileSystem::exists("/tmp/rocknixds-testing", false) || stat("/tmp/dsflip-state", &st) != 0 || st.st_mtime < since)
+		return false;
+	return Utils::String::startsWith(Utils::FileSystem::readAllText("/tmp/dsflip-state"), "ready");
+}
