+				std::string dev = f->getMetadata(MetaDataId::Developer);
+				if (dev.empty()) dev = f->getMetadata(MetaDataId::Publisher);
+				r.credits = join(playersText(f->getMetadata(MetaDataId::Players)), Utils::String::trim(dev));
+				r.desc = oneParagraph(f->getMetadata(MetaDataId::Desc));
+				std::string shot = mediaPath(f, MetaDataId::Image);
+				if (shot != r.box) r.shot = shot;
+			}
 			r.cart = mediaPath(f, MetaDataId::Cartridge);
 			r.label = mediaPath(f, MetaDataId::BoxBack);
 			r.rom = romIconOf(f);
