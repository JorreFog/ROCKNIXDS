+		// "1" -> "1 player", "1-4" / "2" -> "1-4 players" / "2 players"; anything else as it is
+		static std::string playersText(const std::string& p)
+		{
+			std::string t = Utils::String::trim(p);
+			if (t.empty() || t.find_first_not_of("0123456789-+ ") != std::string::npos) return t;
+			return t + (t == "1" ? " player" : " players");
+		}
+
+		// the description as one paragraph: line breaks and runs of spaces to single spaces
+		static std::string oneParagraph(const std::string& d)
+		{
+			std::string r;
+			bool space = false;
+			for (char c : d)
+			{
+				if (c == '\n' || c == '\r' || c == '\t' || c == ' ') { space = !r.empty(); continue; }
+				if (space) { r += ' '; space = false; }
+				r += c;
+			}
+			return r;
+		}
+
