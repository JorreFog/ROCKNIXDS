From 8a897f443a4f0b68a9d0ef8fff86502abc63e5de Mon Sep 17 00:00:00 2001
From: JorreFog <305496122+JorreFog@users.noreply.github.com>
Date: Tue, 29 Sep 2026 10:13:39 +0200
Subject: [PATCH] es-rgds-lockdown: hide settings that break ROCKNIXDS,
 verified themes only, ROCKNIXDS updates

Leaves out the dual-screen layout options (bottom screen content, display mode, this device is), the
global and per-DS-system CPU/GPU governors, video mode and screen rotation, multiscreens, the frontend
developer options, factory reset and the standalone emulator config reset (it wipes DraStic's folder),
the DS system's emulator choice, the theme downloader and ROCKNIX's own OS updates. The theme list offers
only the themes in /storage/.config/rocknixds/themes.allow. UPDATES & DOWNLOADS gets a ROCKNIXDS section
(installed version, stable/beta channel, automatic checks, check now + install) driven by
/storage/.config/rocknixds/rocknixds-update. touch /storage/.config/rocknixds/unlocked shows everything.
---
 es-app/src/guis/GuiMenu.cpp | 108 ++++++++++++++++++++++++++++--------
 1 file changed, 84 insertions(+), 24 deletions(-)

diff --git a/es-app/src/guis/GuiMenu.cpp b/es-app/src/guis/GuiMenu.cpp
index b06e8fb20..03dcb641f 100644
--- a/es-app/src/guis/GuiMenu.cpp
+++ b/es-app/src/guis/GuiMenu.cpp
@@ -36,6 +36,23 @@
 
 #include "SystemConf.h"
 #include "ApiSystem.h"
+
+// ROCKNIXDS: the settings that break the RG DS's dual-screen setup or ROCKNIXDS's DraStic are left out of the menus,
+// the theme list offers only the themes verified on it (rocknixds/themes.allow), and the updates menu updates
+// ROCKNIXDS instead of ROCKNIX. `touch /storage/.config/rocknixds/unlocked` shows everything again (development).
+#define RGDS_DIR "/storage/.config/rocknixds"
+#define RGDS_UPDATER RGDS_DIR "/rocknixds-update"
+static bool rgdsLocked() { return !Utils::FileSystem::exists(RGDS_DIR "/unlocked"); }
+static bool rgdsNds(const std::string& configName) { return rgdsLocked() && Utils::String::startsWith(configName, "nds"); }
+static std::string rgdsRun(const std::string& cmd)   // the command's last line of output
+{
+	std::string last; char buf[512];
+	FILE* p = popen(cmd.c_str(), "r");
+	if (!p) return last;
+	while (fgets(buf, sizeof buf, p)) if (buf[0] != '\n') last = buf;
+	pclose(p);
+	return Utils::String::trim(last);
+}
 #include "InputManager.h"
 #include "AudioManager.h"
 #include "FavoriteMusicManager.h"
