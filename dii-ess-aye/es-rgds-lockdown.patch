-			ApiSystem::getInstance()->isScriptingSupported(ApiSystem::UPGRADE))
+			ApiSystem::getInstance()->isScriptingSupported(ApiSystem::UPGRADE) || Utils::FileSystem::exists(RGDS_UPDATER))
