-	if (ApiSystem::getInstance()->isScriptingSupported(ApiSystem::UPGRADE))
+	if (Utils::FileSystem::exists(RGDS_UPDATER))
+	{
+		// ROCKNIXDS updates: the channel and the automatic check are rocknixds.channel / rocknixds.autocheck in
+		// system.cfg, read by rocknixds-update (which the check timer runs too); installing restarts the menu
+		updateGui->addGroup(_("ROCKNIXDS"));
+		auto theme = ThemeData::getMenuTheme();
+		std::string ver = Utils::String::trim(Utils::FileSystem::readAllText("/storage/.config/rocknixds-version"));
+		updateGui->addWithLabel(_("INSTALLED VERSION"), std::make_shared<TextComponent>(mWindow, ver.empty() ? "?" : ver, theme->Text.font, theme->Text.color));
+		auto channel = std::make_shared<OptionListComponent<std::string>>(mWindow, _("UPDATE CHANNEL"), false);
+		std::string ch = SystemConf::getInstance()->get("rocknixds.channel");
+		channel->add(_("STABLE RELEASES"), "stable", ch != "beta");
+		channel->add(_("BETA (TESTING)"), "beta", ch == "beta");
+		updateGui->addWithLabel(_("UPDATE CHANNEL"), channel);
+		updateGui->addSaveFunc([channel] { SystemConf::getInstance()->set("rocknixds.channel", channel->getSelected()); });
+		updateGui->addSwitch(_("CHECK FOR UPDATES AUTOMATICALLY"), "rocknixds.autocheck", false);
+		updateGui->addEntry(_("CHECK FOR UPDATES NOW"), false, [this, channel]
+		{
+			if (!checkNetwork())
+				return;
+			SystemConf::getInstance()->set("rocknixds.channel", channel->getSelected());
+			SystemConf::getInstance()->saveSystemConf();
+			Window* window = mWindow;
+			window->pushGui(new GuiLoading<std::string>(window, _("CHECKING FOR UPDATES"), [](auto gui)
+			{
+				return rgdsRun(RGDS_UPDATER " check");
+			}, [window](std::string result)
+			{
+				if (Utils::String::startsWith(result, "UPDATE "))
+					window->pushGui(new GuiMsgBox(window, _("A ROCKNIXDS UPDATE IS AVAILABLE:") + "\n" + result.substr(7) + "\n\n" +
+						_("INSTALL IT NOW? THE MENU CLOSES WHILE IT INSTALLS AND COMES BACK WHEN IT'S DONE."), _("YES"), []
+					{
+						rgdsRun(RGDS_UPDATER " install");   // detached: the installer restarts the menu
+					}, _("NO"), nullptr));
+				else
+					window->pushGui(new GuiMsgBox(window, result.empty() ? _("COULDN'T CHECK FOR UPDATES") : result, _("OK"), nullptr));
+			}));
+		});
+	}
+
