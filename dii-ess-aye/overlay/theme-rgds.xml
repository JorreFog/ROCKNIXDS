<?xml version="1.0" encoding="UTF-8"?>
<theme defaultTransition="instant" defaultView="gamecarousel">
    <formatVersion>7</formatVersion>

    <!--
        Device: Anbernic RG DS
        Display: 1920x480 (three 640x480 screens horizontally spanned)
        Top screen (left): X 0-0.333, center X=0.167
        Bottom screen (middle): X 0.333-0.666, center X=0.5
        Right screen (dummy): X 0.666-1.0, center X=0.833 (unused, background only)
    -->

    <!-- This section generously provided by Ant (https://github.com/anthonycaccese)
    ///
    View: Screen
    ///
    -->
    <view name="screen">
        <!-- Start: Resets -->
        <controllerActivity name="controllerActivity">
            <visible>false</visible>
        </controllerActivity>
        <batteryIndicator name="batteryIndicator">
            <visible>false</visible>
        </batteryIndicator>
        <text name="clock">
            <pos>1 1</pos>
        </text>
        <!-- End: Resets -->
    </view>

    <!-- Global elements -->
    <view name="system, gamecarousel">
        <!-- Both screens -->
        <image name="background" extra="true">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>${themePath}/assets/images/common/background_plain.svg</path>
            <zIndex>0</zIndex>
        </image>
        <image name="background_grid" extra="true">
            <pos>0 0</pos>
            <size>1.0208333 1.0833333</size><!-- 1960x520 -->
            <path>${themePath}/assets/images/common/grid.svg</path>
            <zIndex>0.1</zIndex>
            <storyboard repeat="forever">
                <animation property="pos" from="0 0" to="-0.0104167 -0.0416667" duration="6000" repeat="forever"/>
            </storyboard>
        </image>

        <!-- Top screen status strip behind the clock / battery -->
        <image name="status_bar" extra="true">
            <pos>0 0</pos>
            <size>0.3333333 0.0916667</size><!-- 640x44 -->
            <path>${themePath}/assets/images/common/status_bar.svg</path>
            <zIndex>0.5</zIndex>
        </image>

        <!-- Top screen (X 0-0.333) -->
        
        <!-- This section (and its graphics) generously provided by Ant (https://github.com/anthonycaccese) -->
        <!-- Start: System Indicators -->
        <stackpanel name="system-indicators-left,system-indicators-right" extra="true">
            <w>0.3229</w><!-- 620 -->
            <h>0.05625</h><!-- 27 -->
            <separator>5</separator>
            <pos>0.0052083 0.0166667</pos><!-- 10 8 -->
        </stackpanel>
        <stackpanel name="system-indicators-left" extra="true">
            <orientation>horizontal</orientation>
            <reverse>false</reverse>
            <clock name="system-clock">
                <color>E8E9EBFF</color>
                <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
                <fontSize>0.0333333</fontSize><!-- 16px -->
                <lineSpacing>1</lineSpacing>
            </clock>
        </stackpanel>
        <stackpanel name="system-indicators-right" extra="true">
            <orientation>horizontal</orientation>
            <reverse>true</reverse>
            <batteryText name="system-battery-text">
                <color>E8E9EBFF</color>
                <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
                <fontSize>0.0333333</fontSize><!-- 16px -->
                <lineSpacing>1</lineSpacing>
            </batteryText>
            <batteryIcon name="system-battery-icon">
                <maxSize>1 1</maxSize>
                <full>${themePath}/assets/images/common/battery_icon_100.svg</full>
                <at75>${themePath}/assets/images/common/battery_icon_75.svg</at75>
                <at50>${themePath}/assets/images/common/battery_icon_50.svg</at50>
                <at25>${themePath}/assets/images/common/battery_icon_25.svg</at25>
                <empty>${themePath}/assets/images/common/battery_icon_0.svg</empty>
                <incharge>${themePath}/assets/images/common/battery_icon_charging.svg</incharge>
            </batteryIcon>
            <networkIcon name="system-network-icon">
                <maxSize>1 1</maxSize>
                <color>E8E9EBFF</color>
                <networkIcon>${themePath}/assets/images/common/network_icon_on.svg</networkIcon>
                <planemodeIcon>${themePath}/assets/images/common/network_icon_off.svg</planemodeIcon>
            </networkIcon>
        </stackpanel>
        <!-- End: System Indicators -->

        <image name="left_tab_image" extra="true">
            <path>${themePath}/assets/images/common/left_tab.svg</path>
            <pos>0 0.85</pos>
            <size>0.0833 0.15</size>
            <zIndex>1</zIndex>
        </image>

        <text name="left_tab_text" extra="true">
            <text>Prev</text>
            <pos>0.040625 0.8708333</pos><!-- after the badge (x30..66): 78..148 x 418..480, centred group -->
            <size>0.0364583 0.1291667</size>
            <verticalAlignment>center</verticalAlignment>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0333333</fontSize><!-- 16px -->
            <color>E8E9EBFF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>

        <image name="right_tab_image" extra="true">
            <path>${themePath}/assets/images/common/right_tab.svg</path>
            <pos>0.25 0.85</pos>
            <size>0.0833 0.15</size>
            <zIndex>1</zIndex>
        </image>

        <text name="right_tab_text" extra="true">
            <text>Next</text>
            <pos>0.25625 0.8708333</pos><!-- before the badge (x574..610): 492..566 x 418..480, centred group -->
            <size>0.0385417 0.1291667</size>
            <verticalAlignment>center</verticalAlignment>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0333333</fontSize><!-- 16px -->
            <color>E8E9EBFF</color>
            <alignment>right</alignment>
            <zIndex>2</zIndex>
        </text>

        <!-- Bottom screen (X 0.333-0.666) -->
        <image name="text_bubble" extra="true">
            <path>${themePath}/assets/images/common/text_bubble.svg</path>
            <pos>0.5 0.2666667</pos><!-- y50..206, tail towards the selected icon -->
            <origin>0.5 0.5</origin>
            <size>0.2395833 0.325</size><!-- 460x156 -->
            <zIndex>56</zIndex>
        </image>

        <image name="start_window" extra="true">
            <path>${themePath}/assets/images/common/start_window.svg</path>
            <pos>0.5 0.67</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.12 0.32</maxSize>
            <zIndex>55</zIndex>
            <opacity>0</opacity>
            <!-- System menu: the carousel has no item templates, so the frame can't ride on the icon. Each system has
                 its own copy of this extra, and ES restarts its default storyboard when that system gets selected.
                 Invisible during the 500 ms slide (it framed two half icons mid-scroll), fades in once the icon arrives. -->
            <storyboard>
                <animation property="opacity" begin="450" from="0" to="1" duration="120"/>
                <animation property="scale" begin="450" from="1" to="1.035" duration="900" autoReverse="true" repeat="forever" mode="easeInOut"/>
            </storyboard>
        </image>

        <!-- Scroll bar: the thumb shows where the selection is in the list.
             x = groove start + (index-1)/(count-1) * travel  (702px + 432px travel) -->
        <image name="scroll_track" extra="true">
            <path>${themePath}/assets/images/common/scroll_track.svg</path>
            <pos>0.34375 0.9125</pos><!-- 660,438 -->
            <size>0.3125 0.0583333</size><!-- 600x28 -->
            <zIndex>1</zIndex>
        </image>
        <image name="scroll_thumb" extra="true">
            <path>${themePath}/assets/images/common/scroll_thumb.svg</path>
            <x>{system:count} &gt; 1 ? 0.365625 + ({system:index} - 1) / ({system:count} - 1) * 0.225 : 0.478125</x>
            <y>0.9208333</y>
            <w>0.04375</w><!-- 84x20 -->
            <h>0.0416667</h>
            <zIndex>2</zIndex>
        </image>
        <text name="scroll_label" extra="true">
            <visible>false</visible>
            <text>{system:index} of {system:count}</text>
            <x>{system:count} &gt; 1 ? 0.365625 + ({system:index} - 1) / ({system:count} - 1) * 0.225 : 0.478125</x>
            <y>0.9208333</y>
            <w>0.04375</w>
            <h>0.0416667</h>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0291667</fontSize><!-- 14px: fits the 84x20 thumb in the DSi font -->
            <color>FFFFFFFF</color>
            <alignment>center</alignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>3</zIndex>
        </text>

        <!-- Visibility override -->
        <helpsystem name="help">
            <textColor>00000000</textColor>
            <iconColor>00000000</iconColor>
        </helpsystem>
    </view>

    <!-- Main system selection menu -->
    <view name="system">
        <!-- Top screen (X 0-0.333): one hero card (home_hero_panel.svg at x16..624 y58..398): the system's icon in a
             glowing well, its name, maker and counts beside it, and two stat tiles along the bottom. The date sits in
             the status bar next to the clock. Canvas fractions are x/1920, y/480. -->
        <clock name="home_date" extra="true">
            <format>%A, %B %e</format>
            <pos>0.1666667 0.0458333</pos><!-- status bar centre, 320,22 -->
            <origin>0.5 0.5</origin>
            <size>0.15 0.0625</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0333333</fontSize><!-- 16px -->
            <color>A9AFB8FF</color>
            <alignment>center</alignment>
            <zIndex>2</zIndex>
        </clock>
        <image name="home_hero_panel" extra="true">
            <path>${themePath}/assets/images/common/home_hero_panel.svg</path>
            <pos>0.1666667 0.475</pos><!-- x16..624 y58..398 -->
            <origin>0.5 0.5</origin>
            <size>0.3166667 0.7083333</size>
            <zIndex>1</zIndex>
        </image>
        <image name="home_glow" extra="true">
            <path>${themePath}/assets/images/common/logo_glow.svg</path>
            <pos>0.0671875 0.35625</pos><!-- icon well centre 129,171 -->
            <origin>0.5 0.5</origin>
            <size>0.1458333 0.5</size><!-- 280x240 -->
            <zIndex>1.5</zIndex>
            <storyboard repeat="forever">
                <animation property="opacity" from="0.55" to="1" duration="1800" autoReverse="true" repeat="forever" mode="easeInOut"/>
            </storyboard>
        </image>
        <image name="home_system_icon" extra="true">
            <path>${themePath}/assets/images/systems/default.png</path><!-- fallback, like the carousel logo -->
            <path>${themePath}/assets/images/systems/${system.theme}.png</path>
            <pos>0.0671875 0.35625</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.078125 0.3125</maxSize><!-- 150x150 -->
            <linearSmooth>true</linearSmooth>
            <zIndex>2</zIndex>
        </image>
        <text name="home_system_name" extra="true">
            <text>{system:collection} ? proper({system:fullName}) : {system:fullName}</text>
            <pos>0.1260417 0.2375000</pos>
            <size>0.1895833 0.1000000</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0750000</fontSize><!-- 36px -->
            <color>F2F3F5FF</color>
            <alignment>left</alignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>2</zIndex>
        </text>
        <text name="home_system_maker" extra="true">
            <text>{system:manufacturer}</text>
            <pos>0.1260417 0.3500000</pos>
            <size>0.1895833 0.0500000</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0375000</fontSize><!-- 18px -->
            <color>A9AFB8FF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>
        <text name="home_system_counts" extra="true">
            <text>("{system:total}" == "1" ? "1 game" : "{system:total}" + " games") + "  ·  {system:gamesPlayed} played"</text>
            <pos>0.1260417 0.4166667</pos>
            <size>0.1895833 0.0583333</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0458333</fontSize><!-- 22px -->
            <color>8FC8FFFF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>
        <!-- stat tiles (panel y236..322): screen y294..380, x34..315 and x325..606 -->
        <text name="home_last_label" extra="true">
            <text>LAST PLAYED</text>
            <pos>0.0260417 0.6354167</pos>
            <size>0.1302083 0.0416667</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0270833</fontSize><!-- 13px -->
            <color>8A9098FF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>
        <text name="home_system_last" extra="true">
            <text>{system:lastPlayedDate}</text><!-- plain: an expression around this binding is printed literally by ES -->
            <pos>0.0260417 0.6812500</pos>
            <size>0.1302083 0.0666667</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0500000</fontSize><!-- 24px -->
            <color>F2F3F5FF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>
        <text name="home_time_label" extra="true">
            <text>TIME PLAYED</text>
            <pos>0.1776042 0.6354167</pos>
            <size>0.1302083 0.0416667</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0270833</fontSize><!-- 13px -->
            <color>8A9098FF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>
        <text name="home_system_time" extra="true">
            <text>{system:gameTime}</text><!-- plain: an expression around this binding is printed literally by ES -->
            <pos>0.1776042 0.6812500</pos>
            <size>0.1302083 0.0666667</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0500000</fontSize><!-- 24px -->
            <color>F2F3F5FF</color>
            <alignment>left</alignment>
            <zIndex>2</zIndex>
        </text>

        <image name="distro_logo" extra="true">
            <path>${themePath}/assets/images/common/distro_logo.svg</path>
            <pos>0.1666667 0.9291667</pos><!-- between the tabs, 320,446 -->
            <origin>0.5 0.5</origin>
            <size>0.1354167 0.0804167</size><!-- ROCKNIXDS mark 260x38.6 (937x139 art) -->
            <zIndex>2</zIndex>
        </image>

        <!-- Bottom screen (X 0.333-0.666) -->
        <carousel name="systemcarousel">
            <type>horizontal</type>
            <pos>0.5 0.64</pos>
            <origin>0.5 0.5</origin>
            <size>0.3333 0.25</size>
            <logoSize>0.1 0.17</logoSize>
            <logoScale>1</logoScale>
            <color>00000000</color>
            <maxLogoCount>5</maxLogoCount>
            <zIndex>50</zIndex>
            <defaultTransition>instant</defaultTransition>
            <scrollSound>${themePath}/assets/sounds/scroll.wav</scrollSound>
            <minLogoOpacity>1</minLogoOpacity>
            <systemInfoDelay>0</systemInfoDelay>
        </carousel>

        <text name="logoText">
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <forceUppercase>true</forceUppercase>
            <fontSize>0.03</fontSize>
            <color>E8E9EBFF</color>
            <storyboard>
                <animation event="scroll" property="scale"/>
            </storyboard>
        </text>

        <text name="systemName" extra="true">
            <text>{system:collection} ? proper({system:fullName}) : {system:fullName}</text>
            <pos>0.5 0.2229167</pos><!-- y107 -->
            <origin>0.5 0.5</origin>
            <size>0.2333 0.1</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0583333</fontSize><!-- 28px -->
            <color>E8E9EBFF</color>
            <alignment>center</alignment>
            <zIndex>57</zIndex>
        </text>

        <text name="system_games" extra="true">
            <text>"{system:total}" == "1" ? "1 game" : "{system:total}" + " games"</text>
            <pos>0.5 0.3145833</pos><!-- y151 -->
            <origin>0.5 0.5</origin>
            <size>0.2333 0.06</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0375000</fontSize><!-- 18px -->
            <color>8FC8FFFF</color>
            <alignment>center</alignment>
            <zIndex>57</zIndex>
        </text>

        <text name="systemInfo">
            <visible>false</visible>
            <pos>0.5 0.35</pos>
            <origin>0.5 0.5</origin>
            <size>0.2333 0.3</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.025</fontSize>
            <color>E8E9EBFF</color>
            <alignment>center</alignment>
            <zIndex>53</zIndex>
        </text>

        <image name="logo">
            <path>${themePath}/assets/images/systems/default.png</path>
            <path>${themePath}/assets/images/systems/${system.theme}.png</path>
            <image name="menu_slot" extra="true">
                <path>${themePath}/assets/images/common/menu_slot.svg</path>
                <scale>1.45</scale>
                <scaleOrigin>0.5 0.35</scaleOrigin>
            </image>
            <storyboard>
                <animation event="scroll" property="scale"/>
            </storyboard>
        </image>
    </view>

    <view name="gamecarousel">
        <!-- Both screens -->
        <sound name="launch">
            <path>${themePath}/assets/sounds/launch.wav</path>
        </sound>

        <!-- Top screen (X 0-0.333): info card (info_panel.svg at x16..624 y50..410): 3D box, screenshot, details,
             RetroAchievements strip. Canvas fractions are x/1920, y/480. -->
        <image name="preview_panel" extra="true">
            <path>${themePath}/assets/images/common/info_panel.svg</path>
            <pos>0.1666667 0.4791667</pos>
            <origin>0.5 0.5</origin>
            <size>0.3166667 0.75</size>
            <zIndex>1</zIndex>
        </image>

        <!-- 3D box (boxart media: scrape/box3d.py), overlapping the card's left side -->
        <image name="preview_box3d" extra="true">
            <path>{game:boxart}</path>
            <pos>0.0609375 0.3666667</pos><!-- centred in the card's left area, x20..214 y60..292 -->
            <origin>0.5 0.5</origin>
            <maxSize>0.1104167 0.4833333</maxSize><!-- 212x232 -->
            <linearSmooth>true</linearSmooth>
            <zIndex>3</zIndex>
        </image>

        <!-- screenshot window: x230..608 y68..210 -->
        <image name="preview_icon" extra="true">
            <path>${themePath}/assets/images/systems/${system.theme}.png</path>
            <visible>"{game:image}" == ""</visible>
            <pos>0.2182292 0.2895833</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.0520833 0.2083333</maxSize>
            <zIndex>1.5</zIndex>
        </image>
        <video name="md_video">
            <pos>0.2182292 0.2895833</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.196875 0.2958333</maxSize><!-- 378x142 -->
            <effect>none</effect>
            <delay>3</delay>
            <showSnapshotNoVideo>true</showSnapshotNoVideo>
            <showSnapshotDelay>true</showSnapshotDelay>
            <snapshotSource>image</snapshotSource>
            <zIndex>2</zIndex>
        </video>

        <!-- details under the screenshot -->
        <text name="preview_name" extra="true">
            <text>{game:genre}</text>
            <pos>0.1208333 0.4583333</pos><!-- x232..608 y220..244 -->
            <size>0.1958333 0.05</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0375</fontSize><!-- 18px -->
            <color>A9AFB8FF</color>
            <alignment>left</alignment>
            <zIndex>1.5</zIndex>
        </text>
        <text name="preview_stats" extra="true">
            <text>"{game:playcount}" == "" || "{game:playcount}" == "0" ? "Not played yet" : "{game:playcount}" == "1" ? "Played once" : "Played " + "{game:playcount}" + " times"</text>
            <pos>0.1208333 0.5166667</pos><!-- y248..272 -->
            <size>0.1958333 0.05</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0416667</fontSize><!-- 20px -->
            <color>8FC8FFFF</color>
            <alignment>left</alignment>
            <zIndex>1.5</zIndex>
        </text>

        <!-- RetroAchievements strip (wheel media: scrape/ra-fetch.py + ra_panel.py) under the divider -->
        <image name="preview_ra" extra="true">
            <path>{game:wheel}</path>
            <pos>0.1666667 0.7270833</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.2958333 0.1520833</maxSize><!-- 568x73 -->
            <linearSmooth>true</linearSmooth>
            <zIndex>2</zIndex>
        </image>
        <text name="preview_ra_none" extra="true">
            <text>No achievements for this game</text>
            <visible>{game:cheevos} == false</visible>
            <pos>0.1666667 0.7270833</pos>
            <origin>0.5 0.5</origin>
            <size>0.2958333 0.1</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0375</fontSize>
            <color>6E747DFF</color>
            <alignment>center</alignment>
            <zIndex>2</zIndex>
        </text>

        <text name="logoText">
            <visible>false</visible>
        </text>

        <text name="systemNameFromGame" extra="true">
            <pos>0.1667 0.9354167</pos><!-- centred on the tabs (y449) -->
            <size>0.15 0.11</size>
            <origin>0.5 0.5</origin>
            <text>{game:system:collection} ? proper({game:system:fullName}) : {game:system:fullName}</text>
            <alignment>center</alignment>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0583333</fontSize><!-- 28px -->
            <color>E8E9EBFF</color>
        </text>

        <!-- Bottom screen (X 0.333-0.666) -->
        <image name="scroll_thumb" extra="true">
            <x>{game:count} &gt; 1 ? 0.365625 + ({game:index} - 1) / ({game:count} - 1) * 0.225 : 0.478125</x>
        </image>
        <text name="scroll_label" extra="true">
            <visible>false</visible>
            <text>{game:index} of {game:count}</text>
            <x>{game:count} &gt; 1 ? 0.365625 + ({game:index} - 1) / ({game:count} - 1) * 0.225 : 0.478125</x>
        </text>

        <!-- The START frame lives in the cartridge template below, so it slides with the selected cart. As a fixed
             overlay it stayed put while the carts scrolled under it, showing two half carts mid-scroll. -->
        <image name="start_window" extra="true">
            <visible>false</visible>
        </image>

        <!-- DSi-style empty slots at the five card positions: lists shorter than the row show them, longer
             lists cover them with cards -->
        <image name="empty_slot_0" extra="true">
            <path>${themePath}/assets/images/common/empty_slot.svg</path>
            <pos>0.3667 0.6292</pos>
            <origin>0.5 0.5</origin>
            <size>0.05088 0.2219</size>
            <zIndex>49</zIndex>
        </image>
