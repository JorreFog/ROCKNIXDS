        <gamecarousel name="gamecarousel">
            <type>horizontal</type>
            <pos>0.5 0.66</pos>
            <origin>0.5 0.5</origin>
            <!-- taller than the items (0.315) so the selected card's START frame isn't clipped: ES clips the
                 carousel to this box. The item height fraction keeps the items at 0.315 (0.7326 x 0.43). -->
            <size>0.3333 0.43</size>
            <logoSize>0.2 0.7326</logoSize>
            <logoScale>1</logoScale>
            <color>00000000</color>
            <maxLogoCount>5</maxLogoCount>
            <zIndex>50</zIndex>
            <scrollSound>${themePath}/assets/sounds/scroll.wav</scrollSound>
            <minLogoOpacity>1</minLogoOpacity>
            <imageSource if="${system.hardwareType} == 'System'">image</imageSource>
            <!-- Every game is a cartridge: the name sits in the label window,
                 and the art (when scraped) is drawn over it. -->
            <itemTemplate>
                <!-- the card area has the proportions of real DS card scans (0.9174): 0.1185 0.05 / 0.763 0.7053 of the
                     item. game_slot.svg (100x104) is drawn into it; its art window x12..88 y21..87 maps to
                     0.21006 0.1924 / 0.57988 0.4476 -->
                <image name="cart_slot">
                    <pos>0.1185 0.05</pos>
                    <size>0.763 0.7053</size>
                    <path>${themePath}/assets/images/common/game_slot.svg</path>
                </image>
                <!-- a game with no art at all: plain label paper with its name -->
                <image name="cart_label">
                    <pos>0.21006 0.1924</pos>
                    <size>0.57988 0.4476</size>
                    <path>${themePath}/assets/images/common/game_label.svg</path>
                </image>
                <text name="cart_name">
                    <pos>0.22 0.20</pos>
                    <size>0.56 0.43</size>
                    <text>{game:name}</text>
                    <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
                    <fontSize>0.019</fontSize>
                    <color>3A3C40FF</color>
                    <alignment>center</alignment>
                    <verticalAlignment>center</verticalAlignment>
                    <lineSpacing>1.05</lineSpacing>
                </text>
                <!-- drawn card fallback: the box art cropped to cover the window, the label art (boxback media, unused otherwise; mix is ES's preferred preview image:
                     scrape/labelart.py) over it. No visible conditions: bound paths contain "(USA)" etc., which
                     ES's expression parser mangles; later layers simply cover earlier ones. -->
                <image name="cart_boxart">
                    <pos>0.5 0.4162</pos>
                    <origin>0.5 0.5</origin>
                    <minSize>0.57988 0.4476</minSize>
                    <path>{game:thumbnail}</path>
                    <linearSmooth>true</linearSmooth>
                </image>
                <image name="cart_art">
                    <pos>0.21006 0.1924</pos>
                    <size>0.57988 0.4476</size>
                    <path>{game:boxback}</path>
                    <linearSmooth>true</linearSmooth>
                </image>
                <!-- the real cartridge (cartridge media: scrape/cartart.py, LaunchBox "Cart - Front"), over all of it -->
                <image name="cart_real">
                    <pos>0.1185 0.05</pos>
                    <size>0.763 0.7053</size>
                    <path>{game:cartridge}</path>
                    <linearSmooth>true</linearSmooth>
                </image>
                <!-- START frame, shown on the selected cart only (activate/deactivate storyboards), so it moves with it.
                     Sized so its opening (120x120 of 160x200) hugs the card (113x107 px on a 128x151 item),
                     centred on it, like the DSi's frame. -->
                <image name="cart_start">
                    <path>${themePath}/assets/images/common/start_window.svg</path>
                    <pos>0.5 0.5113</pos>
                    <origin>0.5 0.5</origin>
                    <maxSize>1.1094 1.1755</maxSize>
                    <opacity>0</opacity>
                    <!-- the carousel slides for 500 ms: the frame appears only once the card has arrived in the centre
                         (a frame fading in/out on a card still sliding showed up at the sides), and goes at once -->
                    <storyboard event="activate">
                        <animation property="opacity" begin="450" from="0" to="1" duration="120"/>
                        <animation property="scale" begin="450" from="1" to="1.035" duration="900" autoReverse="true" repeat="forever" mode="easeInOut"/>
                    </storyboard>
                    <storyboard event="deactivate">
                        <animation property="opacity" from="0" to="0" duration="1"/>
                    </storyboard>
                </image>
            </itemTemplate>
        </gamecarousel>

        <image name="gamecarouselLogo">
            <origin>0.5 0.5</origin>
            <image name="game_slot" extra="true">
                <path>${themePath}/assets/images/common/game_slot.svg</path>
                <pos>0.05 0</pos>
                <pos if="${system.fullName} == 'Tools'">0.1175 0</pos>
                <size>0.9 1</size>
                <size if="${system.fullName} == 'Tools'">0.775 1</size>
                <scale>1.5</scale>
                <scaleOrigin>0.5 0.4</scaleOrigin>
            </image>
            <storyboard>
                <animation property="scale"/>
            </storyboard>
        </image>

        <text name="md_name">
            <pos>0.5 0.15</pos>
            <origin>0.5 0.5</origin>
            <size>0.2333 0.1</size>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.0500000</fontSize><!-- 24px -->
            <color>E8E9EBFF</color>
            <alignment>center</alignment>
            <zIndex>57</zIndex>
        </text>

        <text name="md_description">
            <pos>0.5 0.3229167</pos><!-- y 95..215, inside the bubble below the title -->
            <origin>0.5 0.5</origin>
            <size>0.2333 0.25</size>
            <verticalAlignment>top</verticalAlignment>
            <autoScroll>vertical</autoScroll>
            <autoScrollDelay>3000</autoScrollDelay>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <fontSize>0.03</fontSize>
            <color>A9AEB5FF</color>
            <alignment>center</alignment>
            <zIndex>57</zIndex>
        </text>

        <text name="gamecarouselLogoText">
            <fontSize>0.026</fontSize>
            <color>C9CDD2FF</color>
            <fontPath>${themePath}/assets/fonts/dsi_font.otf</fontPath>
            <storyboard>
                <animation event="scroll" property="scale"/>
            </storyboard>
        </text>
    </view>

