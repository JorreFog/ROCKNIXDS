From d9c6379afdc69b0939874470de28649cd1cd5950 Mon Sep 17 00:00:00 2001
From: JorreFog <305496122+JorreFog@users.noreply.github.com>
Date: Mon, 28 Sep 2026 18:55:30 +0200
Subject: [PATCH] es-rgds-powersaver: in standby wake each minute for the
 clock, poll input once per frame, close audio after a minute idle, wake for
 posted work (API launches)

---
 es-app/src/main.cpp    | 34 +++++++++++++++++++++++++++++++++-
 es-core/src/Window.cpp |  2 ++
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/es-app/src/main.cpp b/es-app/src/main.cpp
index edd28e10b..63c502ca8 100644
--- a/es-app/src/main.cpp
+++ b/es-app/src/main.cpp
@@ -1,6 +1,7 @@
 //EmulationStation, a graphical front-end for ROM browsing. Created by Alec "Aloshi" Lofquist.
 //http://www.aloshi.com
 
+#include <chrono>
 #include "services/HttpServerThread.h"
 #include "guis/GuiDetectDevice.h"
 #include "guis/GuiMsgBox.h"
@@ -729,7 +730,38 @@ int main(int argc, char* argv[])
 		if (screenSaverWait)
 			eventResult = SDL_WaitEventTimeout(&event, screenSaverTimeout);
 		else if (ps_standby)
-			eventResult = SDL_WaitEventTimeout(&event, PowerSaver::getTimeout());
+		{
+			// ROCKNIXDS: wake at the next full minute too, so a theme's clock and battery stay current while an idle
+			// menu draws nothing (power saver "enhanced"/"instant" otherwise sleeps until input or the screensaver)
+			int timeout = PowerSaver::getTimeout();
+			long long nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+			int toMinute = (int)(60000 - nowMs % 60000) + 20;
+			if (timeout <= 0 || timeout > toMinute)
+				timeout = toMinute;
+			// with a gamepad open SDL can't block in SDL_WaitEventTimeout and polls every millisecond (measured: ~760
+			// wake-ups/s in an idle menu); check once per frame instead, which keeps the first press after idling as
+			// quick as a frame
+			// and close the audio device after a minute without input: open, SDL streams silence to PipeWire nonstop (~13%
+			// of a core in an idle menu, and the speaker amplifier stays powered). It reopens with the next input, which
+			// takes 60-100 ms, so not sooner: quick browsing never waits for it. Not while music plays.
+			static bool audioClosedForIdle = false;
+			if (!audioClosedForIdle && (int)(SDL_GetTicks() - ps_time) > 60000 && AudioManager::isInitialized() &&
+				Mix_Playing(-1) == 0 && !Mix_PlayingMusic())
+			{
+				AudioManager::getInstance()->deinit();
+				audioClosedForIdle = true;
+			}
+			Uint32 until = SDL_GetTicks() + timeout;
+			while (!(eventResult = SDL_PollEvent(&event)) && (int)(until - SDL_GetTicks()) > 0)
+				SDL_Delay(16);
+			if (eventResult && audioClosedForIdle)
+			{
+				Uint32 t0 = SDL_GetTicks();
+				AudioManager::getInstance()->init();
+				audioClosedForIdle = false;
+				LOG(LogInfo) << "Audio reopened after idle in " << (SDL_GetTicks() - t0) << " ms";
+			}
+		}
 		else
 			eventResult = SDL_PollEvent(&event);
 
diff --git a/es-core/src/Window.cpp b/es-core/src/Window.cpp
index a51319026..7f0cb658b 100644
--- a/es-core/src/Window.cpp
+++ b/es-core/src/Window.cpp
@@ -1244,6 +1244,8 @@ void Window::postToUiThread(const std::function<void()>& func, void* data)
 		mTimeSinceLastInput = 0;
 		PowerSaver::pushRefreshEvent();
 	}
+	else // ROCKNIXDS: in power-saver standby the main loop only wakes on an event; a launch from the HTTP API waited up
+		PowerSaver::pushRefreshEvent();   // to a minute for it otherwise (no-op if one is already pending)
 }
 
 void Window::processPostedFunctions()
