<?xml version="1.0" encoding="UTF-8"?>
<!--
    ROCKNIXDS Pixel Dark: the ROCKNIXDS menu mockup (pixel shelf, cartridges, ready screen) on both screens of the
    RG DS and the RG DS Plus. The rnds engine in ROCKNIXDS's EmulationStation (es-rgds-rnds.patch) draws the system
    shelf, the game list and the ready screen; everything it uses is in ./rnds (rocknixds-pixel-light uses the same
    folder). This file switches the engine on, picks its palette, gives it its sounds and styles ES's own menus.
-->
<theme defaultTransition="instant" defaultView="gamecarousel">
    <formatVersion>7</formatVersion>

    <!-- Stock EmulationStation has no rnds engine: when the launcher has to run it (a ROCKNIX release the patched ES
         doesn't link against), it shows dii-ess-aye's layout from here instead. The patched ES draws every view
         with the engine and skips this include (rndsFallback). The installer links ./assets to dii-ess-aye's. -->
    <include rndsFallback="true">./../dii-ess-aye/theme-rgds.xml</include>

    <view name="rnds">
        <!-- the engine finds its folder from this picture -->
        <image name="assets" extra="false">
            <path>./rnds/game_slot.png</path>
        </image>
        <text name="palette" extra="false">
            <text>dark</text>
        </text>
        <!-- the menu's sounds (rnds/gen_sounds.py); ES plays them while "enable navigation sounds" is on -->
        <sound name="scroll">
            <path>./rnds/sounds/scroll.wav</path>
        </sound>
        <sound name="select">
            <path>./rnds/sounds/select.wav</path>
        </sound>
        <sound name="back">
            <path>./rnds/sounds/back.wav</path>
        </sound>
        <sound name="fav">
            <path>./rnds/sounds/fav.wav</path>
        </sound>
        <sound name="ready">
            <path>./rnds/sounds/ready.wav</path>
        </sound>
        <sound name="insert">
            <path>./rnds/sounds/insert.wav</path>
        </sound>
    </view>

    <!-- ES's own clock, battery and controller indicators: the engine's status bar shows them -->
    <view name="screen">
        <controllerActivity name="controllerActivity">
            <visible>false</visible>
        </controllerActivity>
        <batteryIndicator name="batteryIndicator">
            <visible>false</visible>
        </batteryIndicator>
        <text name="clock">
            <pos>1 1</pos>
        </text>
    </view>

    <!-- ES's menus in the mockup's colours and font -->
    <view name="menu">
        <menuBackground name="menubg">
            <color>12181FFF</color>
            <scrollbarColor>3D4A5AFF</scrollbarColor>
        </menuBackground>

        <menuText name="menutext, menufooter">
            <fontSize>0.0375</fontSize>
            <fontPath>./rnds/fonts/PixelifySans-Regular.ttf</fontPath>
            <color>E7EEF6FF</color>
            <selectedColor>FFFFFFFF</selectedColor>
            <selectorColor>1A6EA3FF</selectorColor>
            <separatorColor>243040FF</separatorColor>
        </menuText>

        <menuText name="menutitle">
            <fontSize>0.0458</fontSize>
            <fontPath>./rnds/fonts/PixelifySans-Medium.ttf</fontPath>
            <color>E7EEF6FF</color>
            <selectedColor>FFFFFFFF</selectedColor>
            <selectorColor>1A6EA3FF</selectorColor>
            <separatorColor>243040FF</separatorColor>
        </menuText>

        <menuTextSmall name="menutextsmall">
            <fontSize>0.0333</fontSize>
            <fontPath>./rnds/fonts/PixelifySans-Regular.ttf</fontPath>
            <color>93A0B0FF</color>
        </menuTextSmall>

        <menuGroup name="menugroup">
            <fontSize>0.0333</fontSize>
            <fontPath>./rnds/fonts/PixelifySans-Medium.ttf</fontPath>
            <color>7EC8EEFF</color>
            <backgroundColor>1A222CFF</backgroundColor>
            <separatorColor>243040FF</separatorColor>
        </menuGroup>

        <!-- text fields (the keyboard, metadata): ES's own boxes are white, under this theme's light text -->
        <menuTextEdit name="menutextedit">
            <active>./rnds/textinput_active.png</active>
            <inactive>./rnds/textinput.png</inactive>
        </menuTextEdit>
    </view>
</theme>
