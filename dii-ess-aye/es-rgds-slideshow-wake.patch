+// ROCKNIXDS: whether the screensaver clock's time format (SHOW DATE TIME > TIME FORMAT) shows seconds
+static bool clockShowsSeconds()
+{
+	const std::string& format = Settings::getInstance()->getString("ScreenSaverTimeFormat");
+	for (const char* s : { "%S", "%T", "%r", "%X", "%s", "%c" })
+		if (format.find(s) != std::string::npos)
+			return true;
+
+	return false;
+}
