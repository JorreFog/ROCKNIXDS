 void ViewController::launch(FileData* game, LaunchGameOptions options, Vector3f center, bool allowCheckLaunchOptions)
 {
+	// ROCKNIXDS: one launch at a time. A launch only schedules the game (a transition, or for the rnds theme a 1 ms
+	// animation), and a second launch() replaced that animation, which ran the first one's game at once and then
+	// started the second: two launch requests 0.15 s apart started the game twice (2026-10-05). Until a launch has
+	// handed back (isLaunchTransitionRunning), another is ignored. Only for 10 s: a view change can cancel the launch's
+	// animation, callback and all (cancelAnimation), which leaves the flag set; the UI thread waits while a game runs,
+	// so 10 s covers any transition.
+	if (GuiComponent::isLaunchTransitionRunning)
+	{
+		if (SDL_GetTicks() - sLaunchStartedAt < 10000)
+		{
+			LOG(LogWarning) << "Launch of " << game->getPath() << " ignored: a game is already starting";
+			return;
+		}
+		LOG(LogWarning) << "The last launch never handed back (its transition was cancelled): launching " << game->getPath();
+		GuiComponent::isLaunchTransitionRunning = false;
+	}
+
 	if (allowCheckLaunchOptions && !checkLaunchOptions(game, options, center))
 		return;
 
@@ -573,6 +592,7 @@ void ViewController::launch(FileData* game, LaunchGameOptions options, Vector3f
 	mLockInput = true;
 
 	GuiComponent::isLaunchTransitionRunning = true;
+	sLaunchStartedAt = SDL_GetTicks();
 		
 	// ROCKNIXDS: the rnds engine's ready screen stays up until the game takes over (no splash, no fade)
 	bool rndsLaunch = game->getSourceFileData()->getSystem() != nullptr && rnds::isRndsTheme(game->getSourceFileData()->getSystem()->getTheme());
