From 9e415df55cb729cc0b23eacf025208ebc6244eb2 Mon Sep 17 00:00:00 2001
From: JorreFog <305496122+JorreFog@users.noreply.github.com>
Date: Sun, 4 Oct 2026 17:06:28 +0200
Subject: [PATCH] es-rgds-dsfirst: the DS is listed before it has games;
 collection names capitalised

---
 es-app/src/SystemData.cpp  | 11 +++++++----
 es-app/src/rnds/RndsEs.cpp |  2 ++
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/es-app/src/SystemData.cpp b/es-app/src/SystemData.cpp
index 4c09392d..6f991f2b 100644
--- a/es-app/src/SystemData.cpp
+++ b/es-app/src/SystemData.cpp
@@ -69,6 +69,9 @@ static std::map<std::string, std::function<BindableProperty(SystemData*)>> prope
 VectorEx<SystemData*> SystemData::sSystemVector;
 bool SystemData::IsManufacturerSupported = false;
 
+// ROCKNIXDS: the DS is listed even before it has games (a fresh SD card), so the menu starts on it instead of without it
+static bool rgdsAlwaysListed(const std::string& name) { return name == "nds"; }
+
 SystemData::SystemData(const SystemMetadata& meta, SystemEnvironmentData* envData, std::vector<EmulatorData>* pEmulators, bool CollectionSystem, bool groupedSystem, bool withTheme, bool loadThemeOnlyIfElements) :
 	mMetadata(meta), mEnvData(envData), mIsCollectionSystem(CollectionSystem), mIsGameSystem(true)
 {
@@ -106,7 +109,7 @@ SystemData::SystemData(const SystemMetadata& meta, SystemEnvironmentData* envDat
 
 			if (!UIModeController::LoadEmptySystems())
 			{
-				if (mRootFolder->getChildren().size() == 0)
+				if (mRootFolder->getChildren().size() == 0 && !rgdsAlwaysListed(mMetadata.name))
 					return;
 
 				if (mHidden && !Settings::HiddenSystemsShowGames())
@@ -134,7 +137,7 @@ SystemData::SystemData(const SystemMetadata& meta, SystemEnvironmentData* envDat
 
 	mRootFolder->getMetadata().resetChangedFlag();
 
-	if (withTheme && (!loadThemeOnlyIfElements || UIModeController::LoadEmptySystems() || mRootFolder->mChildren.size() > 0))
+	if (withTheme && (!loadThemeOnlyIfElements || UIModeController::LoadEmptySystems() || mRootFolder->mChildren.size() > 0 || rgdsAlwaysListed(mMetadata.name)))
 	{
 		loadTheme();
 
@@ -1273,7 +1276,7 @@ SystemData* SystemData::loadSystem(pugi::xml_node system, bool fullMode)
 	if (!fullMode)
 		return newSys;
 
-	if (!UIModeController::LoadEmptySystems() && newSys->getRootFolder()->getChildren().size() == 0)
+	if (!UIModeController::LoadEmptySystems() && newSys->getRootFolder()->getChildren().size() == 0 && !rgdsAlwaysListed(md.name))
 	{
 		LOG(LogWarning) << "System \"" << md.name << "\" has no games! Ignoring it.";
 		delete newSys;
@@ -1354,7 +1357,7 @@ bool SystemData::isVisible()
 	if (isGroupChildSystem())
 		return false;
 
-	if (!mHidden && !mIsCollectionSystem && (UIModeController::LoadEmptySystems() || getGameCountInfo()->totalGames > 0))
+	if (!mHidden && !mIsCollectionSystem && (UIModeController::LoadEmptySystems() || getGameCountInfo()->totalGames > 0 || rgdsAlwaysListed(getName())))
 		return true;
 
 	return false;
diff --git a/es-app/src/rnds/RndsEs.cpp b/es-app/src/rnds/RndsEs.cpp
index 36a4ba6f..08d8892c 100644
--- a/es-app/src/rnds/RndsEs.cpp
+++ b/es-app/src/rnds/RndsEs.cpp
@@ -594,6 +594,8 @@ namespace rnds
 			SystemData* s = systems[i];
 			r.id = s->getName();
 			r.name = s->getFullName();
+			// ES names its own collections in lower case ("favorites"); the other names are capitalised
+			if (s->isCollection() && !r.name.empty() && r.name[0] >= 'a' && r.name[0] <= 'z') r.name[0] -= 32;
 			r.maker = s->getSystemMetadata().manufacturer;
 			// systems.cfg: the system's name, its theme folder, then by kind ("*portable", "*collection"...), then "*";
 			// a system matched only by kind takes the accent of its maker ("@Sega") when there is one
-- 
2.56.0

