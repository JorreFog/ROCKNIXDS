+#include "RndsUI.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+#include <set>
+
+namespace rnds
+{
+	// ---- timing ---------------------------------------------------------------------------------------------------------
+
+	float cubicBezier(float x1, float y1, float x2, float y2, float p)
+	{
+		if (p <= 0) return 0;
+		if (p >= 1) return 1;
+		const double cx = 3.0 * x1, bx = 3.0 * (x2 - x1) - cx, ax = 1.0 - cx - bx;
+		const double cy = 3.0 * y1, by = 3.0 * (y2 - y1) - cy, ay = 1.0 - cy - by;
+		auto sx = [&](double t) { return ((ax * t + bx) * t + cx) * t; };
+		auto dx = [&](double t) { return (3.0 * ax * t + 2.0 * bx) * t + cx; };
+		double t = p;
+		for (int i = 0; i < 8; i++)
+		{
+			double x = sx(t) - p;
+			if (std::fabs(x) < 1e-7) break;
+			double d = dx(t);
+			if (std::fabs(d) < 1e-6) break;
+			t -= x / d;
+		}
+		if (t < 0 || t > 1 || std::fabs(sx(t) - p) > 1e-5)
+		{
+			double lo = 0, hi = 1;
+			t = p;
+			for (int i = 0; i < 40; i++)
+			{
+				double x = sx(t);
+				if (std::fabs(x - p) < 1e-7) break;
+				if (x < p) lo = t; else hi = t;
+				t = (lo + hi) / 2;
+			}
+		}
+		return (float)(((ay * t + by) * t + cy) * t);
+	}
+
+	// ---- mockup palette -------------------------------------------------------------------------------------------------
+
+	// every colour the screens use; dark is the mockup's, light the same pixel look on white
+	struct Pal
+	{
+		Color ink, muted, line, edge, navy, red, shade40, shade45, shade35, blackish;
+		Color screenBg, screenFrame, screenBand, ditherA, ditherB;
+		Color sheetBase, sheetHi, sheetLo; float sheetMix;
+		Color panelBand, panelBody, panelLow;		// hero, slots, the face buttons: top band, body, bottom inset
+		Color chipBand, chipBody;
+		Color frameBorder, frameBg;					// the box art's frame
+		Color meterBg, brandBg, kbdBg, kbdInk, rule;
+		Color bubbleBand, bubbleBody, bubbleLow;
+		Color trackBg, trackHi, trackShade;
+		Color slotOn, railBg, faceMuted;
+		Color favBorder, favBand, favBody, favInk;
+		Color glint, floor;							// the box art's shine and its shadow on the sheet
+		Color slotDark, slotLip;					// the console slot the cartridge goes into
+	};
+
+	static Pal darkPal()
+	{
+		Pal p;
+		p.ink = Color::hex(0xe7eef6); p.muted = Color::hex(0x93a0b0); p.line = Color::hex(0x7d8b9c);
+		p.edge = Color::hex(0xd5dee8); p.navy = Color::hex(0xe7f4ff); p.red = Color::hex(0xff3b4a);
+		p.shade40 = Color(0, 0, 0, 0.4f); p.shade45 = Color(0, 0, 0, 0.45f); p.shade35 = Color(0, 0, 0, 0.35f);
+		p.blackish = Color::hex(0x070a0e);
+		p.screenBg = Color::hex(0x121820); p.screenFrame = p.blackish; p.screenBand = Color::hex(0x243040);
+		p.ditherA = Color(1, 1, 1, 0.14f); p.ditherB = Color(1, 1, 1, 0.07f);
+		p.sheetBase = Color::hex(0x10161e); p.sheetMix = 0.34f; p.sheetHi = Color(1, 1, 1, 0.1f); p.sheetLo = p.shade35;
+		p.panelBand = Color::hex(0x2e3a48); p.panelBody = Color::hex(0x121820); p.panelLow = p.blackish;
+		p.chipBand = Color::hex(0x243040); p.chipBody = Color::hex(0x0e141c);
+		p.frameBorder = Color::hex(0xd5dee8); p.frameBg = Color::hex(0x12181f);
+		p.meterBg = Color::hex(0x10161e); p.brandBg = Color::hex(0x1b2330); p.kbdBg = Color::hex(0xe7eef6);
+		p.kbdInk = Color::hex(0x121820); p.rule = Color::hex(0x3a4654);
+		p.bubbleBand = Color::hex(0x2c3848); p.bubbleBody = Color::hex(0x141b24); p.bubbleLow = Color::hex(0x0c1218);
+		p.trackBg = Color::hex(0x0c1016); p.trackHi = Color::hex(0x2a3544); p.trackShade = p.shade45;
+		p.slotOn = Color::hex(0xffffff); p.railBg = Color::hex(0x0c1016); p.faceMuted = Color::hex(0x3a4654);
+		p.favBorder = p.red; p.favBand = Color::hex(0x5a2430); p.favBody = Color::hex(0x2a1016); p.favInk = Color::hex(0xff8a96);
+		p.glint = Color(1, 1, 1, 0.28f); p.floor = Color(0, 0, 0, 0.35f);
+		p.slotDark = Color::hex(0x05080b); p.slotLip = Color::hex(0x3a4654);
+		return p;
+	}
+
+	static Pal lightPal()
+	{
+		Pal p;
+		p.ink = Color::hex(0x1d2733); p.muted = Color::hex(0x66758a); p.line = Color::hex(0x8d9bab);
+		p.edge = Color::hex(0x2b3644); p.navy = Color::hex(0xf2faff); p.red = Color::hex(0xe23b4a);
+		Color sh = Color::hex(0x14233a);
+		p.shade40 = Color(sh.r, sh.g, sh.b, 0.22f); p.shade45 = Color(sh.r, sh.g, sh.b, 0.25f); p.shade35 = Color(sh.r, sh.g, sh.b, 0.14f);
+		p.blackish = Color(sh.r, sh.g, sh.b, 0.3f);
+		p.screenBg = Color::hex(0xe6ebf0); p.screenFrame = Color::hex(0xb9c4d0); p.screenBand = Color::hex(0xfbfcfd);
+		p.ditherA = Color(sh.r, sh.g, sh.b, 0.07f); p.ditherB = Color(sh.r, sh.g, sh.b, 0.035f);
+		p.sheetBase = Color::hex(0xfafbfc); p.sheetMix = 0.3f; p.sheetHi = Color(1, 1, 1, 0.55f); p.sheetLo = Color(sh.r, sh.g, sh.b, 0.12f);
+		p.panelBand = Color::hex(0xffffff); p.panelBody = Color::hex(0xedf1f6); p.panelLow = Color::hex(0xc5cfda);
+		p.chipBand = Color::hex(0xffffff); p.chipBody = Color::hex(0xeef2f7);
+		p.frameBorder = Color::hex(0x2b3644); p.frameBg = Color::hex(0xdfe5ec);
+		p.meterBg = Color::hex(0xd6dde6); p.brandBg = Color::hex(0x1b2330); p.kbdBg = Color::hex(0x2b3644);
+		p.kbdInk = Color::hex(0xf2f6fa); p.rule = Color::hex(0xc3ccd6);
+		p.bubbleBand = Color::hex(0xffffff); p.bubbleBody = Color::hex(0xf4f7fa); p.bubbleLow = Color::hex(0xcfd8e2);
+		p.trackBg = Color::hex(0xd9e0e8); p.trackHi = Color::hex(0xffffff); p.trackShade = Color(sh.r, sh.g, sh.b, 0.18f);
+		p.slotOn = Color::hex(0x1a6ea3); p.railBg = Color::hex(0xd9e0e8); p.faceMuted = Color::hex(0xc3ccd6);
+		p.favBorder = p.red; p.favBand = Color::hex(0xfff2f3); p.favBody = Color::hex(0xffdfe3); p.favInk = Color::hex(0xc8283a);
+		p.glint = Color(1, 1, 1, 0.45f); p.floor = Color(sh.r, sh.g, sh.b, 0.2f);
+		p.slotDark = Color::hex(0x1d2733); p.slotLip = Color::hex(0x8d9bab);
+		return p;
+	}
+
+	// a box in CSS px, the way the mockup's stylesheet declares it
+	struct BoxCss
+	{
+		float radius = 0, border = 0;
+		Color borderColor, bg;
+		std::vector<Band> bands;
+		bool dither = false;
+		std::vector<Shadow> shadows;
+		std::string key;	// identifies the style in the cache
+		bool async = false;	// big: painted on the worker (drawn once it's there)
+	};
+
+	static Shadow outer(float dx, float dy, const Color& c) { return Shadow{ dx, dy, 0, c, false }; }
+	static Shadow inset(float dx, float dy, float spread, const Color& c) { return Shadow{ dx, dy, spread, c, true }; }
+
+	static std::string colorKey(const Color& c) { char b[16]; snprintf(b, sizeof b, "%08x", c.rgba8()); return b; }
+
+	// ---- implementation -------------------------------------------------------------------------------------------------
+
+	struct SlotState
+	{
+		bool known = false;
+		int d = 0;				// target offset from the centre (items)
+		float fromX = 0, toX = 0, fromS = 1, toS = 1;
+		double t0 = -1e9;		// transform transition start
+		bool trans = false;
+		float fromO = 1, toO = 1;
+		double o0 = -1e9;
+		bool otrans = false;
+		// wrapping around the end of the shelf: the item enters from the side it comes in by, and a copy of it
+		// leaves from its old place on the other side (with few items, both places are on screen)
+		bool ghost = false;
+		float gFromX = 0, gToX = 0, gS = 1, gO = 1;
+		double g0 = -1e9;
+	};
+
+	struct CacheEntry
+	{
+		Sprite sp;
+		uint64_t used = 0;
+		size_t bytes = 0;
+		int group = 0;
+		// images: CSS size they were fitted to (photo frames)
+		float cssW = 0, cssH = 0;
+	};
+
+	struct Job
+	{
+		std::string key;
+		int group = 0;
+		bool smooth = true;
+		std::function<Bitmap(float&, float&)> fn;
+	};
+
+	struct Done
+	{
+		std::string key;
+		int group = 0;
+		bool smooth = true;
+		Bitmap bmp;
+		float cssW = 0, cssH = 0;	// photos: the fitted CSS size; boxes: the box's origin in the bitmap
+	};
+
+	enum Group { G_TEXT = 0, G_BOX, G_ICON, G_CART, G_PHOTO, G_COUNT };
+	static const size_t GROUP_LIMIT[G_COUNT] = { 400, 200, 120, 90, 8 };
+
+	struct Face
+	{
+		std::string kbd, label;
+		int kind = 0;		// 0 button, 1 is-on, 2 note
+		int action = 0;		// what a tap does
+	};
+
+	enum Action { ACT_NONE = 0, ACT_PREV, ACT_NEXT, ACT_OPEN, ACT_BACK, ACT_FAV, ACT_RESUME, ACT_SLOT };
+
+	struct UI::Impl
+	{
+		UI* ui;
+		Source* src;
+		Backend* be;
+		std::string dir;
+		float s;
