+	// ---- images: ES's decoder (FreeImage), rows flipped to top-down ----------------------------------------------------
+	static Bitmap esDecode(const std::string& path)
+	{
+		Bitmap b;
+		std::ifstream f(path, std::ios::binary);
+		if (!f)
+			return b;
+		std::vector<unsigned char> data((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+		if (data.empty())
+			return b;
+		size_t w = 0, h = 0;
+		MaxSizeInfo cap(1280, 1280);	// box art and screenshots are shown far smaller
+		unsigned char* px = ImageIO::loadFromMemoryRGBA32(data.data(), data.size(), w, h, &cap);
+		if (!px)
+			return b;
+		b.w = (int)w; b.h = (int)h;
+		b.px.resize(w * h * 4);
+		for (size_t y = 0; y < h; y++)
+			memcpy(&b.px[y * w * 4], px + (h - 1 - y) * w * 4, w * 4);
+		delete[] px;
+		return b;
+	}
+
+	// ---- GL backend ---------------------------------------------------------------------------------------------------
+	struct GlTex : Tex
+	{
+		unsigned int id = 0;
+		~GlTex() { if (id) Renderer::destroyTexture(id); }
+	};
+
+	class GlBackend : public Backend
+	{
+	public:
+		Transform4x4f base = Transform4x4f::Identity();
+		float originX[2] = { 0, 0 };
+		bool dual = true;
+		int screen = 0;
+		bool skip = false;
+		std::vector<Renderer::Rect> clips;
+
+		TexPtr upload(const Bitmap& b, bool smooth) override
+		{
+			auto t = std::make_shared<GlTex>();
+			if (b.empty())
+				return t;
+			t->w = b.w; t->h = b.h; t->alpha = b.alpha;
+			t->id = Renderer::createTexture(b.alpha ? Renderer::Texture::ALPHA : Renderer::Texture::RGBA, smooth, false, b.w, b.h, (void*)b.px.data());
+			return t;
+		}
+
+		Transform4x4f screenTrans()
+		{
+			Transform4x4f t = base;
+			t.translate(Vector3f(originX[screen], 0, 0));
+			return t;
+		}
+
+		void beginScreen(int s) override
+		{
+			screen = s;
+			skip = !dual && s == 0;	// one panel only: the interactive (bottom) screen
+			if (skip)
+				return;
+			Transform4x4f t = screenTrans();
+			int w = (int)Math::round(Renderer::getScreenWidth() / (dual ? 3.0f : 1.0f)), h = Renderer::getScreenHeight();
+			Renderer::pushClipRect(Vector2i((int)Math::round(t.translation().x()), (int)Math::round(t.translation().y())), Vector2i(w, h));
+		}
+
+		void endScreen() override
+		{
+			if (!skip)
+				Renderer::popClipRect();
+		}
+
+		void draw(const TexPtr& tp, float x, float y, float w, float h, const Color& tint) override
+		{
+			auto t = (GlTex*)tp.get();
+			if (skip || !t || !t->id || w <= 0 || h <= 0)
+				return;
+			Renderer::setMatrix(screenTrans());
+			Renderer::bindTexture(t->id);
+			const unsigned int col = Renderer::convertColor(tint.rgba8());
+			Renderer::Vertex v[4];
+			v[0] = { { x, y }, { 0.0f, 0.0f }, col };
+			v[1] = { { x, y + h }, { 0.0f, 1.0f }, col };
+			v[2] = { { x + w, y }, { 1.0f, 0.0f }, col };
+			v[3] = { { x + w, y + h }, { 1.0f, 1.0f }, col };
+			Renderer::drawTriangleStrips(v, 4);
+		}
+
+		void fill(float x, float y, float w, float h, const Color& c) override
+		{
+			if (skip || w <= 0 || h <= 0)
+				return;
+			Renderer::setMatrix(screenTrans());
+			Renderer::drawRect(x, y, w, h, c.rgba8(), c.rgba8());
+		}
+
+		void pushClip(float x, float y, float w, float h) override
+		{
+			if (skip)
+				return;
+			Transform4x4f t = screenTrans();
+			Renderer::pushClipRect(Vector2i((int)Math::round(t.translation().x() + x), (int)Math::round(t.translation().y() + y)), Vector2i((int)Math::round(w), (int)Math::round(h)));
+		}
+
+		void popClip() override
+		{
+			if (!skip)
+				Renderer::popClipRect();
+		}
+	};
+
+	// ---- per-system look: the theme's rnds/systems.cfg ------------------------------------------------------------------
+	struct SysLook { std::string icon; Color accent; bool hasAccent = false; std::string maker; };
+
+	// ---- RetroAchievements progress, fetched in the background for the selected game -----------------------------------
+	class RaProgress
+	{
+	public:
+		struct Entry { int a = 0, b = 0; int state = 0; };	// state: 0 none, 1 known, 2 pending, 3 failed
+
+		RaProgress()
+		{
+			mPath = Paths::getUserEmulationStationPath() + "/rnds-achievements.cfg";
+			std::ifstream f(mPath);
+			int id, a, b;
+			while (f >> id >> a >> b)
+				mMap[id] = Entry{ a, b, 1 };
+			mThread = std::thread([this] { run(); });
+		}
+
+		~RaProgress()
+		{
+			{
+				std::lock_guard<std::mutex> l(mLock);
+				mStop = true;
+			}
+			mCv.notify_all();
+			if (mThread.joinable())
+				mThread.join();
+		}
+
+		Entry get(int id, bool refresh)
+		{
+			std::lock_guard<std::mutex> l(mLock);
+			Entry e = mMap.count(id) ? mMap[id] : Entry();
+			bool fresh = mFetched.count(id) > 0;
+			if ((!fresh || refresh) && mWant != id)
+			{
+				mWant = id;
+				mCv.notify_all();
+			}
+			return e;
+		}
+
+		void forget(int id)	// after the game was played: fetch again next time
+		{
+			std::lock_guard<std::mutex> l(mLock);
+			mFetched.erase(id);
+		}
+
+		std::function<void()> changed;
+
+	private:
+		void run()
+		{
+			while (true)
+			{
+				int id;
+				{
+					std::unique_lock<std::mutex> l(mLock);
+					mCv.wait(l, [this] { return mStop || mWant > 0; });
+					if (mStop)
+						return;
+					id = mWant;
+					mWant = 0;
+				}
+				// ES's own client; with a delay, so browsing quickly doesn't send a request per game
+				SDL_Delay(350);
+				{
+					std::lock_guard<std::mutex> l(mLock);
+					if (mStop) return;
+					if (mWant > 0 && mWant != id) continue;	// moved on
+				}
+				GameInfoAndUserProgress info = RetroAchievements::getGameInfoAndUserProgress(id);
+				bool ok = info.ID == id;
+				{
+					std::lock_guard<std::mutex> l(mLock);
+					mFetched.insert(id);
+					if (ok)
+					{
+						mMap[id] = Entry{ info.NumAwardedToUser, info.NumAchievements, 1 };
+						std::ofstream f(mPath);
+						for (auto& kv : mMap)
+							if (kv.second.state == 1)
+								f << kv.first << " " << kv.second.a << " " << kv.second.b << "\n";
+					}
+				}
+				if (changed)
+					changed();
+			}
+		}
+
+		std::mutex mLock;
+		std::condition_variable mCv;
+		std::map<int, Entry> mMap;
+		std::set<int> mFetched;
+		int mWant = 0;
+		bool mStop = false;
+		std::string mPath;
+		std::thread mThread;
+	};
+
+	// ---- the host -----------------------------------------------------------------------------------------------------
+	static EsHost* sHost = nullptr;
+
+	// ES unloads its resources before it destroys the GL context for a game (Window::deinit); the engine's textures go
+	// with them and are made again when next drawn
+	struct TextureReleaser : IReloadable
+	{
+		std::function<void()> drop;
+		bool unload() override { if (drop) drop(); return true; }
+		void reload() override {}
+	};
+
+	struct EsHost::Impl : public Source
+	{
+		Window* window;
+		GlBackend backend;
+		std::unique_ptr<UI> ui;
+		std::string assetDir, variant;
+		float scale = 1;
+
+		SystemView* systemView = nullptr;
+		std::set<RndsGameListView*> lists;
+		RndsGameListView* list = nullptr;	// the library's list
+		GuiComponent* shown = nullptr;		// the ES view the engine is drawing for
+		std::vector<SystemData*> systems;
+		std::map<std::string, SysLook> looks;
+		std::map<SystemData*, FileData*> resumeCache;
+		bool busy = false;					// inside an engine action: ES's view callbacks are ours
+		bool psPaused = false;
+		std::atomic<bool> pendingRefresh{ false };
+		// a held left/right (or L/R): moves again after a pause, faster the longer it is held, like ES's lists
+		struct Held { bool on = false; UI::Button button = UI::LEFT; int device = 0, type = 0, id = 0; Uint32 since = 0, last = 0; } held;
+		Uint32 lastUpdate = 0;	// a held direction keeps frames coming: a longer gap means a menu was on top and got the release
+		int launchedCheevos = 0;
+
+		// worker
+		std::thread worker;
+		std::mutex uiLock;	// held while a job runs and while the UI is replaced
+		std::mutex wlock;
+		std::condition_variable wcv;
+		bool wstop = false, wwork = false;
+
+		std::unique_ptr<RaProgress> ra;
+		std::shared_ptr<TextureReleaser> releaser;
+
+		Impl(Window* w) : window(w)
+		{
+			setDecoder(esDecode);
+			releaser = std::make_shared<TextureReleaser>();
+			releaser->drop = [this] { if (ui) ui->dropTextures(); };
+			ResourceManager::getInstance()->addReloadable(releaser);
+			worker = std::thread([this] { work(); });
+		}
+
+		~Impl()
+		{
+			{
+				std::lock_guard<std::mutex> l(wlock);
+				wstop = true;
+			}
+			wcv.notify_all();
+			if (worker.joinable())
+				worker.join();
+			ui.reset();
+		}
+
+		void work()
+		{
+			while (true)
+			{
+				{
+					std::unique_lock<std::mutex> l(wlock);
+					wcv.wait(l, [this] { return wstop || wwork; });
+					if (wstop) return;
+					wwork = false;
+				}
+				while (true)
+				{
+					{
+						std::lock_guard<std::mutex> l(wlock);
+						if (wstop) return;
+					}
+					std::lock_guard<std::mutex> l(uiLock);	// the UI is not replaced while a job runs
+					if (!ui || !ui->workOnce())
+						break;
+				}
+			}
+		}
+
+		void kickWorker()
+		{
+			{
+				std::lock_guard<std::mutex> l(wlock);
+				wwork = true;
+			}
+			wcv.notify_all();
+		}
+
+		// ---- setup ----
+		std::string themeAssetDir(SystemData* sys)
+		{
+			if (sys == nullptr || sys->getTheme() == nullptr)
+				return "";
+			auto elem = sys->getTheme()->getElement("rnds", "assets", "image");
+			if (elem == nullptr || !elem->has("path"))
+				return "";
+			return Utils::FileSystem::getParent(elem->get<std::string>("path"));
+		}
+
+		// the theme's palette: <text name="palette"><text>light</text></text> in its rnds view (dark without one)
+		std::string themeVariant(SystemData* sys)
+		{
+			if (sys == nullptr || sys->getTheme() == nullptr)
+				return "dark";
+			auto elem = sys->getTheme()->getElement("rnds", "palette", "text");
+			if (elem == nullptr || !elem->has("text"))
+				return "dark";
+			return Utils::String::toLower(Utils::String::trim(elem->get<std::string>("text"))) == "light" ? "light" : "dark";
+		}
+
+		bool ensureUI()
+		{
+			SystemData* first = systems.size() ? systems[0] : (SystemData::sSystemVector.size() ? SystemData::sSystemVector[0] : nullptr);
+			std::string dir = themeAssetDir(first);
+			std::string var = themeVariant(first);
+			int W = Renderer::getScreenWidth(), H = Renderer::getScreenHeight();
+			backend.dual = W * 3 >= H * 4 * 3 - 3;		// 1920x480 / 3072x768: three panels side by side
+			float panelW = backend.dual ? W / 3.0f : (float)W;
+			float s = H / 480.0f;
+			backend.originX[0] = 0;
+			backend.originX[1] = backend.dual ? panelW : 0;
+			if (dir.empty())
+				return false;
+			if (ui && dir == assetDir && var == variant && std::fabs(s - scale) < 0.001f)
+				return true;
+			std::lock_guard<std::mutex> l(uiLock);
+			ui.reset();
+			assetDir = dir;
+			variant = var;
+			scale = s;
+			ui.reset(new UI(this, &backend, dir, s, var));
+			// a finished picture only needs a frame (it is uploaded in update)
+			ui->setNotifiers([this] { kickWorker(); }, [] { PowerSaver::pushRefreshEvent(); });
+			loadLooks();
+			LOG(LogInfo) << "rnds: engine on " << W << "x" << H << " (" << (backend.dual ? "two panels" : "one panel") << ", scale " << s << "), assets " << dir;
+			if (!ra)
+			{
+				ra.reset(new RaProgress());
+				ra->changed = [this] { pendingRefresh = true; PowerSaver::pushRefreshEvent(); };
+			}
+			return true;
+		}
+
+		void loadLooks()
+		{
+			looks.clear();
+			std::ifstream f(assetDir + "/systems.cfg");
+			std::string ln;
+			while (std::getline(f, ln))
+			{
+				// <system>[,<system>...]  <icon file>  <#accent>  [maker...]
+				if (ln.empty() || ln[0] == '#')
+					continue;
+				std::istringstream is(ln);
+				std::string names, icon, accent, maker;
+				if (ln[0] == '@')
+				{
+					// @<maker name>  <#accent>
+					size_t hash = ln.rfind('#');
+					if (hash == std::string::npos) continue;
+					SysLook mk;
+					mk.accent = Color::hex((uint32_t)strtoul(ln.c_str() + hash + 1, nullptr, 16));
+					mk.hasAccent = true;
+					looks["@" + Utils::String::toLower(Utils::String::trim(ln.substr(1, hash - 1)))] = mk;
+					continue;
+				}
+				is >> names >> icon >> accent;
+				std::getline(is, maker);
+				maker = Utils::String::trim(maker);
+				SysLook look;
+				look.icon = icon == "-" ? "" : assetDir + "/icons/" + icon;
+				if (accent.size() == 7 && accent[0] == '#')
+				{
+					look.accent = Color::hex((uint32_t)strtoul(accent.c_str() + 1, nullptr, 16));
+					look.hasAccent = true;
+				}
+				look.maker = maker;
+				for (auto& n : Utils::String::split(names, ','))
+					looks[Utils::String::toLower(n)] = look;
+			}
+		}
+
+		void refreshSystems()
+		{
+			systems.clear();
+			if (systemView)
+				systems = systemView->getObjects();
+			if (systems.empty())
+				for (auto s : SystemData::sSystemVector)
+					if (s->isVisible())
+						systems.push_back(s);
+		}
+
+		int sysIndex(SystemData* s)
+		{
+			for (int i = 0; i < (int)systems.size(); i++)
+				if (systems[i] == s)
+					return i;
+			if (s)
+				for (int i = 0; i < (int)systems.size(); i++)
+					if (systems[i]->getName() == s->getName())
+						return i;
+			return 0;
+		}
+
+		// ---- text helpers ----
+		static std::string fmtTime(long secs)
+		{
+			long h = secs / 3600, m = (secs % 3600) / 60;
+			char b[32];
+			if (h > 0) snprintf(b, sizeof b, "%ldh %02ldm", h, m);
+			else snprintf(b, sizeof b, "%ldm", m);
+			return b;
+		}
+
+		static std::string relDay(const std::string& stamp)
+		{
+			if (stamp.empty())
+				return "Never";
+			time_t t = Utils::Time::stringToTime(stamp);
+			if (t <= 0)
+				return "Never";
+			time_t now = time(nullptr);
+			struct tm a, b;
+			localtime_r(&t, &a);
+			localtime_r(&now, &b);
+			struct tm da = a, db = b;
+			da.tm_hour = db.tm_hour = 12; da.tm_min = db.tm_min = 0; da.tm_sec = db.tm_sec = 0;
+			long days = (long)std::lround(difftime(mktime(&db), mktime(&da)) / 86400.0);
+			static const char* wd[] = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
+			static const char* mo[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
+			if (days <= 0) return "Today";
+			if (days == 1) return "Yesterday";
+			if (days < 7) return wd[a.tm_wday];
+			if (days < 14) return "Last week";
+			char buf[32];
+			if (days < 330) snprintf(buf, sizeof buf, "%s %d", mo[a.tm_mon], a.tm_mday);
+			else snprintf(buf, sizeof buf, "%s %d", mo[a.tm_mon], a.tm_year + 1900);
+			return buf;
+		}
+
+		static std::string year(FileData* f)
+		{
+			// ES writes a missing date as "not-a-date-time": a year is four digits, and not 0000
+			std::string r = f->getMetadata(MetaDataId::ReleaseDate);
+			if (r.size() < 4 || r.substr(0, 4) == "0000") return "";
+			for (int i = 0; i < 4; i++) if (r[i] < '0' || r[i] > '9') return "";
+			return r.substr(0, 4);
+		}
+
+		// a name as the engine shows it: no file-name leftovers ("(USA, Europe)", "[!]", underscores)
+		static std::string cleanTitle(std::string t)
+		{
+			for (auto& c : t) if (c == '_') c = ' ';
+			std::string r = Utils::String::trim(t);
+			for (;;)
+			{
+				if (r.size() < 3) break;
+				char e = r.back();
+				char o = e == ')' ? '(' : (e == ']' ? '[' : 0);
+				if (!o) break;
+				size_t at = r.rfind(o);
+				if (at == std::string::npos || at == 0) break;
+				std::string rest = Utils::String::trim(r.substr(0, at));
+				if (rest.empty()) break;
+				r = rest;
+			}
+			return r.empty() ? Utils::String::trim(t) : r;
+		}
+
+		// the first of the genres ("Action, Platform" / "Role-playing; Strategy" -> "Action" / "Role-playing")
+		static std::string firstGenre(const std::string& g)
+		{
+			size_t cut = g.find_first_of(",;/|");
+			return Utils::String::trim(cut == std::string::npos ? g : g.substr(0, cut));
+		}
+
+		// a media path from the metadata, absolute, or "" when the file isn't there
+		static std::string mediaPath(FileData* f, MetaDataId id)
+		{
+			std::string p = f->getMetadata(id);
+			if (p.empty()) return "";
+			if (p[0] != '/' && f->getSystem() != nullptr)
+				p = Utils::FileSystem::resolveRelativePath(p, f->getSystem()->getStartPath(), true);
+			return Utils::FileSystem::exists(p) ? p : "";
+		}
+
+		static std::string join(const std::string& a, const std::string& b)
+		{
+			if (a.empty()) return b;
+			if (b.empty()) return a;
+			return a + " · " + b;
+		}
+
+		FileData* resumeOf(SystemData* s)
+		{
+			auto it = resumeCache.find(s);
+			if (it != resumeCache.end())
+				return it->second;
+			FileData* best = nullptr;
+			std::string bestDate;
+			FileData* first = nullptr;
+			if (s && s->getRootFolder())
+				for (auto f : s->getRootFolder()->getFilesRecursive(GAME, true))
+				{
+					if (!first) first = f;
+					std::string last = f->getMetadata(MetaDataId::LastPlayed);
+					if (!last.empty() && last > bestDate) { bestDate = last; best = f; }
+				}
+			FileData* r = best ? best : first;
+			resumeCache[s] = r;
+			return r;
+		}
+
+		// ---- Source ----
+		int systemCount() override { return (int)systems.size(); }
+
+		SysInfo system(int i) override
+		{
+			SysInfo r;
+			if (i < 0 || i >= (int)systems.size())
+				return r;
+			SystemData* s = systems[i];
+			r.id = s->getName();
+			r.name = s->getFullName();
+			r.maker = s->getSystemMetadata().manufacturer;
+			// systems.cfg: the system's name, its theme folder, then by kind ("*portable", "*collection"...), then "*";
+			// a system matched only by kind takes the accent of its maker ("@Sega") when there is one
+			SysLook look;
+			bool named = true;
+			auto it = looks.find(Utils::String::toLower(s->getName()));
+			if (it == looks.end()) it = looks.find(Utils::String::toLower(s->getThemeFolder()));
+			if (it == looks.end())
+			{
+				named = false;
+				std::string kind = s->isCollection() ? "collection" : Utils::String::toLower(s->getSystemMetadata().hardwareType);
+				it = looks.find("*" + kind);
+				if (it == looks.end()) it = looks.find("*");
+			}
+			if (it != looks.end()) look = it->second;
+			if (!named)
+			{
+				auto mk = looks.find("@" + Utils::String::toLower(r.maker));
+				if (mk != looks.end() && mk->second.hasAccent) { look.accent = mk->second.accent; look.hasAccent = true; }
+			}
+			r.icon = look.icon;
+			r.accent = look.hasAccent ? look.accent : Color::hex(0x3d8ec4);
+			if (r.maker.empty()) r.maker = !look.maker.empty() ? look.maker : (s->isCollection() ? "Collection" : "");
+			GameCountInfo* gc = s->getGameCountInfo();
+			if (gc)
+			{
+				r.games = gc->visibleGames;
+				r.played = gc->gamesPlayed;
+				r.time = fmtTime(gc->playTime);
+			}
+			else
+				r.time = "0m";
+			r.fav = favSystems().count(s->getName()) > 0;
+			FileData* res = resumeOf(s);
+			if (res)
+			{
+				r.hasResume = true;
+				r.resumeEyebrow = res->getMetadata(MetaDataId::LastPlayed).empty() ? "Not played yet" : "Last played";
+				r.resumeTitle = cleanTitle(res->getName());
+				r.resumeBox = res->getThumbnailPath(true);
+				r.resumeCart = mediaPath(res, MetaDataId::Cartridge);
+				r.resumeLabel = mediaPath(res, MetaDataId::BoxBack);
+			}
+			return r;
+		}
+
+		int gameCount() override { return list ? (int)list->entries().size() : 0; }
+
+		GameInfo game(int i) override
+		{
+			GameInfo r;
+			if (!list || i < 0 || i >= (int)list->entries().size())
+				return r;
+			FileData* f = list->entries()[i];
+			r.title = f->getPath() == ".." ? ". ." : cleanTitle(f->getName());
+			r.plays = "-"; r.last = "-"; r.time = "-";
+			if (f->getType() == FOLDER)
+			{
+				r.sub = "Folder";
+				r.box = f->getThumbnailPath(true);
+				r.achLabel = "No achievements";
+				return r;
+			}
+			if (f->getType() != GAME)
+			{
+				r.sub = "";
+				r.achLabel = "No achievements";
+				return r;
+			}
+			std::string g = firstGenre(f->getGenre()), y = year(f);
+			r.sub = join(g, y);
+			int plays = atoi(f->getMetadata(MetaDataId::PlayCount).c_str());
+			r.plays = std::to_string(plays);
+			r.last = relDay(f->getMetadata(MetaDataId::LastPlayed));
+			r.time = fmtTime(atol(f->getMetadata(MetaDataId::GameTime).c_str()));
+			r.box = f->getThumbnailPath(true);
+			r.cart = mediaPath(f, MetaDataId::Cartridge);
+			r.label = mediaPath(f, MetaDataId::BoxBack);
+			r.fav = f->getFavorite();
+
+			int id = atoi(f->getMetadata(MetaDataId::CheevosId).c_str());
+			if (SystemConf::getInstance()->get("global.retroachievements.username").empty())
+				r.achLabel = "RetroAchievements off";
+			else if (id <= 0)
+				r.achLabel = "No achievements";
+			else
+			{
+				RaProgress::Entry e = ra ? ra->get(id, false) : RaProgress::Entry();
+				if (e.state == 1)
+				{
+					r.achA = e.a; r.achB = e.b;
+					r.achLabel = e.b > 0 ? std::to_string(e.a) + " / " + std::to_string(e.b) + " achievements" : "No achievements";
+				}
+				else
+					r.achLabel = "- / - achievements";
+			}
+			return r;
+		}
+
+		std::string clockText() override
+		{
+			time_t now = time(nullptr);
+			struct tm t;
+			localtime_r(&now, &t);
+			char b[32];
+			strftime(b, sizeof b, Settings::getInstance()->getBool("ClockMode12") ? "%I:%M %p" : "%H:%M", &t);
+			return b;
+		}
+
+		std::string dateText() override
+		{
+			time_t now = time(nullptr);
+			struct tm t;
+			localtime_r(&now, &t);
+			char b[16];
+			strftime(b, sizeof b, "%m/%d", &t);
+			return b;
+		}
+
+		std::string batteryMode() override { return Settings::getInstance()->getString("ShowBattery"); }
+		bool topMotion() override { return !Settings::getInstance()->getBool("RndsStillTopScreen"); }
+
+		float battery() override
+		{
+			auto w = WatchersManager::GetComponent<BatteryLevelWatcher>();
+			if (w == nullptr || !w->getBatteryInfo().hasBattery)
+				return -1;
+			return w->getBatteryInfo().level / 100.0f;
