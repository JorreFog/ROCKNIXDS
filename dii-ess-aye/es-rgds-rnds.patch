@@ -0,0 +1,60 @@
+#pragma once
+#ifndef ES_APP_VIEWS_GAME_LIST_RNDS_GAME_LIST_VIEW_H
+#define ES_APP_VIEWS_GAME_LIST_RNDS_GAME_LIST_VIEW_H
+
+#include "views/gamelist/ISimpleGameListView.h"
+
+// ROCKNIXDS: a system's games for themes drawn by the rnds engine (rnds/RndsEs.h). It keeps the list and the cursor
+// the way ES's other game lists do (folders, filters, sorting, favourites, menus); the engine draws it and takes its
+// input.
+class RndsGameListView : public ISimpleGameListView
+{
+public:
+	RndsGameListView(Window* window, FolderData* root);
+	~RndsGameListView();
+
+	virtual void onFileChanged(FileData* file, FileChangeType change) override;
+	virtual void onThemeChanged(const std::shared_ptr<ThemeData>& theme) override;
+
+	virtual FileData* getCursor() override;
+	virtual void setCursor(FileData* file) override;
+	virtual int getCursorIndex() override;
+	virtual void setCursorIndex(int index) override;
+	virtual void resetLastCursor() override {}
+
+	virtual const char* getName() const override { return "rnds"; }
+	virtual void launch(FileData* game) override;
+	virtual std::vector<FileData*> getFileDataEntries() override { return mEntries; }
+
+	virtual bool input(InputConfig* config, Input input) override;
+	virtual void update(int deltaTime) override;
+	virtual void render(const Transform4x4f& parentTrans) override;
+	virtual void onShow() override;
+	virtual bool onMouseClick(int button, bool pressed, int x, int y) override;
+	virtual bool hitTest(int x, int y, Transform4x4f& parentTransform, std::vector<GuiComponent*>* pResult = nullptr) override;
+	virtual std::vector<HelpPrompt> getHelpPrompts() override { return std::vector<HelpPrompt>(); }
+
+	// for the engine
+	const std::vector<FileData*>& entries() const { return mEntries; }
+	SystemData* system();
+	bool openSelected();	// what ES's A does on the cursor: open a folder / go up, or false for a game
+	void launchSelected();	// ES's launch path for the cursor game (save-state chooser when that's on)
+	void goUp();			// B: up a folder, or back to the systems
+	bool inFolder() const { return mCursorStack.size() > 0; }
+	int resumeIndex();		// the most recently played game, else the first game
+	void showOptions() { showSelectedGameOptions(); }
+	void showSaves() { showSelectedGameSaveSnapshots(); }
+	void showListOptions() { showGamelistOptions(); }
+
+protected:
+	virtual std::string getQuickSystemSelectRightButton() override { return "righttrigger"; }
+	virtual std::string getQuickSystemSelectLeftButton() override { return "lefttrigger"; }
+	virtual void populateList(const std::vector<FileData*>& files) override;
+	virtual void remove(FileData* game) override;
+
+private:
+	std::vector<FileData*> mEntries;
+	int mCursor = 0;
+};
+
+#endif
