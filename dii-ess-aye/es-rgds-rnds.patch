+
+	static Bitmap(*sDecoder)(const std::string&) = nullptr;
+	void setDecoder(Bitmap(*decoder)(const std::string& path)) { sDecoder = decoder; }
+	Bitmap decodeFile(const std::string& path) { return sDecoder && !path.empty() ? sDecoder(path) : Bitmap(); }
+
+	Bitmap resize(const Bitmap& src, int w, int h)
+	{
+		Bitmap out;
+		if (src.empty() || w <= 0 || h <= 0)
+			return out;
+		out.w = w; out.h = h; out.alpha = src.alpha;
+		int ch = src.alpha ? 1 : 4;
+		out.px.assign((size_t)w * h * ch, 0);
+		float sx = src.w / (float)w, sy = src.h / (float)h;
+		if (sx <= 1 && sy <= 1)
+		{
+			// bilinear (premultiplied)
+			for (int y = 0; y < h; y++)
+				for (int x = 0; x < w; x++)
+				{
+					float fx = (x + 0.5f) * sx - 0.5f, fy = (y + 0.5f) * sy - 0.5f;
+					int x0 = (int)std::floor(fx), y0 = (int)std::floor(fy);
+					float tx = fx - x0, ty = fy - y0;
+					float acc[4] = { 0, 0, 0, 0 };
+					for (int j = 0; j < 2; j++)
+						for (int i = 0; i < 2; i++)
+						{
+							int xx = std::min(std::max(x0 + i, 0), src.w - 1), yy = std::min(std::max(y0 + j, 0), src.h - 1);
+							float wgt = (i ? tx : 1 - tx) * (j ? ty : 1 - ty);
+							const uint8_t* p = &src.px[((size_t)yy * src.w + xx) * ch];
+							if (ch == 1) acc[3] += p[0] * wgt;
+							else
+							{
+								float a = p[3] / 255.0f;
+								acc[0] += p[0] * a * wgt; acc[1] += p[1] * a * wgt; acc[2] += p[2] * a * wgt; acc[3] += p[3] * wgt;
+							}
+						}
+					uint8_t* o = &out.px[((size_t)y * w + x) * ch];
+					if (ch == 1) o[0] = (uint8_t)roundi(acc[3]);
+					else
+					{
+						float a = acc[3] / 255.0f;
+						o[3] = (uint8_t)roundi(acc[3]);
+						if (a > 0) { o[0] = (uint8_t)roundi(std::min(255.0f, acc[0] / a)); o[1] = (uint8_t)roundi(std::min(255.0f, acc[1] / a)); o[2] = (uint8_t)roundi(std::min(255.0f, acc[2] / a)); }
+					}
+				}
+			return out;
+		}
+		// area average (premultiplied) when shrinking
+		for (int y = 0; y < h; y++)
+		{
+			float y0 = y * sy, y1 = (y + 1) * sy;
+			for (int x = 0; x < w; x++)
+			{
+				float x0 = x * sx, x1 = (x + 1) * sx;
+				float acc[4] = { 0, 0, 0, 0 }, tot = 0;
+				for (int yy = (int)std::floor(y0); yy < (int)std::ceil(y1) && yy < src.h; yy++)
+				{
+					float wy = std::min(y1, yy + 1.0f) - std::max(y0, (float)yy);
+					if (wy <= 0) continue;
+					for (int xx = (int)std::floor(x0); xx < (int)std::ceil(x1) && xx < src.w; xx++)
+					{
+						float wx = std::min(x1, xx + 1.0f) - std::max(x0, (float)xx);
+						if (wx <= 0) continue;
+						float wgt = wx * wy;
+						const uint8_t* p = &src.px[((size_t)yy * src.w + xx) * ch];
+						if (ch == 1) acc[3] += p[0] * wgt;
+						else
+						{
+							float a = p[3] / 255.0f;
+							acc[0] += p[0] * a * wgt; acc[1] += p[1] * a * wgt; acc[2] += p[2] * a * wgt; acc[3] += p[3] * wgt;
+						}
+						tot += wgt;
+					}
+				}
+				if (tot <= 0) continue;
+				uint8_t* o = &out.px[((size_t)y * w + x) * ch];
+				if (ch == 1) o[0] = (uint8_t)roundi(acc[3] / tot);
+				else
+				{
+					float a = acc[3] / tot / 255.0f;
+					o[3] = (uint8_t)roundi(acc[3] / tot);
+					if (a > 0) { o[0] = (uint8_t)roundi(std::min(255.0f, acc[0] / tot / a)); o[1] = (uint8_t)roundi(std::min(255.0f, acc[1] / tot / a)); o[2] = (uint8_t)roundi(std::min(255.0f, acc[2] / tot / a)); }
+				}
+			}
+		}
+		return out;
+	}
+
+	Bitmap resizeNearest(const Bitmap& src, int w, int h)
+	{
+		Bitmap out;
+		if (src.empty() || w <= 0 || h <= 0)
+			return out;
+		out.w = w; out.h = h; out.alpha = src.alpha;
+		int ch = src.alpha ? 1 : 4;
+		out.px.resize((size_t)w * h * ch);
+		for (int y = 0; y < h; y++)
+		{
+			int sy = std::min(src.h - 1, (int)((y + 0.5f) * src.h / h));
+			for (int x = 0; x < w; x++)
+			{
+				int sx = std::min(src.w - 1, (int)((x + 0.5f) * src.w / w));
+				memcpy(&out.px[((size_t)y * w + x) * ch], &src.px[((size_t)sy * src.w + sx) * ch], ch);
+			}
+		}
+		return out;
+	}
+
+	Bitmap cover(const Bitmap& src, int w, int h)
+	{
+		if (src.empty() || w <= 0 || h <= 0)
+			return Bitmap();
+		float ia = src.w / (float)src.h, ra = w / (float)h;
+		float dw, dh;
+		if (ia > ra) { dh = (float)h; dw = h * ia; }
+		else { dw = (float)w; dh = w / ia; }
+		// crop the source to the visible part, then resample to w x h
+		float cw = src.w * (w / dw), chh = src.h * (h / dh);
+		int cx = (int)std::floor((src.w - cw) / 2), cy = (int)std::floor((src.h - chh) / 2);
+		int icw = std::max(1, (int)std::ceil(cw)), ich = std::max(1, (int)std::ceil(chh));
+		icw = std::min(icw, src.w - cx); ich = std::min(ich, src.h - cy);
+		Bitmap crop;
+		crop.w = icw; crop.h = ich; crop.alpha = src.alpha;
+		int ch = src.alpha ? 1 : 4;
+		crop.px.resize((size_t)icw * ich * ch);
+		for (int y = 0; y < ich; y++)
+			memcpy(&crop.px[(size_t)y * icw * ch], &src.px[((size_t)(y + cy) * src.w + cx) * ch], (size_t)icw * ch);
+		return resize(crop, w, h);
+	}
+
+	Bitmap crop(const Bitmap& src, int x, int y, int w, int h)
+	{
+		if (src.empty() || src.alpha) return src;
+		x = std::max(0, std::min(x, src.w - 1)); y = std::max(0, std::min(y, src.h - 1));
+		w = std::max(1, std::min(w, src.w - x)); h = std::max(1, std::min(h, src.h - y));
+		Bitmap r;
+		r.w = w; r.h = h;
+		r.px.resize((size_t)w * h * 4);
+		for (int yy = 0; yy < h; yy++)
+			memcpy(&r.px[(size_t)yy * w * 4], &src.px[((size_t)(yy + y) * src.w + x) * 4], (size_t)w * 4);
+		return r;
+	}
+
+	static bool nearWhite(const uint8_t* p)
+	{
+		int mx = std::max(p[0], std::max(p[1], p[2])), mn = std::min(p[0], std::min(p[1], p[2]));
+		return mn > 190 && mx - mn < 40 && p[3] > 128;
+	}
+
+	// a row or column that is plain: mostly near-white, or one flat colour (a label's white margin, the card's plastic)
+	static bool plainLine(const Bitmap& b, int x0, int y0, int dx, int dy, int n)
+	{
+		int white = 0, cnt = 0, grey = 0;
+		double sum = 0, sum2 = 0;
+		for (int i = 0; i < n; i += 2, cnt++)
+		{
+			const uint8_t* p = &b.px[((size_t)(y0 + dy * i) * b.w + (x0 + dx * i)) * 4];
+			if (nearWhite(p) || p[3] < 128) white++;
+			int mx = std::max(p[0], std::max(p[1], p[2])), mn = std::min(p[0], std::min(p[1], p[2]));
+			if (mx - mn < 24) grey++;
+			double l = 0.3 * p[0] + 0.59 * p[1] + 0.11 * p[2];
+			sum += l; sum2 += l * l;
+		}
+		if (cnt == 0) return true;
+		double m = sum / cnt, sd = std::sqrt(std::max(0.0, sum2 / cnt - m * m));
+		// white, or the card's flat grey plastic; a flat coloured band is the art's own
+		return white > cnt * 6 / 10 || (sd < 10 && grey > cnt * 8 / 10);
+	}
+
+	// trims plain edges (up to a quarter of each side), so the picture inside fills what it is fitted to
+	static Bitmap trimPlain(const Bitmap& b)
+	{
+		if (b.empty() || b.alpha) return b;
+		int x0 = 0, y0 = 0, x1 = b.w - 1, y1 = b.h - 1;
+		while (x0 < b.w / 4 && plainLine(b, x0, y0, 0, 1, y1 - y0 + 1)) x0++;
+		while (x1 > b.w * 3 / 4 && plainLine(b, x1, y0, 0, 1, y1 - y0 + 1)) x1--;
+		while (y0 < b.h / 4 && plainLine(b, x0, y0, 1, 0, x1 - x0 + 1)) y0++;
+		while (y1 > b.h * 3 / 4 && plainLine(b, x0, y1, 1, 0, x1 - x0 + 1)) y1--;
+		// and one more pixel: the edge of the art itself is often a thin line
+		x0 = std::min(x0 + 1, x1); y0 = std::min(y0 + 1, y1); x1 = std::max(x1 - 1, x0); y1 = std::max(y1 - 1, y0);
+		return crop(b, x0, y0, x1 - x0 + 1, y1 - y0 + 1);
+	}
+
+	Bitmap cardLabelArt(const Bitmap& scan)
+	{
+		if (scan.empty() || scan.alpha) return Bitmap();
+		// the card: the bounding box of what isn't transparent (cut-out scans) or the whole picture
+		int x0 = scan.w, y0 = scan.h, x1 = -1, y1 = -1;
+		for (int y = 0; y < scan.h; y++)
+			for (int x = 0; x < scan.w; x++)
+				if (scan.px[((size_t)y * scan.w + x) * 4 + 3] > 16)
+				{
+					x0 = std::min(x0, x); x1 = std::max(x1, x); y0 = std::min(y0, y); y1 = std::max(y1, y);
+				}
+		if (x1 < x0 || y1 < y0) return Bitmap();
+		int cw = x1 - x0 + 1, ch = y1 - y0 + 1;
+		// the label spans the card but for its plastic edges. From the top: plastic, the white NINTENDO DS header, then
+		// the art; from the bottom: plastic, the white strip with the game code, then the art. The art is what's
+		// between the two white bands.
+		int lx0 = x0 + cw * 8 / 100, lx1 = x1 - cw * 8 / 100;
+		auto whiteRow = [&](int y)
+		{
+			int white = 0, n = 0;
+			for (int x = lx0; x <= lx1; x += 2, n++)
+				if (nearWhite(&scan.px[((size_t)y * scan.w + x) * 4])) white++;
+			return n > 0 && white >= n * 45 / 100;
+		};
+		int ay0 = -1, ay1 = -1;
+		{
+			int y = y0, lim = y0 + ch * 40 / 100;
+			while (y < lim && !whiteRow(y)) y++;			// the plastic above the label
+			if (y < lim)
+			{
+				while (y < lim && whiteRow(y)) y++;		// the header
+				if (y < lim) ay0 = y;
+			}
+		}
+		{
+			int y = y1, lim = y1 - ch * 40 / 100;
+			while (y > lim && !whiteRow(y)) y--;			// the plastic below the label
+			if (y > lim)
+			{
+				while (y > lim && whiteRow(y)) y--;		// the code strip
+				if (y > lim) ay1 = y;
+			}
+		}
+		if (ay0 < 0) ay0 = y0 + ch * 18 / 100;		// where the art sits on a DS card's label when the scan doesn't say
+		if (ay1 < 0 || ay1 - ay0 < ch * 30 / 100) ay1 = y0 + ch * 82 / 100;
+		return trimPlain(crop(scan, lx0, ay0, lx1 - lx0 + 1, ay1 - ay0 + 1));
+	}
+
+	Bitmap coverWithoutStrip(const Bitmap& box)
+	{
+		if (box.empty() || box.alpha) return box;
+		// columns from the left that are mostly near-white, at least the 13.5% the strip takes on DS covers
+		int x = 0, limit = box.w / 5;
+		for (; x < limit; x++)
+		{
+			int white = 0, n = 0;
+			for (int y = 0; y < box.h; y += 2, n++)
+				if (nearWhite(&box.px[((size_t)y * box.w + x) * 4])) white++;
+			if (white < n * 55 / 100) break;
+		}
+		if (x <= box.w * 4 / 100) return box;
+		x = std::max(x, box.w * 135 / 1000) + 2;
+		return trimPlain(crop(box, x, 0, box.w - x, box.h));
+	}
+
+	Bitmap coverTop(const Bitmap& src, int w, int h)
+	{
+		if (src.empty() || w <= 0 || h <= 0)
+			return Bitmap();
+		float ia = src.w / (float)src.h, ra = w / (float)h;
+		if (ia > ra)
+			return cover(src, w, h);		// too wide: centred left and right, all of its height
+		// too tall: all of its width, from its top (a label's logo is at the top)
+		int ch = std::max(1, std::min(src.h, (int)std::lround(src.w / ra)));
+		return resize(crop(src, 0, 0, src.w, ch), w, h);
+	}
+
+	void containSize(int iw, int ih, int bw, int bh, float& outW, float& outH)
+	{
+		if (iw <= 0 || ih <= 0) { outW = (float)bw; outH = (float)bh; return; }
+		float s = std::min(bw / (float)iw, bh / (float)ih);
+		outW = iw * s;
+		outH = ih * s;
+	}
+
+	void blit(Bitmap& dst, const Bitmap& src, int ox, int oy)
+	{
+		if (dst.alpha || src.alpha)
+			return;
+		for (int y = 0; y < src.h; y++)
+		{
+			int ty = y + oy;
+			if (ty < 0 || ty >= dst.h) continue;
+			for (int x = 0; x < src.w; x++)
+			{
+				int tx = x + ox;
+				if (tx < 0 || tx >= dst.w) continue;
+				const uint8_t* s = &src.px[((size_t)y * src.w + x) * 4];
+				uint8_t* d = &dst.px[((size_t)ty * dst.w + tx) * 4];
+				float sa = s[3] / 255.0f, da = d[3] / 255.0f;
+				float oa = sa + da * (1 - sa);
+				if (oa <= 0) { d[0] = d[1] = d[2] = d[3] = 0; continue; }
+				for (int k = 0; k < 3; k++)
+					d[k] = (uint8_t)roundi((s[k] * sa + d[k] * da * (1 - sa)) / oa);
+				d[3] = (uint8_t)roundi(oa * 255);
+			}
+		}
+	}
+}
diff --git a/es-app/src/rnds/RndsRaster.h b/es-app/src/rnds/RndsRaster.h
new file mode 100644
index 00000000..026769b4
--- /dev/null
+++ b/es-app/src/rnds/RndsRaster.h
@@ -0,0 +1,175 @@
+#pragma once
+// ROCKNIXDS rnds engine: CPU rasterizer for the pieces the mockup is drawn from. Boxes are painted the way CSS paints a
+// box (outer box-shadows, background colour, hard-stop gradient bands and the dither tile, inset box-shadows, border),
+// text the way Chrome lays out Pixelify Sans on Linux (whole-pixel glyph advances and kerning, light hinting), images
+// are decoded and fitted (cover / contain). Everything here is plain C++ and FreeType, so the same code runs in ES and
+// in the host test harness that compares the engine's frames with the mockup rendered by Chromium.
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+typedef struct FT_LibraryRec_* FT_Library;
+typedef struct FT_FaceRec_* FT_Face;
+
+namespace rnds
+{
+	struct Color
+	{
+		float r = 0, g = 0, b = 0, a = 0; // straight alpha, 0..1
+		Color() {}
+		Color(float r_, float g_, float b_, float a_ = 1) : r(r_), g(g_), b(b_), a(a_) {}
+		static Color hex(uint32_t rgb, float a = 1) { return Color(((rgb >> 16) & 255) / 255.0f, ((rgb >> 8) & 255) / 255.0f, (rgb & 255) / 255.0f, a); }
+		bool transparent() const { return a <= 0; }
+		uint32_t rgba8() const; // 0xRRGGBBAA
+	};
+
+	// color-mix(in srgb, a p%, b)
+	Color mix(const Color& a, float p, const Color& b);
+
+	// RGBA8 (straight alpha) or A8 pixels, rows top to bottom
+	struct Bitmap
+	{
+		int w = 0, h = 0;
+		bool alpha = false;		// A8 coverage (drawn tinted) instead of RGBA8
+		std::vector<uint8_t> px;
+		bool empty() const { return w <= 0 || h <= 0; }
+	};
+
+	// premultiplied float surface everything is composited on before it becomes a Bitmap
+	class Surface
+	{
+	public:
+		Surface(int w, int h);
+		int w, h;
+		std::vector<float> d;	// premultiplied RGBA
+
+		// source-over a colour through a per-pixel coverage function over [x0,x1) x [y0,y1)
+		template<typename F> void paint(int x0, int y0, int x1, int y1, const Color& c, F coverage);
+		template<typename F> void paintFrame(int x0, int y0, int x1, int y1, int sx0, int sy0, int sx1, int sy1, const Color& c, F coverage);
+		void drawBitmap(const Bitmap& b, float dx, float dy, const Color& tint = Color(1, 1, 1, 1));
+		Bitmap toBitmap(bool bleed = true) const;
+	};
+
+	// ---- shapes ---------------------------------------------------------------------------------------------------
+	struct RRect
+	{
+		float x = 0, y = 0, w = 0, h = 0, r = 0;
+		RRect() {}
+		RRect(float x_, float y_, float w_, float h_, float r_) : x(x_), y(y_), w(w_), h(h_), r(r_) {}
+		RRect inset(float d) const { return RRect(x + d, y + d, w - 2 * d, h - 2 * d, r - d > 0 ? r - d : 0); }
+		RRect moved(float dx, float dy) const { return RRect(x + dx, y + dy, w, h, r); }
+		float coverage(float px, float py) const; // anti-aliased coverage of the pixel whose centre is (px, py)
+	};
+
+	// ---- CSS box ----------------------------------------------------------------------------------------------------
+	struct Band { float y0, y1; Color c; };			// background: linear-gradient(...) hard stops, padding-box y
+	struct Shadow { float dx, dy, spread; Color c; bool inset; };
+
+	struct BoxStyle
+	{
+		float radius = 0;
+		float border = 0;			// device pixels (already snapped)
+		Color borderColor;
+		Color bg;
+		std::vector<Band> bands;	// device pixels from the padding box's top; y1 < 0 means to the bottom
+		bool dither = false;		// the mockup's --dither tile, origin at the padding box
+		float ditherScale = 1;		// CSS px -> device px
+		Color ditherA = Color(1, 1, 1, 0.14f), ditherB = Color(1, 1, 1, 0.07f);	// the tile's two dots (light themes: dark dots)
+		std::vector<Shadow> shadows;	// CSS order: the first one is on top
+	};
+
+	// The box at (0,0) w x h in device pixels. The bitmap also holds the outer shadows: the box's top-left corner is at
+	// (originX, originY) in it.
+	struct PaintedBox { Bitmap bmp; int originX = 0, originY = 0; };
+	PaintedBox paintBox(const BoxStyle& st, int w, int h, bool bleed = true);
+	// A8 coverage of a rounded rectangle w x h
+	Bitmap paintMask(int w, int h, float radius);
+
+	// a triangle (the bubble's pointer), anti-aliased, into its bounding box
+	Bitmap paintTriangle(float x0, float y0, float x1, float y1, float x2, float y2, const Color& c, int& outX, int& outY);
+
+	// ---- text -------------------------------------------------------------------------------------------------------
+	struct TextLine; struct TextStyle; struct TextBitmap;
+	class Font
+	{
+	public:
+		static std::shared_ptr<Font> load(const std::string& path);
+		~Font();
+
+		bool hasGlyph(uint32_t cp);
+		int upm() const;
+		float ascent(float size) const;	// whole pixels, as Chrome rounds them
+		float descent(float size) const;
+		float normalLineHeight(float size) const { return ascent(size) + descent(size); }
+
+		// whole-pixel advance of cp followed by next (kerning included, each rounded on its own)
+		int advance(uint32_t cp, uint32_t next, float size);
+
+	private:
+		Font() {}
+		friend TextBitmap renderLine(const TextLine& line, const TextStyle& st, float scale, float baselineCss, float leftFrac, float topFrac);
+		std::vector<uint8_t> mData;
+		FT_Face mFace = nullptr;
+		int mUpm = 1000, mAsc = 0, mDesc = 0;
+		std::unordered_map<uint32_t, unsigned> mGlyphIndex;
+		unsigned glyphIndex(uint32_t cp);
+	};
+
+	struct TextStyle
+	{
+		std::shared_ptr<Font> font;
+		float size = 16;			// device pixels
+		float letterSpacing = 0;	// device pixels, after every character (CSS letter-spacing)
+		bool upper = false;			// text-transform: uppercase
+	};
+
+	std::u32string utf8to32(const std::string& s);
+	std::u32string upper(const std::u32string& s);
+
+	// laid-out single line: whole-pixel pen positions
+	struct TextLine
+	{
+		std::u32string text;
+		std::vector<float> x;	// pen x of each character (whole-pixel advances plus letter-spacing)
+		float width = 0;		// advances + letter-spacing (CSS inline size)
+	};
+
+	TextLine layoutLine(const std::u32string& text, const TextStyle& st);
+	// text-overflow: ellipsis within maxWidth (device px)
+	TextLine layoutEllipsis(const std::u32string& text, const TextStyle& st, int maxWidth);
+	// greedy wrap at spaces (CSS white-space: normal), at most maxLines (the last one ends in an ellipsis when cut)
+	std::vector<TextLine> layoutWrap(const std::u32string& text, const TextStyle& st, int maxWidth, int maxLines = 0, int firstLineIndent = 0);
+
+	// A8 bitmap of a line laid out in CSS px, drawn at scale (device px per CSS px). The bitmap's (0,0) goes at device
+	// (round(left * scale) - padX, round(top * scale) - padY) for a line box whose top-left is (left, top) in CSS px;
+	// baselineCss is the baseline's offset from the line box top in CSS px.
+	struct TextBitmap { Bitmap bmp; int padX = 0, padY = 0; };
+	extern int gTextMode;	// calibration switch for the harness (hinting / positioning variants)
+	TextBitmap renderLine(const TextLine& line, const TextStyle& st, float scale, float baselineCss, float leftFrac = 0, float topFrac = 0);
+
+	// ---- images -----------------------------------------------------------------------------------------------------
+	Bitmap decodeFile(const std::string& path);		// RGBA8; empty on failure (decoder is set by the host)
+	void setDecoder(Bitmap(*decoder)(const std::string& path));
+
+	// resample (bilinear, area-averaged when shrinking) to w x h
+	Bitmap resize(const Bitmap& src, int w, int h);
+	// nearest-neighbour scale (pixel art)
+	Bitmap resizeNearest(const Bitmap& src, int w, int h);
+	// object-fit: cover, centred, into w x h
+	Bitmap cover(const Bitmap& src, int w, int h);
+	// cover, but a picture taller than the box keeps its top (cut at the bottom)
+	Bitmap coverTop(const Bitmap& src, int w, int h);
+	// object-fit: contain: the fitted size (w x h stays the box)
+	void containSize(int iw, int ih, int bw, int bh, float& outW, float& outH);
+	// draws src over dst at (x, y) (straight alpha both)
+	void blit(Bitmap& dst, const Bitmap& src, int x, int y);
+	// a part of an RGBA8 bitmap (clamped to it)
+	Bitmap crop(const Bitmap& src, int x, int y, int w, int h);
+	// the artwork window of a real DS card scan: the label without its white NINTENDO DS header and code footer, and
+	// without the card's plastic around it
+	Bitmap cardLabelArt(const Bitmap& scan);
+	// a DS box cover without the case's white NINTENDO DS strip down its left edge
+	Bitmap coverWithoutStrip(const Bitmap& box);
+}
