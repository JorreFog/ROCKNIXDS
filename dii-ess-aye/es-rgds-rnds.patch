+		// ---- cache ----
+		CacheEntry* find(const std::string& key)
+		{
+			auto it = cache.find(key);
+			if (it == cache.end()) return nullptr;
+			it->second.used = frame;
+			return &it->second;
+		}
+
+		CacheEntry& put(const std::string& key, int group, const Bitmap& b, bool smooth, int ox, int oy)
+		{
+			CacheEntry& e = cache[key];
+			e.sp.tex = be->upload(b, smooth);
+			e.sp.ox = ox; e.sp.oy = oy;
+			e.used = frame;
+			e.group = group;
+			e.bytes = (size_t)b.w * b.h * (b.alpha ? 1 : 4);
+			return e;
+		}
+
+		void evict()
+		{
+			size_t count[G_COUNT] = { 0 };
+			for (auto& kv : cache) count[kv.second.group]++;
+			for (int g = 0; g < G_COUNT; g++)
+			{
+				while (count[g] > GROUP_LIMIT[g])
+				{
+					auto oldest = cache.end();
+					for (auto it = cache.begin(); it != cache.end(); ++it)
+						if (it->second.group == g && it->second.used < frame && (oldest == cache.end() || it->second.used < oldest->second.used))
+							oldest = it;
+					if (oldest == cache.end()) break;
+					cache.erase(oldest);
+					count[g]--;
+				}
+			}
+		}
