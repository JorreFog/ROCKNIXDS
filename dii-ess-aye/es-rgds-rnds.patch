--- /dev/null
+++ b/es-app/src/views/gamelist/RndsGameListView.cpp
@@ -0,0 +1,239 @@
+#include "views/gamelist/RndsGameListView.h"
+
+#include "rnds/RndsEs.h"
+#include "views/ViewController.h"
+#include "CollectionSystemManager.h"
+#include "SaveStateRepository.h"
+#include "guis/GuiSaveState.h"
+#include "FileData.h"
+#include "Settings.h"
+#include "Sound.h"
+#include "SystemData.h"
+#include "Window.h"
+#include "renderers/Renderer.h"
+
+RndsGameListView::RndsGameListView(Window* window, FolderData* root) : ISimpleGameListView(window, root)
+{
+	rnds::EsHost::get(window)->attach(this);
+	populateList(root->getChildrenListToDisplay());
+}
+
+RndsGameListView::~RndsGameListView()
+{
+	if (auto host = rnds::EsHost::instance())
+		host->detach(this);
+}
+
+SystemData* RndsGameListView::system() { return mRoot->getSystem(); }
+
+void RndsGameListView::onThemeChanged(const std::shared_ptr<ThemeData>& theme)
+{
+	ISimpleGameListView::onThemeChanged(theme);
+	if (auto host = rnds::EsHost::instance())
+		host->dataChanged();
+}
+
+void RndsGameListView::onFileChanged(FileData* file, FileChangeType change)
+{
+	if (change == FILE_METADATA_CHANGED)
+	{
+		// the engine re-reads names, art, play stats and favourites; the list itself didn't change
+		if (auto host = rnds::EsHost::instance())
+			host->dataChanged();
+		return;
+	}
+	ISimpleGameListView::onFileChanged(file, change);
+}
+
+void RndsGameListView::populateList(const std::vector<FileData*>& files)
+{
+	FileData* keep = mEntries.size() && mCursor >= 0 && mCursor < (int)mEntries.size() ? mEntries[mCursor] : nullptr;
+	mEntries.clear();
+	if (files.size() > 0)
+	{
+		bool showParentFolder = mRoot->getSystem()->getShowParentFolder();
+		if (showParentFolder && mCursorStack.size())
+			mEntries.push_back(createParentFolderData());
+		for (auto file : files)
+			mEntries.push_back(file);
+	}
+	else
+		mEntries.push_back(createNoEntriesPlaceholder());
+
+	mCursor = 0;
+	if (keep)
+		for (int i = 0; i < (int)mEntries.size(); i++)
+			if (mEntries[i] == keep) { mCursor = i; break; }
+	if (mCursor == 0 && mEntries.size() > 1 && mEntries[0]->getPath() == ".." && mCursorStack.size())
+		mCursor = 1;
+
+	updateFolderPath();
+	if (auto host = rnds::EsHost::instance())
+		host->dataChanged();
+}
+
+FileData* RndsGameListView::getCursor()
+{
+	if (mEntries.empty())
+		return nullptr;
+	if (mCursor < 0 || mCursor >= (int)mEntries.size())
+		mCursor = 0;
+	return mEntries[mCursor];
+}
+
+void RndsGameListView::setCursor(FileData* cursor)
+{
+	if (cursor == nullptr)
+		return;
+	for (int i = 0; i < (int)mEntries.size(); i++)
+		if (mEntries[i] == cursor) { setCursorIndex(i); return; }
+
+	if (!cursor->isPlaceHolder())
+	{
+		// in another folder: show that folder
+		std::stack<FileData*> stack;
+		auto children = mRoot->findChildrenListToDisplayAtCursor(cursor, stack);
+		if (children != nullptr)
+		{
+			mCursorStack = stack;
+			populateList(*children.get());
+			for (int i = 0; i < (int)mEntries.size(); i++)
+				if (mEntries[i] == cursor) { setCursorIndex(i); return; }
+		}
+	}
+}
+
+int RndsGameListView::getCursorIndex() { return mCursor; }
+
+void RndsGameListView::setCursorIndex(int index)
+{
+	if (mEntries.empty())
+		return;
+	mCursor = ((index % (int)mEntries.size()) + (int)mEntries.size()) % (int)mEntries.size();
+	if (auto host = rnds::EsHost::instance())
+		host->showLibrary(nullptr);	// keeps the engine's cursor in step when ES moved it (jump to letter, random game...)
+}
+
+int RndsGameListView::resumeIndex()
+{
+	int best = -1;
+	std::string bestDate;
+	for (int i = 0; i < (int)mEntries.size(); i++)
+	{
+		FileData* f = mEntries[i];
+		if (f->getType() != GAME)
+			continue;
+		std::string last = f->getMetadata(MetaDataId::LastPlayed);
+		if (!last.empty() && last > bestDate) { bestDate = last; best = i; }
+	}
+	if (best >= 0)
+		return best;
+	for (int i = 0; i < (int)mEntries.size(); i++)
+		if (mEntries[i]->getType() == GAME)
+			return i;
+	return 0;
+}
+
+bool RndsGameListView::openSelected()
+{
+	FileData* cursor = getCursor();
+	if (cursor == nullptr)
+		return true;
+	if (mCursorStack.size() && (cursor->getType() == PLACEHOLDER || cursor->getType() == FOLDER) && cursor->getPath() == "..")
+	{
+		goBack();
+		return true;
+	}
+	if (cursor->getType() == FOLDER)
+	{
+		moveToFolder((FolderData*)cursor);
+		return true;
+	}
+	return cursor->getType() != GAME;	// a placeholder opens nothing
+}
+
+void RndsGameListView::launchSelected()
+{
+	FileData* cursor = getCursor();
+	if (cursor == nullptr || cursor->getType() != GAME)
+		return;
+	if (SaveStateRepository::isEnabled(cursor) &&
+		(cursor->getCurrentGameSetting("savestates") == "1" || (cursor->getCurrentGameSetting("savestates") == "2" && cursor->getSourceFileData()->getSystem()->getSaveStateRepository()->hasSaveStates(cursor))))
+	{
+		mWindow->pushGui(new GuiSaveState(mWindow, cursor, [this, cursor](SaveState* state)
+		{
+			Sound::getFromTheme(getTheme(), getName(), "launch")->play();
+			LaunchGameOptions options;
+			options.saveStateInfo = state;
+			ViewController::get()->launch(cursor, options);
+		}));
+		return;
+	}
+	Sound::getFromTheme(getTheme(), getName(), "launch")->play();
+	launch(cursor);
+}
+
+void RndsGameListView::goUp() { goBack(); }
+
+void RndsGameListView::launch(FileData* game)
+{
+	ViewController::get()->launch(game);
+}
+
+void RndsGameListView::remove(FileData* game)
+{
+	for (auto it = mEntries.begin(); it != mEntries.end(); ++it)
+		if (*it == game) { mEntries.erase(it); break; }
+	mRoot->removeFromVirtualFolders(game);
+	delete game;
+	if (mEntries.empty())
+		mEntries.push_back(createNoEntriesPlaceholder());
+	if (mCursor >= (int)mEntries.size())
+		mCursor = (int)mEntries.size() - 1;
+	if (auto host = rnds::EsHost::instance())
+		host->dataChanged();
+}
+
+bool RndsGameListView::input(InputConfig* config, Input input)
+{
+	if (rnds::EsHost::get(mWindow)->input(this, config, input))
+		return true;
+	return ISimpleGameListView::input(config, input);
+}
+
+void RndsGameListView::update(int deltaTime)
+{
+	GuiComponent::update(deltaTime);
+	rnds::EsHost::get(mWindow)->update(this, deltaTime);
+}
+
+void RndsGameListView::render(const Transform4x4f& parentTrans)
+{
+	Transform4x4f trans = parentTrans * getTransform();
+	rnds::EsHost::get(mWindow)->render(this, trans);
+}
+
+void RndsGameListView::onShow()
+{
+	ISimpleGameListView::onShow();
+	rnds::EsHost::get(mWindow)->showLibrary(this);
+}
+
+bool RndsGameListView::hitTest(int x, int y, Transform4x4f& parentTransform, std::vector<GuiComponent*>* pResult)
+{
+	// only the view: the engine takes every touch, the header components it doesn't draw must not
+	if (!isVisible())
+		return false;
+	Transform4x4f trans = getTransform() * parentTransform;
+	auto rect = Renderer::getScreenRect(trans, getSize(), true);
+	if (x == -1 || y == -1 || !rect.contains(x, y))
+		return false;
+	if (pResult)
+		pResult->push_back(this);
+	return true;
+}
+
+bool RndsGameListView::onMouseClick(int button, bool pressed, int x, int y)
+{
+	return rnds::EsHost::get(mWindow)->mouse(button, pressed, x, y);
+}
