+	void EsHost::showHome(SystemView* view)
+	{
+		d->systemView = view;
+		d->shown = view;
+		d->refreshSystems();
+		if (!d->ensureUI())
+			return;
+		if (d->busy)
+			return;
+		int idx = view->getCursorIndex();
+		// a ready screen opened from home (Resume) stays until its game starts (or B); back from the game it's home
+		if (d->ui->launchPending() && d->ui->systemIndex() == idx)
+			return;
+		d->ui->dataChanged();
+		d->ui->setHome(idx < 0 ? 0 : idx);
+	}
+
+	void EsHost::showLibrary(RndsGameListView* view)
+	{
+		if (view == nullptr)
+		{
+			// the list's cursor moved: follow it when ES moved it
+			if (d->busy || !d->ui || !d->list || d->shown != (GuiComponent*)d->list || d->ui->view() != UI::LIBRARY)
+				return;
+			if (d->ui->gameIndex() != d->list->getCursorIndex())
+				d->ui->setLibrary(d->ui->systemIndex(), d->list->getCursorIndex());
+			return;
+		}
+		d->list = view;
+		d->shown = view;
+		if (d->systems.empty())
+			d->refreshSystems();
+		if (!d->ensureUI() || d->busy)
+			return;
+		d->ui->dataChanged();
+		d->ui->setLibrary(d->sysIndex(view->system()), view->getCursorIndex());
+	}
+
+	bool EsHost::input(GuiComponent* from, InputConfig* config, Input input)
+	{
+		if (!d->ui || !d->isShown(from))
+			return false;
+		auto& h = d->held;
+		if (input.value == 0)
+		{
+			// the held direction let go (a key up, a hat or stick back to the centre)
+			if (h.on && input.device == h.device && input.type == h.type && input.id == h.id) h.on = false;
+			return false;
+		}
+		UI::View v = d->ui->view();
+		auto is = [&](const char* n) { return config->isMappedTo(n, input); };
+		bool left = config->isMappedLike("left", input), right = config->isMappedLike("right", input);
+		bool L = is("leftshoulder") || is("pageup"), R = is("rightshoulder") || is("pagedown");
+		bool A = config->isMappedTo(BUTTON_OK, input), B = config->isMappedTo(BUTTON_BACK, input);
+		bool X = is("x"), Y = is("y");
+		bool up = config->isMappedLike("up", input), down = config->isMappedLike("down", input);
+
+		if (left || right || L || R)
+		{
+			UI::Button b = left ? UI::LEFT : right ? UI::RIGHT : L ? UI::L : UI::R;
+			h.on = true; h.button = b; h.device = input.device; h.type = input.type; h.id = input.id;
+			h.since = h.last = d->lastUpdate = SDL_GetTicks();
+			return d->ui->press(b);
+		}
+		h.on = false;
+		if (up || down) { d->ui->press(up ? UI::UP : UI::DOWN); return true; }	// a page of a game list
+
+		RndsGameListView* lv = dynamic_cast<RndsGameListView*>(from);
+		// L3 on a game list: on to the first game of the next letter (round to the start after the last). es_input.cfg
+		// calls the stick's button "leftthumb"; ES only says "l3" for pads it set up from an SDL mapping (issue 27)
+		if ((is("leftthumb") || is("l3")) && v == UI::LIBRARY && lv)
+		{
+			auto& es = lv->entries();
+			int n = (int)es.size(), at = d->ui->gameIndex();
+			auto letter = [&](int i) {
+				std::string nm = Utils::String::toUpper(es[i]->getName());
+				char c = nm.empty() ? ' ' : nm[0];
+				return (c >= 'A' && c <= 'Z') ? c : '#';	// digits and symbols: one group
+			};
+			if (n > 1 && at >= 0 && at < n)
+			{
+				char from = letter(at);
+				for (int k = 1; k < n; k++)
+				{
+					int i = (at + k) % n;
+					if (letter(i) != from || i == 0) { d->ui->jumpTo(i); break; }
+				}
+			}
+			return true;
+		}
+		if (A)
+		{
+			if (v == UI::LIBRARY && lv)
+			{
+				d->busy = true;
+				bool folder = lv->openSelected();
+				d->busy = false;
+				if (folder)
+				{
+					d->ui->dataChanged();
+					d->ui->setLibrary(d->ui->systemIndex(), lv->getCursorIndex());
+					return true;
+				}
+			}
+			return d->ui->press(UI::A);
+		}
+		if (B)
+		{
+			if (v == UI::LIBRARY && lv && lv->inFolder())
+			{
+				d->busy = true;
+				lv->goUp();
+				d->busy = false;
+				d->ui->dataChanged();
+				d->ui->setLibrary(d->ui->systemIndex(), lv->getCursorIndex());
+				return true;
+			}
+			if (v == UI::HOME)
+				return true;	// nothing to go back to (the mockup's B does nothing on home)
+			return d->ui->press(UI::B);
+		}
+		if (X)
+		{
+			if (v == UI::LIBRARY && lv)
+			{
+				// ES's X on a game: its options (or save states)
+				if (Settings::getInstance()->getBool("GameOptionsAtNorth")) lv->showOptions();
+				else lv->showSaves();
+				return true;
+			}
+			return d->ui->press(UI::X) || true;
+		}
+		if (Y)
+			return d->ui->press(UI::Y) || true;
+		if (is("select"))
+		{
+			if (v == UI::LIBRARY && lv) { lv->showListOptions(); return true; }
+			if (v == UI::HOME) { GuiMenu::openQuitMenu_static(d->window, true); return true; }
+			return true;
+		}
+		return false;
+	}
+
+	bool EsHost::mouse(int button, bool down, int x, int y)
+	{
+		if (!d->ui || button != 1)
+			return false;
+		float panelW = d->backend.dual ? Renderer::getScreenWidth() / 3.0f : (float)Renderer::getScreenWidth();
+		float bx = x - d->backend.originX[1];
+		if (bx < 0 || bx >= panelW)
+		{
+			if (!down) d->ui->touch(1, -1, -1, false);
+			return true;
+		}
+		d->ui->touch(1, bx, (float)y, down);
+		return true;
+	}
+
+	void EsHost::update(GuiComponent* from, int deltaTime)
+	{
+		if (!d->ui || !d->isShown(from))
+			return;
+		if (d->pendingRefresh.exchange(false))
+			d->ui->dataChanged();
+		Uint32 now = SDL_GetTicks();
+		auto& h = d->held;
+		if (h.on && now - d->lastUpdate > 250) h.on = false;
+		d->lastUpdate = now;
+		if (h.on && d->ui->view() != UI::LAUNCH && now - h.since >= 350)
+		{
+			Uint32 every = now - h.since < 1500 ? 110 : 55;		// ramps up after 1.5 s held
+			if (now - h.last >= every) { h.last = now; d->ui->press(h.button); }
+		}
+		d->ui->update((double)now);
+		bool anim = d->ui->animating() || h.on;	// keep frames coming while a direction is held
+		if (anim && !d->psPaused) { PowerSaver::pause(); d->psPaused = true; }
+		else if (!anim && d->psPaused) { PowerSaver::resume(); d->psPaused = false; }
+	}
+
+	void EsHost::render(GuiComponent* from, const Transform4x4f& trans)
+	{
+		if (!d->ui || !d->isShown(from))
+			return;
+		d->backend.base = trans;
+		d->ui->render();
+	}
+
+	void EsHost::dataChanged()
+	{
+		d->resumeCache.clear();
+		if (d->ui)
+			d->ui->dataChanged();
+	}
+
+	int EsHost::nextWake()
+	{
+		if (!d->ui || d->shown == nullptr)
+			return -1;
+		if (d->window->peekGui() != ViewController::get())
+			return -1;	// a menu is open: the shelf stays still
+		return d->ui->nextWake();
+	}
+
+	bool EsHost::settled() { return !d->ui || d->shown == nullptr || d->ui->settled(); }
+
+	int nextWake() { return sHost ? sHost->nextWake() : -1; }
+	bool settled() { return sHost ? sHost->settled() : true; }
+}
