+		{
+			auto w = WatchersManager::GetComponent<NetworkStateWatcher>();
+			return w == nullptr || w->isConnected();
+		}
+
+		std::set<std::string> favSystems()
+		{
+			std::set<std::string> r;
+			for (auto& n : Utils::String::split(Settings::getInstance()->getString("RndsFavoriteSystems"), ','))
+				if (!n.empty()) r.insert(n);
+			return r;
+		}
+
+		void playSound(const std::string& name)
+		{
+			SystemData* s = systems.size() ? systems[0] : nullptr;
+			if (s && s->getTheme())
+				Sound::getFromTheme(s->getTheme(), "rnds", name)->play();
+		}
+
+		void cue(const std::string& name) override { playSound(name); }
+
+		void selectSystem(int i) override
+		{
+			playSound("scroll");
+			if (!systemView || i < 0 || i >= (int)systems.size())
+				return;
+			busy = true;
+			systemView->goToSystem(systems[i], false);
+			busy = false;
+		}
+
+		void selectGame(int i) override
+		{
+			playSound("scroll");
+			if (!list)
+				return;
+			busy = true;
+			list->setCursorIndex(i);
+			busy = false;
+		}
+
+		int openLibrary(int sys) override
+		{
+			if (sys < 0 || sys >= (int)systems.size())
+				return 0;
+			playSound("select");
+			busy = true;
+			ViewController::get()->goToGameList(systems[sys], true);
+			auto cur = dynamic_cast<RndsGameListView*>(ViewController::get()->getGameListView(systems[sys], false).get());
+			if (cur)
+				list = cur;
+			int idx = list ? list->resumeIndex() : 0;
+			if (list)
+				list->setCursorIndex(idx);
+			busy = false;
+			return idx;
+		}
+
+		void backToHome() override
+		{
+			playSound("back");
+			busy = true;
+			if (list)
+				list->goUp();
+			else if (systemView)
+				ViewController::get()->goToSystemView(systems.size() ? systems[0] : nullptr, true);
+			busy = false;
+		}
+
+		void launch(int game) override
+		{
+			if (!list || game < 0 || game >= (int)list->entries().size())
+				return;
+			busy = true;
+			list->setCursorIndex(game);
+			FileData* f = list->entries()[game];
+			int id = atoi(f->getMetadata(MetaDataId::CheevosId).c_str());
+			if (id > 0 && ra)
+				ra->forget(id);
+			list->launchSelected();
+			busy = false;
+		}
+
+		void toggleSystemFav(int sys) override
+		{
+			if (sys < 0 || sys >= (int)systems.size())
+				return;
+			auto favs = favSystems();
+			std::string n = systems[sys]->getName();
+			if (favs.count(n)) favs.erase(n); else favs.insert(n);
+			std::string v;
+			for (auto& f : favs) v += (v.empty() ? "" : ",") + f;
+			Settings::getInstance()->setString("RndsFavoriteSystems", v);
+			Settings::getInstance()->saveFile();
+		}
+
+		void toggleGameFav(int game) override
+		{
+			if (!list || game < 0 || game >= (int)list->entries().size())
+				return;
+			FileData* f = list->entries()[game];
+			if (f->getType() != GAME)
+				return;
+			busy = true;
+			CollectionSystemManager::get()->toggleGameInCollection(f, "Favorites");
+			busy = false;
+			if (ui)
+				ui->dataChanged();
+		}
+
+		int resumeGame(int sys) override
+		{
+			if (sys < 0 || sys >= (int)systems.size())
+				return -1;
+			auto view = dynamic_cast<RndsGameListView*>(ViewController::get()->getGameListView(systems[sys]).get());
+			if (!view)
+				return -1;
+			list = view;
+			int idx = view->resumeIndex();
+			if (idx < 0 || idx >= (int)view->entries().size() || view->entries()[idx]->getType() != GAME)
+				return -1;
+			busy = true;
+			view->setCursorIndex(idx);
+			busy = false;
+			return idx;			// the ready screen's jingle follows
+		}
+
+		// ---- ES side ----
+		bool isShown(GuiComponent* from) { return from != nullptr && from == shown; }
+	};
