+void CarouselItemTemplate::renderWithoutActivated(const Transform4x4f& parentTrans)
+{
+	std::vector<GuiComponent*> hidden;
+	for (auto child : enumerateExtraChildrens())
+	{
+		if (child->isVisible() && child->storyBoardExists("activate"))
+		{
+			child->setVisible(false);
+			hidden.push_back(child);
+		}
+	}
+
+	render(parentTrans);
+
+	for (auto child : hidden)
+		child->setVisible(true);
+}
