+// ROCKNIXDS: DATE & TIME. ROCKNIX sets the clock only over Wi-Fi (NTP): without Wi-Fi a handheld kept a wrong date and
+// time with no way to change it. Here the date and time are set by hand (the system clock, then the RTC, which holds
+// UTC); Wi-Fi's time still replaces them once it connects, and the screen says so. The time zone and the 12-hour switch moved here from SYSTEM
+// SETTINGS.
+static void rgdsDateTime(Window* window)
+{
+	auto s = new GuiSettings(window, _("DATE & TIME").c_str());
+	time_t now = time(nullptr);
+	struct tm t;
+	localtime_r(&now, &t);
+
+	auto numbers = [window](const std::string& title, int from, int to, int selected, bool twoDigits)
+	{
+		auto list = std::make_shared<OptionListComponent<std::string>>(window, title, false);
+		if (selected < from || selected > to) selected = from;
+		for (int i = from; i <= to; i++)
+		{
+			char b[8];
+			snprintf(b, sizeof b, twoDigits ? "%02d" : "%d", i);
+			list->add(b, std::to_string(i), i == selected);
+		}
+		return list;
+	};
+	int thisYear = t.tm_year + 1900;
+	auto year = numbers(_("YEAR"), 2025, 2045, thisYear < 2025 ? 2026 : thisYear, false);
+	auto month = numbers(_("MONTH"), 1, 12, t.tm_mon + 1, true);
+	auto day = numbers(_("DAY"), 1, 31, t.tm_mday, true);
+	auto hour = numbers(_("HOUR"), 0, 23, t.tm_hour, true);
+	auto minute = numbers(_("MINUTE"), 0, 59, t.tm_min, true);
+
+	s->addGroup(_("DATE"));
+	s->addWithLabel(_("YEAR"), year);
+	s->addWithLabel(_("MONTH"), month);
+	s->addWithLabel(_("DAY"), day);
+	s->addGroup(_("TIME"));
+	s->addWithLabel(_("HOUR"), hour);
+	s->addWithLabel(_("MINUTE"), minute);
+	s->addSaveFunc([window, year, month, day, hour, minute]
+	{
+		if (!year->changed() && !month->changed() && !day->changed() && !hour->changed() && !minute->changed())
+			return;
+		struct tm n = {};
+		n.tm_year = std::stoi(year->getSelected()) - 1900;
+		n.tm_mon = std::stoi(month->getSelected()) - 1;
+		n.tm_mday = 1;
+		n.tm_hour = std::stoi(hour->getSelected());
+		n.tm_min = std::stoi(minute->getSelected());
+		n.tm_isdst = -1;
+		// the 31st of a shorter month is its last day, not the next month's first
+		struct tm last = n;
+		last.tm_mon++; last.tm_mday = 0;
+		mktime(&last);
+		n.tm_mday = std::min(std::stoi(day->getSelected()), last.tm_mday);
+		struct timespec ts = { mktime(&n), 0 };
+		if (ts.tv_sec == (time_t)-1 || clock_settime(CLOCK_REALTIME, &ts) != 0)
+			return;
+		Utils::Platform::runSystemCommand("hwclock -w -u", "", nullptr);
+		// with Wi-Fi connected, systemd-timesyncd puts the network's time back within a second
+		if (Utils::String::trim(Utils::Platform::GetShOutput("timedatectl show -p NTPSynchronized --value 2>/dev/null")) == "yes")
+			window->pushGui(new GuiMsgBox(window, _("WI-FI SETS THE DATE AND TIME BY ITSELF WHILE IT IS CONNECTED.") + "\n\n" +
+				_("TO SET THEM BY HAND, TURN WI-FI OFF FIRST. IF THE TIME IS OFF BY WHOLE HOURS, CHANGE THE TIME ZONE INSTEAD."), _("OK"), nullptr));
+	});
+
+	s->addGroup(_("TIME ZONE"));
+	// timeinfo lists one zone a line, each ending in a comma: split on both, or every zone but the first starts with a
+	// newline and none matches the current one
+	auto tzChoices = std::make_shared<OptionListComponent<std::string>>(window, _("SELECT YOUR TIME ZONE"), false);
+	std::string currentTZ = SystemConf::getInstance()->get("system.timezone");
+	if (currentTZ.empty())
+		currentTZ = Utils::String::trim(Utils::Platform::GetShOutput(R"(/usr/bin/timeinfo current_timezone)"));
+	std::string all = Utils::Platform::GetShOutput(R"(/usr/bin/timeinfo timezones)");
+	std::replace(all.begin(), all.end(), '\n', ',');
+	bool found = false;
+	for (auto tz : Utils::String::split(all, ',', true))
+	{
+		tz = Utils::String::trim(tz);
+		if (tz.empty()) continue;
+		found |= tz == currentTZ;
+		tzChoices->add(tz, tz, tz == currentTZ);
+	}
+	if (!found && !currentTZ.empty())
+		tzChoices->add(currentTZ, currentTZ, true);
+	s->addWithLabel(_("TIMEZONE"), tzChoices);
+	s->addSaveFunc([tzChoices]
+	{
+		if (!tzChoices->changed())
+			return;
+		std::string tz = tzChoices->getSelected();
+		if (tz.empty() || tz.find_first_of("'\"$`;& \\") != std::string::npos || !Utils::FileSystem::exists("/usr/share/zoneinfo/" + tz))
+			return;
+		Utils::Platform::runSystemCommand("ln -sf /usr/share/zoneinfo/" + tz + " $(readlink /etc/localtime)", "", nullptr);
+		SystemConf::getInstance()->set("system.timezone", tz);
+	});
+
+	s->addGroup(_("CLOCK"));
+	s->addSwitch(_("SHOW CLOCK IN 12-HOUR FORMAT"), "ClockMode12", true);
+	window->pushGui(s);
+}
+
 void GuiMenu::openSystemSettings() 
 {
 	Window *window = mWindow;
