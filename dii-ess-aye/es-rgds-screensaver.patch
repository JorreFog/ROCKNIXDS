+// ROCKNIXDS: the dual-screen themes run ES on a canvas three panels wide (ES_UI_WIDTH each, es-rgds-uiwidth.patch). The
+// screensaver is sized against one panel, the top one (the canvas' left third): fitted to the whole canvas, a slide
+// that isn't 4:3 or a long game name ran over onto the bottom screen, and the clock sat in the canvas' top-left corner
+// while the slide was centred on the bottom panel. On a one-panel layout this is the whole screen, as stock.
+static Renderer::Rect screenSaverPanel()
+{
+	int w = Renderer::getUIWidth();
+	if (w > 0 && w < Renderer::getScreenWidth())
+		return Renderer::Rect(0, 0, w, Renderer::getScreenHeight());
+
+	return Renderer::Rect(0, 0, Renderer::getScreenWidth(), Renderer::getScreenHeight());
+}
