+// ROCKNIXDS: the area a one-line label's text takes, as the screensaver lays its labels out (left-aligned or centred,
+// vertically centred)
+static void labelTextBox(TextComponent* label, bool centred, float& x, float& y, float& w, float& h)
+{
+	w = h = 0;
+	if (label == nullptr || label->getFont() == nullptr || label->getText().empty())
+		return;
 
-	if (mLabelTime)
+	Vector2f sz = label->getFont()->sizeText(label->getText(), 1.0f);
+	w = Math::min(sz.x(), label->getSize().x());
+	h = sz.y();
+	x = label->getPosition().x() + (centred ? (label->getSize().x() - w) / 2.0f : 0.0f);
+	y = label->getPosition().y() + (label->getSize().y() - h) / 2.0f;
+}
+
+// ROCKNIXDS: a soft backdrop behind a group of labels (TEXT BACKDROP, ScreenSaverTextBackdrop, on by default), so the
+// clock and the game's name stay readable over a light slide: one rounded half-transparent box around the lines' text,
+// as transparent as the labels it backs.
+void GameScreenSaverBase::renderTextBackdrop(const Transform4x4f& transform, TextComponent* first, TextComponent* second, bool centred, unsigned char opacity)
+{
+	if (opacity == 0 || !Settings::getInstance()->getBool("ScreenSaverTextBackdrop"))
+		return;
+
+	float x0 = 0, y0 = 0, x1 = 0, y1 = 0, line = 0;
+	bool any = false;
+	for (TextComponent* label : { first, second })
 	{
-		mLabelTime->setOpacity(255);
-		mLabelTime->render(transform);
+		float x, y, w, h;
+		labelTextBox(label, centred, x, y, w, h);
+		if (w <= 0 || h <= 0)
+			continue;
+
+		x0 = any ? Math::min(x0, x) : x;
+		y0 = any ? Math::min(y0, y) : y;
+		x1 = any ? Math::max(x1, x + w) : x + w;
+		y1 = any ? Math::max(y1, y + h) : y + h;
+		line = Math::max(line, h);
+		any = true;
 	}
+
+	if (!any)
+		return;
+
+	float pad = line * 0.4f;
+	unsigned int alpha = 0xA0 * opacity / 255;
+	Renderer::setMatrix(transform);
+	Renderer::drawRoundRect(x0 - pad, y0 - pad, x1 - x0 + pad * 2, y1 - y0 + pad * 2, pad, alpha);
+}
+
+void GameScreenSaverBase::renderDateTime(const Transform4x4f& transform)
+{
+	if (mLabelDate == nullptr || mLabelTime == nullptr)
+		return;
+
+	renderTextBackdrop(transform, mLabelDate, mLabelTime, false, 255);
+
+	mLabelDate->setOpacity(255);
+	mLabelDate->render(transform);
+
+	mLabelTime->setOpacity(255);
+	mLabelTime->render(transform);
 }
 
