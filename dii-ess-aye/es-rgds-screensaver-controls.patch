+// ROCKNIXDS: the bottom panel's touch controls. The dual-screen themes put the screensaver on the top panel
+// (es-rgds-screensaver.patch) and leave the bottom one black, its backlight off (dii-ess-aye/device/screensaver-panel.sh).
+// A tap there shows the controls for CONTROLS_MS, lighting the backlight through the screensaver-controls event: the
+// status (Wi-Fi, battery), the slide's game (next slide, play it) and the music (next song, stop or play). Each tap
+// keeps them up; a tap on the top panel or any button closes the screensaver as before. One-panel layouts have no
+// bottom panel and no controls.
+#define CONTROLS_MS (10000)
+
+static Renderer::Rect controlsPanel()		// the bottom panel: the canvas' middle third
+{
+	int w = Renderer::getUIWidth();
+	if (w > 0 && w < Renderer::getScreenWidth())
+		return Renderer::Rect(Renderer::getUILeft(), 0, w, Renderer::getScreenHeight());
+
+	return Renderer::Rect(0, 0, 0, 0);
+}
+
+void SystemScreenSaver::showControls(bool show)
+{
+	if (show)
+	{
+		if (!controlsShown())
+			Scripting::fireEvent("screensaver-controls", "show");
+		mControlsUntil = SDL_GetTicks() + CONTROLS_MS;
+	}
+	else if (controlsShown())
+	{
+		mControlsUntil = 0;
+		mCtrlButtons.clear();
+		Scripting::fireEvent("screensaver-controls", "hide");
+	}
+}
+
+bool SystemScreenSaver::onMouseClick(int button, bool down, int x, int y)
+{
+	Renderer::Rect p = controlsPanel();
+	if (p.w <= 0 || x < p.x || x >= p.x + p.w || y < p.y || y >= p.y + p.h)
+		return false;	// not the bottom panel: the tap closes the screensaver
+
+	if (!down)
+		return true;	// the press acts; its release is swallowed
+
+	if (!controlsShown())
+	{
+		showControls(true);
+		return true;
+	}
+
+	mControlsUntil = SDL_GetTicks() + CONTROLS_MS;
+	for (auto& b : mCtrlButtons)
+	{
+		if (x < b.x || x >= b.x + b.w || y < b.y || y >= b.y + b.h)
+			continue;
+
+		switch (b.action)
+		{
+		case CtrlAction::NextSlide:
+			nextVideo();
+			break;
+		case CtrlAction::PlayGame:
+			if (getCurrentGame() != nullptr)
+			{
+				mControlsUntil = 0;
+				mCtrlButtons.clear();
+				mWindow->cancelScreenSaver();
+				launchGame();
+			}
+			break;
+		case CtrlAction::NextSong:
+		case CtrlAction::PlayMusic:
+			AudioManager::getInstance()->playRandomMusic(false);
+			break;
+		case CtrlAction::StopMusic:
+			AudioManager::getInstance()->stopMusic(false);
+			break;
+		}
+		break;
+	}
+	return true;
+}
+
+// ROCKNIXDS: a theme's own status icon for the controls, when it has no rnds icons: the <batteryIcon> or <networkIcon>
+// in its system view, at any depth (TechDweeb's sit in a stackpanel); empty when it has none
+static const ThemeData::ThemeElement* findThemeElementOfType(const ThemeData::ThemeElement& e, const std::string& type)
+{
+	if (e.type == type)
+		return &e;
+	for (auto& child : e.children)
+		if (auto found = findThemeElementOfType(child.second, type))
+			return found;
+	return nullptr;
+}
+
+static std::string themeStatusIcon(SystemData* sys, const std::string& type, const std::string& property)
+{
+	auto theme = sys ? sys->getTheme() : nullptr;
+	auto view = theme ? theme->getView("system") : nullptr;
+	if (view == nullptr)
+		return "";
+	for (auto& elem : view->elements)
+		if (auto found = findThemeElementOfType(elem.second, type))
+			if (found->has(property))
+				return found->get<std::string>(property);
+	return "";
+}
+
+void SystemScreenSaver::renderControls()
+{
+	Renderer::Rect p = controlsPanel();
+	if (p.w <= 0 || !controlsShown())
+		return;
+
+	auto theme = ThemeData::getMenuTheme();
+	const std::string fontPath = theme->Text.font ? theme->Text.font->getPath() : "";
+	float u = p.h / 480.0f;		// design units: the RG DS's 480 px panel
+	float pad = 24 * u, x0 = p.x + pad, w = p.w - pad * 2;
+	auto big = Font::get((int)std::round(26 * u), fontPath), small = Font::get((int)std::round(17 * u), fontPath);
+	unsigned int ink = theme->Text.color, muted = theme->TextSmall.color, bg = theme->Background.color;
+	unsigned int btnBg = theme->Text.selectorColor, btnInk = theme->Text.selectedColor;
+
+	Renderer::setMatrix(Transform4x4f::Identity());
+	Renderer::drawRect((float)p.x, (float)p.y, (float)p.w, (float)p.h, 0x000000FF, 0x000000FF);
+	Renderer::drawRoundRect(p.x + pad / 2, p.y + pad / 2, p.w - pad, p.h - pad, 18 * u, bg);
+
+	auto fit = [](const std::shared_ptr<Font>& f, std::string s, float maxW)
+	{
+		if (f->sizeText(s, 1.0f).x() <= maxW) return s;
+		while (!s.empty() && f->sizeText(s + "...", 1.0f).x() > maxW)
+		{
+			s.pop_back();		// a whole UTF-8 character: its continuation bytes, then its lead byte
+			while (!s.empty() && (s.back() & 0xC0) == 0x80) s.pop_back();
+			if (!s.empty() && (s.back() & 0x80)) s.pop_back();
+		}
+		return s + "...";
+	};
+	auto text = [&](const std::shared_ptr<Font>& f, const std::string& s, float x, float y, float tw, unsigned int col, Alignment a)
+	{
+		TextCache* tc = f->buildTextCache(fit(f, s, tw), Vector2f(x, y), col, tw, a, 1.0f);
+		f->renderTextCache(tc);
+		delete tc;
+	};
+	mCtrlButtons.clear();
+	auto button = [&](float x, float y, float bw, const std::string& label, CtrlAction a)
+	{
+		float bh = 56 * u;
+		Renderer::drawRoundRect(x, y, bw, bh, 10 * u, btnBg);
+		text(big, label, x, y + (bh - big->getHeight(1.0f)) / 2, bw, btnInk, ALIGN_CENTER);
+		mCtrlButtons.push_back({ x, y, bw, bh, a });
+	};
+
+	// the status: the theme's own Wi-Fi and battery icons, as its status bar draws them (rnds/wifi@*.png and
+	// battery@*.png, the 1.6x pair on the RG DS Plus), in the status bar's colours when COLOURED STATUS ICONS is on
+	// (es-rgds-battery-charging.patch: green connected or charging, amber on but not connected, red low); words when
+	// the theme has no rnds folder
+	bool colours = Settings::getInstance()->getBool("RndsStatusColors");
+	std::string dir;
+	SystemData* sys = ViewController::get()->getState().getSystem();
+	if (sys == nullptr && !SystemData::sSystemVector.empty()) sys = SystemData::sSystemVector.front();
+	{
+		auto elem = sys && sys->getTheme() ? sys->getTheme()->getElement("rnds", "assets", "image") : nullptr;
+		if (elem != nullptr && elem->has("path"))
+			dir = Utils::FileSystem::getParent(elem->get<std::string>("path"));
+	}
+	std::string sfx = u > 1.3f ? "@1.6x.png" : "@1x.png";
+	auto icon = [&](const std::string& name, float x, float y, float cssW, float cssH, unsigned int col)
+	{
+		std::string path = dir.empty() ? "" : dir + "/" + name + sfx;
+		if (path.empty() || !Utils::FileSystem::exists(path)) return false;
+		ImageComponent ic(mWindow, true);
+		ic.setImage(path);
+		ic.setPosition(std::round(x), std::round(y));
+		ic.setResize(std::round(cssW * u), std::round(cssH * u));
+		ic.setColorShift(col);
+		ic.render(Transform4x4f::Identity());
+		Renderer::setMatrix(Transform4x4f::Identity());
+		return true;
+	};
+	// a theme without rnds icons: its own status icon (themeStatusIcon), else ES's built-in one, kept to its shape
+	// inside the same box and tinted like the rest of the status
+	auto plainIcon = [&](const std::string& themed, const std::string& builtin, float x, float y, float boxW, float boxH, unsigned int col)
+	{
+		std::string path = !themed.empty() && Utils::FileSystem::exists(themed) ? themed :
+			ResourceManager::getInstance()->fileExists(builtin) ? ResourceManager::getInstance()->getResourcePath(builtin) : "";
+		if (path.empty()) return false;
+		ImageComponent ic(mWindow, true);
+		ic.setImage(path);
+		ic.setOrigin(0.0f, 0.5f);
+		ic.setPosition(std::round(x), std::round(y + boxH * u / 2));
+		ic.setMaxSize(std::round(boxW * u), std::round(boxH * u));
+		ic.setColorShift(col);
+		ic.render(Transform4x4f::Identity());
+		Renderer::setMatrix(Transform4x4f::Identity());
+		return true;
+	};
+	auto cell = [&](float ox, float oy, int c, int r, unsigned int col)	// one CSS pixel of a pixel-art glyph
+	{
+		float l = std::round(ox + c * u), t = std::round(oy + r * u);
+		Renderer::drawRect(l, t, std::round(ox + (c + 1) * u) - l, std::round(oy + (r + 1) * u) - t, col, col);
+	};
+
+	auto net = WatchersManager::GetComponent<NetworkStateWatcher>();
+	bool online = net == nullptr || net->isConnected(), wifiOn = SystemConf::getInstance()->getBool("wifi.enabled");
+	unsigned int wifiCol = !colours ? ink : online ? 0x5FD068FF : wifiOn ? 0xF2B33DFF : ink;
+	if (!online && !(colours && wifiOn)) wifiCol = (wifiCol & 0xFFFFFF00) | 0x59;	// switched off: dimmed, as in the status bar
+	float y = p.y + 34 * u;
+	if (!icon("wifi", x0, y, 18, 16, wifiCol) &&
+		!plainIcon(themeStatusIcon(sys, "networkIcon", online || wifiOn ? "networkIcon" : "planemodeIcon"), ":/network.svg", x0, y, 24, 20, wifiCol))
+		text(small, online ? _("Wi-Fi connected") : wifiOn ? _("Wi-Fi not connected") : _("Wi-Fi off"), x0, y, w / 2, wifiCol, ALIGN_LEFT);
+
+	auto batt = WatchersManager::GetComponent<BatteryLevelWatcher>();
+	if (batt != nullptr && batt->getBatteryInfo().hasBattery)
+	{
+		auto bi = batt->getBatteryInfo();
+		float lvl = std::max(0, std::min(100, bi.level)) / 100.0f;
+		unsigned int fill = !colours ? ink : bi.isCharging ? 0x5FD068FF : bi.level <= 15 ? 0xFF3B4AFF : ink;
+		float bx = x0 + w - 26 * u, by = y + 1 * u;
+		std::string pct = std::to_string(bi.level) + "%";
+		if (icon("battery", bx, by, 26, 14, ink))
+		{
+			float fw = std::round(16 * lvl);
+			if (fw > 0)
+				Renderer::drawRect(std::round(bx + 3 * u), std::round(by + 3 * u), std::round(fw * u), std::round(8 * u), fill, fill);
+			if (bi.isCharging)		// the bolt across the battery, outlined in the panel's background
+			{
+				static const char* bolt[11] = { ".....###", "....###.", "...###..", "..###...", ".#######", "#######.",
+												"...###..", "..###...", ".###....", ".##.....", "##......" };
+				float ox = bx + 7 * u, oy = by + 1 * u;
+				for (int pass = 0; pass < 2; pass++)
+					for (int r = 0; r < 11; r++)
+						for (int c = 0; c < 8; c++)
+							if (bolt[r][c] == '#')
+							{
+								if (pass == 0)
+									for (int dr = -1; dr <= 1; dr++) for (int dc = -1; dc <= 1; dc++) cell(ox, oy, c + dc, r + dr, bg);
+								else
+									cell(ox, oy, c, r, ink);
+							}
+			}
+			text(small, pct, x0 + w / 2, y, w / 2 - 26 * u - 8 * u, ink, ALIGN_RIGHT);
+		}
+		else
+		{
+			// the theme's battery icon for this level (the levels its <batteryIcon> has), else ES's own
+			int l = bi.level;
+			std::string level = bi.isCharging ? "incharge" : l > 75 ? "full" : l > 50 ? "at75" : l > 25 ? "at50" : l > 5 ? "at25" : "empty";
+			std::string builtin = bi.isCharging ? "incharge" : l > 75 ? "full" : l > 50 ? "75" : l > 25 ? "50" : l > 5 ? "25" : "empty";
+			if (plainIcon(themeStatusIcon(sys, "batteryIcon", level), ":/battery/" + builtin + ".svg", x0 + w - 40 * u, y, 40, 20, fill))
+				text(small, pct, x0 + w / 2, y, w / 2 - 40 * u - 8 * u, ink, ALIGN_RIGHT);
+			else
+				text(small, pct + (bi.isCharging ? " " + _("charging") : ""), x0 + w / 2, y, w / 2, fill, ALIGN_RIGHT);
+		}
+	}
+
+	// the slide's game
+	FileData* game = getCurrentGame();
+	y = p.y + 86 * u;
+	text(small, _("NOW SHOWING"), x0, y, w, muted, ALIGN_LEFT);
+	text(big, game ? game->getName() : _("No game"), x0, y + 24 * u, w, ink, ALIGN_LEFT);
+	float bw = (w - pad) / 2;
+	button(x0, y + 66 * u, bw, _("NEXT SLIDE"), CtrlAction::NextSlide);
+	if (game)
+		button(x0 + bw + pad, y + 66 * u, bw, _("PLAY THIS GAME"), CtrlAction::PlayGame);
+
+	// the music
+	y = p.y + 252 * u;
+	text(small, _("MUSIC"), x0, y, w, muted, ALIGN_LEFT);
+	if (!Settings::BackgroundMusic())
+		text(big, _("Music is off"), x0, y + 24 * u, w, ink, ALIGN_LEFT);
+	else
+	{
+		bool playing = AudioManager::getInstance()->isSongPlaying();
+		text(big, playing ? AudioManager::getInstance()->getSongName() : _("No music playing"), x0, y + 24 * u, w, ink, ALIGN_LEFT);
+		button(x0, y + 66 * u, bw, _("NEXT SONG"), CtrlAction::NextSong);
+		button(x0 + bw + pad, y + 66 * u, bw, playing ? _("STOP MUSIC") : _("PLAY MUSIC"), playing ? CtrlAction::StopMusic : CtrlAction::PlayMusic);
+	}
+
+	text(small, _("Tap the top screen or press a button to close"), x0, p.y + p.h - pad - 30 * u, w, muted, ALIGN_CENTER);
+}
+
 
