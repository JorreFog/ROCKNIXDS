+// ROCKNIXDS: the bottom panel's touch controls. The dual-screen themes put the screensaver on the top panel
+// (es-rgds-screensaver.patch) and leave the bottom one black, its backlight off (dii-ess-aye/device/screensaver-panel.sh).
+// A tap there shows the controls for CONTROLS_MS, lighting the backlight through the screensaver-controls event: the
+// status (Wi-Fi, battery), the slide's game (next slide, play it) and the music (next song, stop or play). Each tap
+// keeps them up; a tap on the top panel or any button closes the screensaver as before. One-panel layouts have no
+// bottom panel and no controls.
+#define CONTROLS_MS (10000)
+
+static Renderer::Rect controlsPanel()		// the bottom panel: the canvas' middle third
+{
+	int w = Renderer::getUIWidth();
+	if (w > 0 && w < Renderer::getScreenWidth())
+		return Renderer::Rect(Renderer::getUILeft(), 0, w, Renderer::getScreenHeight());
+
+	return Renderer::Rect(0, 0, 0, 0);
+}
+
+void SystemScreenSaver::showControls(bool show)
+{
+	if (show)
+	{
+		if (!controlsShown())
+			Scripting::fireEvent("screensaver-controls", "show");
+		mControlsUntil = SDL_GetTicks() + CONTROLS_MS;
+	}
+	else if (controlsShown())
+	{
+		mControlsUntil = 0;
+		mCtrlButtons.clear();
+		Scripting::fireEvent("screensaver-controls", "hide");
+	}
+}
+
+bool SystemScreenSaver::onMouseClick(int button, bool down, int x, int y)
+{
+	Renderer::Rect p = controlsPanel();
+	if (p.w <= 0 || x < p.x || x >= p.x + p.w || y < p.y || y >= p.y + p.h)
+		return false;	// not the bottom panel: the tap closes the screensaver
+
+	if (!down)
+		return true;	// the press acts; its release is swallowed
+
+	if (!controlsShown())
+	{
+		showControls(true);
+		return true;
+	}
+
+	mControlsUntil = SDL_GetTicks() + CONTROLS_MS;
+	for (auto& b : mCtrlButtons)
+	{
+		if (x < b.x || x >= b.x + b.w || y < b.y || y >= b.y + b.h)
+			continue;
+
+		switch (b.action)
+		{
+		case CtrlAction::NextSlide:
+			nextVideo();
+			break;
+		case CtrlAction::PlayGame:
+			if (getCurrentGame() != nullptr)
+			{
+				mControlsUntil = 0;
+				mCtrlButtons.clear();
+				mWindow->cancelScreenSaver();
+				launchGame();
+			}
+			break;
+		case CtrlAction::NextSong:
+		case CtrlAction::PlayMusic:
+			AudioManager::getInstance()->playRandomMusic(false);
+			break;
+		case CtrlAction::StopMusic:
+			AudioManager::getInstance()->stopMusic(false);
+			break;
+		}
+		break;
+	}
+	return true;
+}
+
+void SystemScreenSaver::renderControls()
+{
+	Renderer::Rect p = controlsPanel();
+	if (p.w <= 0 || !controlsShown())
+		return;
+
+	auto theme = ThemeData::getMenuTheme();
+	const std::string fontPath = theme->Text.font ? theme->Text.font->getPath() : "";
+	float u = p.h / 480.0f;		// design units: the RG DS's 480 px panel
+	float pad = 24 * u, x0 = p.x + pad, w = p.w - pad * 2;
+	auto big = Font::get((int)std::round(26 * u), fontPath), small = Font::get((int)std::round(17 * u), fontPath);
+	unsigned int ink = theme->Text.color, muted = theme->TextSmall.color, bg = theme->Background.color;
+	unsigned int btnBg = theme->Text.selectorColor, btnInk = theme->Text.selectedColor;
+
+	Renderer::setMatrix(Transform4x4f::Identity());
+	Renderer::drawRect((float)p.x, (float)p.y, (float)p.w, (float)p.h, 0x000000FF, 0x000000FF);
+	Renderer::drawRoundRect(p.x + pad / 2, p.y + pad / 2, p.w - pad, p.h - pad, 18 * u, bg);
+
+	auto fit = [](const std::shared_ptr<Font>& f, std::string s, float maxW)
+	{
+		if (f->sizeText(s, 1.0f).x() <= maxW) return s;
+		while (!s.empty() && f->sizeText(s + "...", 1.0f).x() > maxW)
+		{
+			s.pop_back();		// a whole UTF-8 character: its continuation bytes, then its lead byte
+			while (!s.empty() && (s.back() & 0xC0) == 0x80) s.pop_back();
+			if (!s.empty() && (s.back() & 0x80)) s.pop_back();
+		}
+		return s + "...";
+	};
+	auto text = [&](const std::shared_ptr<Font>& f, const std::string& s, float x, float y, float tw, unsigned int col, Alignment a)
+	{
+		TextCache* tc = f->buildTextCache(fit(f, s, tw), Vector2f(x, y), col, tw, a, 1.0f);
+		f->renderTextCache(tc);
+		delete tc;
+	};
+	mCtrlButtons.clear();
+	auto button = [&](float x, float y, float bw, const std::string& label, CtrlAction a)
+	{
+		float bh = 56 * u;
+		Renderer::drawRoundRect(x, y, bw, bh, 10 * u, btnBg);
+		text(big, label, x, y + (bh - big->getHeight(1.0f)) / 2, bw, btnInk, ALIGN_CENTER);
+		mCtrlButtons.push_back({ x, y, bw, bh, a });
+	};
+
+	// the status: Wi-Fi and battery, in the status bar's colours when COLOURED STATUS ICONS is on
+	// (es-rgds-battery-charging.patch: green connected or charging, amber on but not connected, red low)
+	bool colours = Settings::getInstance()->getBool("RndsStatusColors");
+	auto net = WatchersManager::GetComponent<NetworkStateWatcher>();
+	bool online = net == nullptr || net->isConnected(), wifiOn = SystemConf::getInstance()->getBool("wifi.enabled");
+	std::string wifi = online ? _("Wi-Fi connected") : wifiOn ? _("Wi-Fi not connected") : _("Wi-Fi off");
+	unsigned int wifiCol = !colours ? ink : online ? 0x5FD068FF : wifiOn ? 0xF2B33DFF : muted;
+	float y = p.y + 34 * u;
+	text(small, wifi, x0, y, w / 2, wifiCol, ALIGN_LEFT);
+	auto batt = WatchersManager::GetComponent<BatteryLevelWatcher>();
+	if (batt != nullptr && batt->getBatteryInfo().hasBattery)
+	{
+		auto bi = batt->getBatteryInfo();
+		std::string bs = std::to_string(bi.level) + "%" + (bi.isCharging ? " " + _("charging") : "");
+		unsigned int bc = !colours ? ink : bi.isCharging ? 0x5FD068FF : bi.level <= 15 ? 0xFF3B4AFF : ink;
+		text(small, bs, x0 + w / 2, y, w / 2, bc, ALIGN_RIGHT);
+	}
+
+	// the slide's game
+	FileData* game = getCurrentGame();
+	y = p.y + 86 * u;
+	text(small, _("NOW SHOWING"), x0, y, w, muted, ALIGN_LEFT);
+	text(big, game ? game->getName() : _("No game"), x0, y + 24 * u, w, ink, ALIGN_LEFT);
+	float bw = (w - pad) / 2;
+	button(x0, y + 66 * u, bw, _("NEXT SLIDE"), CtrlAction::NextSlide);
+	if (game)
+		button(x0 + bw + pad, y + 66 * u, bw, _("PLAY THIS GAME"), CtrlAction::PlayGame);
+
+	// the music
+	y = p.y + 252 * u;
+	text(small, _("MUSIC"), x0, y, w, muted, ALIGN_LEFT);
+	if (!Settings::BackgroundMusic())
+		text(big, _("Music is off"), x0, y + 24 * u, w, ink, ALIGN_LEFT);
+	else
+	{
+		bool playing = AudioManager::getInstance()->isSongPlaying();
+		text(big, playing ? AudioManager::getInstance()->getSongName() : _("No music playing"), x0, y + 24 * u, w, ink, ALIGN_LEFT);
+		button(x0, y + 66 * u, bw, _("NEXT SONG"), CtrlAction::NextSong);
+		button(x0 + bw + pad, y + 66 * u, bw, playing ? _("STOP MUSIC") : _("PLAY MUSIC"), playing ? CtrlAction::StopMusic : CtrlAction::PlayMusic);
+	}
+
+	text(small, _("Tap the top screen or press a button to close"), x0, p.y + p.h - pad - 30 * u, w, muted, ALIGN_CENTER);
+}
+
 
