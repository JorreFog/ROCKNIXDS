+#define LATER_QUIET_MS 1500
+
+static Uint32 laterWake(Uint32, void*) { PowerSaver::pushRefreshEvent(); return 0; }
+
+void ViewController::onFileChangedLater(FileData* file)
+{
+	if (file == nullptr)
+		return;
+	auto key = std::make_pair(file->getSourceFileData()->getSystem(), file->getFullPath());
+	if (std::find(mLaterChanges.begin(), mLaterChanges.end(), key) == mLaterChanges.end())
+		mLaterChanges.push_back(key);
+	mLaterChangedAt = SDL_GetTicks();
+	SDL_AddTimer(LATER_QUIET_MS + 100, laterWake, nullptr);	// the power saver may sleep until the next event
+}
+
+void ViewController::applyLaterChanges(bool force)
+{
+	if (mLaterChanges.empty())
+		return;
+	Uint32 now = SDL_GetTicks();
+	if (!force && (now - mLaterChangedAt < LATER_QUIET_MS || now - mLastInputAt < LATER_QUIET_MS))
+		return;
+	auto changes = mLaterChanges;
+	mLaterChanges.clear();
+	// every list that shows one of the changed games, once (a repopulate rebuilds the whole list anyway)
+	std::map<IGameListView*, FileData*> views;
+	for (auto& c : changes)
+	{
+		if (std::find(SystemData::sSystemVector.begin(), SystemData::sSystemVector.end(), c.first) == SystemData::sSystemVector.end())
+			continue;	// the systems were reloaded meanwhile
+		FileData* file = c.first->getRootFolder()->FindByPath(c.second);
+		if (file == nullptr)
+			continue;
+		auto it = mGameListViews.find(c.first);
+		if (it != mGameListViews.cend())
+			views.emplace(it->second.get(), file);
+		else
+			for (auto& v : mGameListViews)
+				if (v.first->isGroupSystem() && v.first->getRootFolder()->FindByPath(c.second)) { views.emplace(v.second.get(), file); break; }
+		for (auto& coll : CollectionSystemManager::get()->getAutoCollectionSystems())
+		{
+			auto cit = mGameListViews.find(coll.second.system);
+			if (cit != mGameListViews.cend() && coll.second.system->getRootFolder()->FindByPath(c.second))
+				views.emplace(cit->second.get(), file);
+		}
+		for (auto& coll : CollectionSystemManager::get()->getCustomCollectionSystems())
+		{
+			auto cit = mGameListViews.find(coll.second.system);
+			if (cit != mGameListViews.cend() && coll.second.system->getRootFolder()->FindByPath(c.second))
+				views.emplace(cit->second.get(), file);
+		}
+	}
+	for (auto& v : views)
+		v.first->onFileChanged(v.second, FileChangeType::FILE_METADATA_CHANGED);
+}
