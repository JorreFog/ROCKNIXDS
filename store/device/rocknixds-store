#!/usr/bin/env python3
"""rocknixds-store: the ROCKNIXDS Store's package manager on the handheld (/storage/.config/rocknixds/store).

The Store app (the tile on the menu's shelf) runs this for everything it does; over ssh it works the same:

  rocknixds-store refresh          the catalog, the newest version of every app and their pictures, from the network
  rocknixds-store status           what's in the catalog, what's installed, what can be updated (for people)
  rocknixds-store list             the same for the Store app: one APP line and one DESC line per app (tab separated)
  rocknixds-store install <id>     installs or updates an app (the newest version, or --version X)
  rocknixds-store update [<id>]    updates that app, or every installed app with a newer version out
  rocknixds-store remove <id>      removes an app (what its package keeps, like its saves, stays)
  rocknixds-store relink           puts every installed app's tile back in the menu (after a ROCKNIXDS update)

Long jobs say each step on a line of their own (STEP <what>) and end with DONE <version> or FAIL <why>; a job that
fails leaves the app as it was. refresh ends with OK or OFFLINE.

The catalog (store/catalog.json in the ROCKNIXDS repository; RNDS_STORE_CATALOG names another, a URL or a file) lists
every app: what it is, where its releases are (GitHub releases, a tag prefix and the package's file name, or a pinned
URL and sha256), and how its package is laid out. A package is a .tar.gz with one folder; an app.json in that folder
can say the same things about its layout as the catalog does, and wins. store/README.md has the whole format.

An app is installed when its folder (/storage/.config/rocknixds/<id> unless it says otherwise) holds the package's
check file; its version is the folder's VERSION. So apps put there by their own installers (ROCKNIXDS's install.sh
for Döda Kvarter, install-bank.sh for the bank) count as installed, and the Store updates them in place.

Its entry in the menu is a tile of its own where ROCKNIXDS lists apps as systems (es_systems_rocknixds.cfg, ROCKNIXDS
1.6 on), else a line in Ports. An app ROCKNIXDS doesn't know yet gets its system from this tool
(es_systems_rocknixds-store.cfg beside ES's own list) and its icon and colour in ROCKNIXDS Pixel (a block at the end
of the theme's rnds/systems.cfg, the icon beside the theme's own): no ROCKNIXDS release is needed for a new app.

Host tests: RNDS_STORE_ROOT puts every handheld path under a folder; RNDS_STORE_API, RNDS_STORE_DOWNLOAD and the
catalog can be file:// URLs.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
import urllib.parse
import xml.etree.ElementTree as ET
import zlib

ROOT = os.environ.get("RNDS_STORE_ROOT", "")
CATALOG_URL = os.environ.get(
    "RNDS_STORE_CATALOG", "https://raw.githubusercontent.com/JorreFog/ROCKNIXDS/main/store/catalog.json")
API = os.environ.get("RNDS_STORE_API", "https://api.github.com/repos/{repo}/releases?per_page=100")
DOWNLOAD = os.environ.get("RNDS_STORE_DOWNLOAD", "https://github.com/{repo}/releases/download/{tag}/{asset}")
SCHEMA = 1                                  # the catalog format this tool reads


def P(path):
    """a handheld path (under RNDS_STORE_ROOT in the tests)"""
    return ROOT + path if path.startswith("/") else path


DATA = os.environ.get("RNDS_STORE_DATA") or P("/storage/.config/rocknixds/store/data")
ES_DIR = P("/storage/.config/emulationstation")
ES_STORE_CFG = os.path.join(ES_DIR, "es_systems_rocknixds-store.cfg")
ES_APPS_CFG = os.path.join(ES_DIR, "es_systems_rocknixds.cfg")       # ROCKNIXDS 1.6 on: apps have tiles
PORTS = "/storage/roms/ports"
THEME_MARK_BEGIN = "# ---- rocknixds-store: apps installed from the Store (rocknixds-store relink writes this) ----"
THEME_MARK_END = "# ---- rocknixds-store end ----"
MEDIA_KINDS = ("image", "thumbnail", "marquee")
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
VER_RE = re.compile(r"^[0-9]+(\.[0-9]+)*$")


class Fail(Exception):
    pass


def out(*parts):
    print(*parts, flush=True)


def step(msg):
    out("STEP " + msg)


# ---- versions, the handheld ---------------------------------------------------------------------------------------
def vkey(v):
    return [int(x) for x in re.findall(r"\d+", v or "")]


def newer(a, b):
    """a > b, by version"""
    return vkey(a) > vkey(b)


def device():
    """rgds-plus or rgds (RNDS_STORE_DEVICE in the tests)"""
    d = os.environ.get("RNDS_STORE_DEVICE")
    if d:
        return d
    try:
        with open("/proc/device-tree/model", "rb") as f:
            if b"RG DS Plus" in f.read():
                return "rgds-plus"
    except OSError:
        pass
    try:
        import glob
        for m in sorted(glob.glob("/sys/class/drm/card*-DSI-*/modes")):
            with open(m) as f:
                w = int(f.readline().split("x")[0])
            return "rgds-plus" if w > 640 else "rgds"
    except (OSError, ValueError):
        pass
    return "rgds"


def rocknixds_version():
    try:
        with open(P("/storage/.config/rocknixds-version")) as f:
            return f.read().split()[0]
    except (OSError, IndexError):
        return ""


# ---- network ------------------------------------------------------------------------------------------------------
def fetch(url, dest=None, timeout=30):
    """the body (bytes), or the file written; None when it can't be had. curl, as every ROCKNIXDS script on the
    handheld uses (file:// works for the tests)"""
    cmd = ["curl", "-fsSL", "--max-time", str(timeout), "-A", "rocknixds-store"]
    if dest:
        cmd += ["-o", dest]
    try:
        r = subprocess.run(cmd + [url], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    if r.returncode != 0:
        return None
    return dest if dest else r.stdout


def url_of(ref, base):
    """a catalog's path (relative to the catalog, or a URL) as a URL"""
    if re.match(r"^[a-z]+://", ref):
        return ref
    return urllib.parse.urljoin(base, ref)


def catalog_base():
    if re.match(r"^[a-z]+://", CATALOG_URL):
        return CATALOG_URL
    return "file://" + os.path.abspath(CATALOG_URL)


# ---- the data folder: the catalog and what the network said, cached --------------------------------------------
def data(name):
    return os.path.join(DATA, name)


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def catalog():
    c = load_json(data("catalog.json"), None)
    if c is None:
        # never refreshed: fetched now, else the copy that came with the Store (beside it; the repository's in a checkout)
        c = fetch_catalog()
        if c is not None:
            save_json(data("catalog.json"), c)
        else:
            here = os.path.dirname(os.path.abspath(__file__))
            c = load_json(os.path.join(here, "catalog.json"), None) or \
                load_json(os.path.join(here, "..", "catalog.json"), {"apps": []})
    return c


def fetch_catalog():
    body = fetch(catalog_base(), timeout=20)
    try:
        c = json.loads(body) if body else None
    except ValueError:
        return None
    return c if isinstance(c, dict) and isinstance(c.get("apps"), list) else None


def apps():
    out_ = []
    for a in catalog().get("apps", []):
        if isinstance(a, dict) and ID_RE.match(str(a.get("id", ""))):
            out_.append(a)
    return out_


def app_by_id(i):
    for a in apps():
        if a["id"] == i:
            return a
    raise Fail("No app called " + i)


# ---- an app's layout: the catalog's word, then the package's app.json ----------------------------------------------
def layout(app, pkg=None):
    """where an app goes and how its package looks: defaults, the catalog's "package" and "menu", the package's
    app.json (pkg) over both"""
    i = app["id"]
    lay = {
        "root": i,                                          # the package's one folder
        "dest": "/storage/.config/rocknixds/" + i,          # where it's installed
        "check": "",                                        # a file in it that says it's installed (else VERSION)
        "keep": [],                                         # folders and files in dest an update or a remove leaves
        "executable": [],                                   # made executable (every .sh is too)
        "version_default": "",                              # the version of an install without a VERSION file
        "post_install": "",                                 # a script in the package, run after it's in place
        "pre_remove": "",                                   # a script in dest, run before a remove
        "system": i,                                        # its ES system (its tile)
        "folder": "/storage/.config/rocknixds/apps/" + i,  # the tile's folder (the system's <path>)
        "entry": "",                                        # the script that starts it, in the package
        "media": {},                                        # image, thumbnail, marquee: pictures in the package
        "icon": "",                                         # a 32x32 picture in the package, for the tile
        "ports": True,                                      # without tiles: a line in Ports
        "unit": "",                                         # the systemd unit it runs in: no install while it's up
    }
    for src in (app.get("package"), app.get("menu"), pkg):
        if isinstance(src, dict):
            for k, v in src.items():
                if k in lay:
                    lay[k] = v
    for k in ("dest", "folder"):
        if not str(lay[k]).startswith("/storage/"):
            raise Fail("%s: %s must be under /storage" % (i, k))
    if not re.match(r"^[a-z0-9]{1,32}$", str(lay["system"])):
        raise Fail("%s: bad system name" % i)
    return lay


def safe_rel(p):
    p = str(p)
    if not p or p.startswith("/") or ".." in p.split("/"):
        raise Fail("bad path in the package's layout: " + p)
    return p


def stored_layout(app):
    """the layout of the copy installed, with its app.json (kept in dest) when it had one"""
    lay = layout(app)
    pkg = load_json(os.path.join(P(lay["dest"]), "app.json"), None)
    return layout(app, pkg) if pkg else lay


def installed_version(app):
    lay = stored_layout(app)
    d = P(lay["dest"])
    check = os.path.join(d, safe_rel(lay["check"])) if lay["check"] else os.path.join(d, "VERSION")
    if not os.path.exists(check):
        return ""
    try:
        with open(os.path.join(d, "VERSION")) as f:
            v = f.read().strip()
    except OSError:
        v = ""
    return v or lay["version_default"] or "0"


# ---- the newest release of each app -------------------------------------------------------------------------------
def releases(repo, cache):
    if repo not in cache:
        body = fetch(API.format(repo=repo), timeout=20)
        try:
            cache[repo] = json.loads(body) if body else None
        except ValueError:
            cache[repo] = None
    return cache[repo]


def resolve(app, cache):
    """{version, url, sha256 or sha256_url, size} of the newest release, or None (offline, none yet)"""
    rel = app.get("release") or {}
    if rel.get("url"):                                   # pinned: a version, its URL and its sha256 in the catalog
        if not (rel.get("version") and rel.get("sha256")):
            return None
        return {"version": rel["version"], "url": url_of(rel["url"], catalog_base()),
                "sha256": rel["sha256"].lower(), "size": rel.get("size", 0)}
    repo, prefix, asset = rel.get("github"), rel.get("tag_prefix"), rel.get("asset")
    if not (repo and prefix and asset):
        return None
    lst = releases(repo, cache)
    if not isinstance(lst, list):
        return None
    best = None
    for r in lst:
        t = r.get("tag_name") or ""
        if r.get("draft") or not t.startswith(prefix):
            continue
        v = t[len(prefix):]
        if not VER_RE.match(v) or (best and not newer(v, best["version"])):
            continue
        name = asset.format(version=v)
        size = 0
        for a in r.get("assets") or []:
            if a.get("name") == name:
                size = a.get("size") or 0
        url = DOWNLOAD.format(repo=repo, tag=t, asset=name)
        best = {"version": v, "url": url, "sha256_url": url + ".sha256", "size": size}
    return best


# ---- pictures for the Store app: PNG to raw ARGB (the app has no PNG decoder) ------------------------------------
def png_decode(blob):
    """(w, h, [ARGB ints]) of an 8-bit, non-interlaced PNG (grey, RGB, palette, grey+alpha, RGBA)"""
    if blob[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    pos, idat, pal, trns = 8, [], None, None
    w = h = depth = ctype = 0
    while pos + 8 <= len(blob):
        n = int.from_bytes(blob[pos:pos + 4], "big")
        typ, body = blob[pos + 4:pos + 8], blob[pos + 8:pos + 8 + n]
        pos += 12 + n
        if typ == b"IHDR":
            w, h = int.from_bytes(body[0:4], "big"), int.from_bytes(body[4:8], "big")
            depth, ctype, interlace = body[8], body[9], body[12]
            if interlace or depth != 8 or ctype not in (0, 2, 3, 4, 6):
                raise ValueError("unsupported PNG (8-bit, not interlaced only)")
        elif typ == b"PLTE":
            pal = body
        elif typ == b"tRNS":
            trns = body
        elif typ == b"IDAT":
            idat.append(body)
        elif typ == b"IEND":
            break
    bpp = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[ctype]
    raw = zlib.decompress(b"".join(idat))
    stride = w * bpp
    prev = bytearray(stride)
    rows = []
    p = 0
    for _ in range(h):
        f, line = raw[p], bytearray(raw[p + 1:p + 1 + stride])
        p += 1 + stride
        if f == 1:
            for i in range(bpp, stride):
                line[i] = (line[i] + line[i - bpp]) & 255
        elif f == 2:
            line = bytearray((a + b) & 255 for a, b in zip(line, prev))
        elif f == 3:
            for i in range(stride):
                left = line[i - bpp] if i >= bpp else 0
                line[i] = (line[i] + ((left + prev[i]) >> 1)) & 255
        elif f == 4:
            for i in range(stride):
                a = line[i - bpp] if i >= bpp else 0
                b = prev[i]
                c = prev[i - bpp] if i >= bpp else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        rows.append(line)
        prev = line
    px = []
    for line in rows:
        if ctype == 6:
            for i in range(0, stride, 4):
                px.append(line[i + 3] << 24 | line[i] << 16 | line[i + 1] << 8 | line[i + 2])
        elif ctype == 2:
            for i in range(0, stride, 3):
                px.append(0xFF000000 | line[i] << 16 | line[i + 1] << 8 | line[i + 2])
        elif ctype == 3:
            for i in line:
                r, g, b = pal[i * 3:i * 3 + 3] if pal and i * 3 + 2 < len(pal) else (0, 0, 0)
                a = trns[i] if trns and i < len(trns) else 255
                px.append(a << 24 | r << 16 | g << 8 | b)
        elif ctype == 4:
            for i in range(0, stride, 2):
                v = line[i]
                px.append(line[i + 1] << 24 | v << 16 | v << 8 | v)
        else:
            for v in line:
                px.append(0xFF000000 | v << 16 | v << 8 | v)
    return w, h, px


def resize(w, h, px, mw, mh):
    """fitted inside mw x mh, keeping its shape: averaged when smaller, whole-number nearest when bigger (pixel art)"""
    if w <= mw and h <= mh:
        k = max(1, min(mw // w, mh // h))
        if k == 1:
            return w, h, px
        nw, nh = w * k, h * k
        return nw, nh, [px[(y // k) * w + x // k] for y in range(nh) for x in range(nw)]
    s = max(w / mw, h / mh)
    nw, nh = max(1, int(w / s)), max(1, int(h / s))
    res = []
    for y in range(nh):
        y0, y1 = int(y * h / nh), max(int(y * h / nh) + 1, int((y + 1) * h / nh))
        for x in range(nw):
            x0, x1 = int(x * w / nw), max(int(x * w / nw) + 1, int((x + 1) * w / nw))
            n = a = r = g = b = 0
            for yy in range(y0, y1, max(1, (y1 - y0) // 2)):        # every other row and column: fast enough
                row = yy * w
                for xx in range(x0, x1, max(1, (x1 - x0) // 2)):
                    c = px[row + xx]
                    a += c >> 24; r += c >> 16 & 255; g += c >> 8 & 255; b += c & 255; n += 1
            res.append((a // n) << 24 | (r // n) << 16 | (g // n) << 8 | b // n)
    return nw, nh, res


def write_raw(path, w, h, px):
    """RNDSIMG1, width and height (16-bit little endian), then ARGB words (little endian): the Store app's format"""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(b"RNDSIMG1" + w.to_bytes(2, "little") + h.to_bytes(2, "little"))
        f.write(b"".join(c.to_bytes(4, "little") for c in px))
    os.replace(tmp, path)


def media_for(app, base):
    """the app's icon (32x32 at most) and first screenshot (160x120 at most) as raw pictures"""
    d = data(os.path.join("media", app["id"]))
    want = {"icon.raw": (app.get("icon"), 32, 32)}
    shots = app.get("screenshots") or []
    if shots:
        want["shot.raw"] = (shots[0], 160, 120)
    stamp = load_json(os.path.join(d, "sources.json"), {})
    for name, (ref, mw, mh) in want.items():
        if not ref:
            continue
        url = url_of(ref, base)
        if stamp.get(name) == url and os.path.exists(os.path.join(d, name)):
            continue
        blob = fetch(url, timeout=30)
        if not blob:
            continue
        try:
            w, h, px = png_decode(blob)
            if name == "icon.raw":                       # the tile's icon in the theme, for a package without one
                os.makedirs(d, exist_ok=True)
                with open(os.path.join(d, "icon.png"), "wb") as f:
                    f.write(blob)
            w, h, px = resize(w, h, px, mw, mh)
            write_raw(os.path.join(d, name), w, h, px)
            stamp[name] = url
        except (ValueError, zlib.error, IndexError, KeyError):
            continue
    save_json(os.path.join(d, "sources.json"), stamp)


# ---- EmulationStation: off while its lists change (unless the Store app already stopped it) -----------------------
class Menu:
    def __init__(self):
        self.stopped = False

    def off(self):
        if ROOT or os.environ.get("RNDS_STORE_NO_ES"):
            return
        if subprocess.run(["systemctl", "is-active", "-q", "essway.service"]).returncode != 0:
            return
        if subprocess.run(["systemctl", "is-active", "-q", "dsflip-game.service"]).returncode == 0:
            return                                           # a game runs: the change shows at the menu's next start
        playing = fetch("http://localhost:1234/runningGame", timeout=2) or b""
        if b'"path"' in playing:
            return
        subprocess.run(["systemctl", "stop", "essway.service"])
        self.stopped = True

    def on(self):
        if self.stopped:
            subprocess.run(["systemctl", "start", "essway.service"])
            self.stopped = False


def tiles():
    """this ROCKNIXDS gives apps tiles of their own (1.6 on)"""
    return os.path.exists(ES_APPS_CFG)


def gamelist(folder, action, entry, fields):
    gl = os.path.join(folder, "gamelist.xml")
    path = "./" + entry
    if os.path.exists(gl):
        try:
            tree = ET.parse(gl)
            root = tree.getroot()
        except ET.ParseError:
            out("STEP %s doesn't parse: left alone" % gl)
            return
    elif action == "remove":
        return
    else:
        root = ET.Element("gameList")
        tree = ET.ElementTree(root)
    for g in root.findall("game"):
        p = g.find("path")
        if p is not None and p.text and p.text.strip() in (path, entry):
            root.remove(g)
    if action == "add":
        g = ET.SubElement(root, "game")
        ET.SubElement(g, "path").text = path
        for k, v in fields:
            if v:
                ET.SubElement(g, k).text = v
    if hasattr(ET, "indent"):
        ET.indent(tree, space="\t")
    os.makedirs(folder, exist_ok=True)
    tmp = gl + ".tmp"
    tree.write(tmp, encoding="utf-8", xml_declaration=True)
    os.replace(tmp, gl)


def unlist(folder, lay):
    """the app's script, pictures and line out of that folder"""
    folder = P(folder)
    entry = lay["entry"]
    if not entry or not os.path.exists(os.path.join(folder, entry)):
        return
    gamelist(folder, "remove", entry, [])
    os.remove(os.path.join(folder, entry))
    for m in (lay["media"] or {}).values():
        try:
            os.remove(os.path.join(folder, "images", os.path.basename(m)))
        except OSError:
            pass


def list_in_menu(app, lay):
    """the app's entry where this ROCKNIXDS puts apps: its own tile, else Ports"""
    entry = lay["entry"]
    if not entry:
        return
    dest = P(lay["dest"])
    tile = tiles()
    if not tile and not lay["ports"]:
        return
    folder, other = (lay["folder"], PORTS) if tile else (PORTS, lay["folder"])
    unlist(other, lay)
    folder = P(folder)
    os.makedirs(os.path.join(folder, "images"), exist_ok=True)
    tmp = os.path.join(folder, entry + ".new")
    shutil.copyfile(os.path.join(dest, safe_rel(entry)), tmp)
    os.chmod(tmp, 0o755)
    os.replace(tmp, os.path.join(folder, entry))
    fields = [("name", app.get("name", app["id"])), ("desc", app.get("description") or app.get("summary", ""))]
    for k in MEDIA_KINDS:
        m = (lay["media"] or {}).get(k)
        if m and os.path.exists(os.path.join(dest, safe_rel(m))):
            shutil.copyfile(os.path.join(dest, m), os.path.join(folder, "images", os.path.basename(m)))
            fields.append((k, "./images/" + os.path.basename(m)))
    fields += [("releasedate", app.get("releasedate", "")), ("developer", app.get("developer", "")),
               ("publisher", app.get("publisher", app.get("developer", ""))), ("genre", app.get("genre", "")),
               ("players", app.get("players", ""))]
    gamelist(folder, "add", entry, fields)


# ---- tiles for apps ROCKNIXDS doesn't know: their ES system and their look in ROCKNIXDS Pixel ----------------------
def declared_systems():
    """the systems ES's other lists already declare"""
    names = set()
    try:
        files = os.listdir(ES_DIR)
    except OSError:
        return names
    for f in files:
        if f.startswith("es_systems") and f.endswith(".cfg") and os.path.join(ES_DIR, f) != ES_STORE_CFG:
            try:
                with open(os.path.join(ES_DIR, f), encoding="utf-8", errors="replace") as fh:
                    names.update(re.findall(r"<name>\s*([^<\s]+)\s*</name>", fh.read()))
            except OSError:
                pass
    return names


def esc(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def theme_dirs():
    """every theme's rnds folder with a systems.cfg (ROCKNIXDS Pixel's: the light theme uses the dark one's)"""
    t = os.path.join(ES_DIR, "themes")
    res = []
    try:
        for name in sorted(os.listdir(t)):
            d = os.path.join(t, name, "rnds")
            if os.path.isfile(os.path.join(d, "systems.cfg")) and not os.path.islink(d):
                res.append(d)
    except OSError:
        pass
    return res


def relink():
    """ES systems and theme lines for the installed apps that need them; stale ones go"""
    have = []
    if tiles():
        for a in apps():
            try:
                if installed_version(a):
                    lay = stored_layout(a)
                    if lay["entry"]:
                        have.append((a, lay))
            except Fail:
                continue
    # ES: a system for each app no other list declares
    known = declared_systems()
    blocks = []
    for a, lay in have:
        if lay["system"] in known:
            continue
        blocks.append("""	<system>
		<name>%s</name>
		<fullname>%s</fullname>
		<manufacturer>%s</manufacturer>
		<release>%s</release>
		<hardware>app</hardware>
		<path>%s</path>
		<extension>.sh</extension>
		<command>/usr/bin/runemu.sh %%ROM%% -Pports --core=%%CORE%% --emulator=%%EMULATOR%% --controllers="%%CONTROLLERSCONFIG%%"</command>
		<platform>ignore</platform>
		<theme>ports</theme>
		<emulators>
			<emulator name="portmaster">
				<cores>
					<core default="true">portmaster</core>
				</cores>
			</emulator>
		</emulators>
	</system>
""" % (lay["system"], esc(a.get("tile", a.get("name", a["id"]))), esc(a.get("developer", "")),
            esc(str(a.get("releasedate", ""))[:4]), lay["folder"]))
    if blocks:
        os.makedirs(ES_DIR, exist_ok=True)
        tmp = ES_STORE_CFG + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write('<?xml version="1.0"?>\n<!-- Written by rocknixds-store (the ROCKNIXDS Store): apps installed from '
                    'the Store that ROCKNIXDS\'s own es_systems_rocknixds.cfg doesn\'t list, each a system of one '
                    'entry. rocknixds-store relink writes it again. -->\n<systemList>\n')
            f.write("".join(blocks))
            f.write("</systemList>\n")
        os.replace(tmp, ES_STORE_CFG)
    elif os.path.exists(ES_STORE_CFG):
        os.remove(ES_STORE_CFG)
    # ROCKNIXDS Pixel: an icon, a colour and "[app]" for each app the theme doesn't name
    for d in theme_dirs():
        cfg = os.path.join(d, "systems.cfg")
        with open(cfg, encoding="utf-8") as f:
            text = f.read()
        b, e = text.find(THEME_MARK_BEGIN), text.find(THEME_MARK_END)
        if b >= 0 and e > b:
            text = text[:b].rstrip("\n") + "\n" + text[e + len(THEME_MARK_END):].lstrip("\n")
        named = set()
        for ln in text.splitlines():
            if ln and not ln.startswith(("#", "@", "*")):
                named.update(n.strip().lower() for n in ln.split()[0].split(","))
        lines, icons = [], set()
        for a, lay in have:
            if lay["system"] in named:
                continue
            icon = "-"
            src = os.path.join(P(lay["dest"]), safe_rel(lay["icon"])) if lay["icon"] else ""
            if not (src and os.path.exists(src)):
                src = data(os.path.join("media", a["id"], "icon.png"))
            if os.path.exists(src):
                icon = "store-%s.png" % a["id"]
                os.makedirs(os.path.join(d, "icons"), exist_ok=True)
                shutil.copyfile(src, os.path.join(d, "icons", icon))
                icons.add(icon)
            accent = a.get("accent", "#7d8b9c")
            if not re.match(r"^#[0-9a-fA-F]{6}$", accent):
                accent = "#7d8b9c"
            maker = re.sub(r"[\r\n#\[\]]", "", a.get("developer", "")) or "-"
            lines.append("%-55s %-15s %s   %s [app]" % (lay["system"], icon, accent, maker))
        if lines:
            text = text.rstrip("\n") + "\n\n" + THEME_MARK_BEGIN + "\n" + "\n".join(lines) + "\n" + THEME_MARK_END + "\n"
        tmp = cfg + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, cfg)
        for f in os.listdir(os.path.join(d, "icons")) if os.path.isdir(os.path.join(d, "icons")) else []:
            if f.startswith("store-") and f.endswith(".png") and f not in icons:
                os.remove(os.path.join(d, "icons", f))


# ---- install, update, remove --------------------------------------------------------------------------------------
def check_device(app):
    devs = app.get("devices")
    if devs and device() not in devs:
        raise Fail("Not made for this handheld")
    need = (app.get("requires") or {}).get("rocknixds")
    have = rocknixds_version()
    if need and have and newer(need, have):
        raise Fail("Needs ROCKNIXDS %s" % need)


def check_idle(lay):
    u = lay.get("unit")
    if u and not ROOT and subprocess.run(["systemctl", "is-active", "-q", u + ".service"]).returncode == 0:
        raise Fail("It's running: quit it first")


def extract(tgz, into):
    with tarfile.open(tgz, "r:gz") as t:
        for m in t.getmembers():
            n = m.name
            if n.startswith("/") or ".." in n.split("/") or not (m.isfile() or m.isdir() or m.issym()):
                raise Fail("Package damaged")
            if m.issym() and (m.linkname.startswith("/") or ".." in m.linkname.split("/")):
                raise Fail("Package damaged")
        try:
            t.extractall(into, filter="tar")
        except TypeError:                               # Python before 3.12
            t.extractall(into)


def install(app_id, version=None):
    app = app_by_id(app_id)
    check_device(app)
    step("Looking for it")
    cache = {}
    if version:
        rel = resolve_version(app, version, cache)
    else:
        rel = resolve(app, cache)
    if not rel:
        raise Fail("No network" if app.get("release", {}).get("github") else "No release yet")
    v = rel["version"]
    have = installed_version(app)
    if have and not version and not newer(v, have):
        out("DONE " + have)
        return
    work = data(".work-" + app_id)
    shutil.rmtree(work, ignore_errors=True)
    os.makedirs(work)
    try:
        step("Downloading %s" % v)
        pkg = os.path.join(work, "pkg.tar.gz")
        if not fetch(rel["url"], pkg, timeout=900):
            raise Fail("Download failed")
        step("Checking it")
        want = rel.get("sha256")
        if not want:
            body = fetch(rel["sha256_url"], timeout=30)
            want = body.decode("ascii", "replace").split()[0].lower() if body and body.split() else ""
        h = hashlib.sha256()
        with open(pkg, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        if not want or h.hexdigest() != want:
            raise Fail("Download damaged")
        x = os.path.join(work, "x")
        try:
            extract(pkg, x)
        except (tarfile.TarError, OSError, EOFError):
            raise Fail("Package damaged")
        lay = layout(app)
        src = os.path.join(x, safe_rel(lay["root"]))
        man = load_json(os.path.join(src, "app.json"), None)
        if man is not None:
            if man.get("id", app_id) != app_id:
                raise Fail("Wrong app inside")
            lay = layout(app, man)
        if not os.path.isdir(src):
            raise Fail("Package incomplete")
        check = os.path.join(src, safe_rel(lay["check"])) if lay["check"] else ""
        if check and not os.path.exists(check):
            raise Fail("Package incomplete")
        vf = os.path.join(src, "VERSION")
        if os.path.exists(vf):
            with open(vf) as f:
                if f.read().strip() != v:
                    raise Fail("Wrong version inside")
        else:
            with open(vf, "w") as f:
                f.write(v + "\n")
        for e in [lay["check"]] + list(lay["executable"]):
            if e and os.path.exists(os.path.join(src, safe_rel(e))):
                os.chmod(os.path.join(src, e), 0o755)
        for dp, _, fs in os.walk(src):
            for f in fs:
                if f.endswith(".sh"):
                    os.chmod(os.path.join(dp, f), 0o755)

        check_idle(lay)
        step("Installing %s" % v)
        menu = Menu()
        menu.off()
        try:
            if have:
                old_lay = stored_layout(app)
                if old_lay["dest"] != lay["dest"] or old_lay["entry"] != lay["entry"]:
                    unlist(old_lay["folder"], old_lay)
                    unlist(PORTS, old_lay)
            dest = P(lay["dest"])
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            new, old = dest + ".new", dest + ".old"
            shutil.rmtree(new, ignore_errors=True)
            shutil.rmtree(old, ignore_errors=True)
            shutil.move(src, new)
            # what an update leaves: the app's saves and settings, moved over from the copy there now
            if os.path.isdir(dest):
                for k in lay["keep"]:
                    k = safe_rel(k)
                    if os.path.lexists(os.path.join(dest, k)):
                        shutil.rmtree(os.path.join(new, k), ignore_errors=True)
                        os.makedirs(os.path.dirname(os.path.join(new, k)), exist_ok=True)
                        os.replace(os.path.join(dest, k), os.path.join(new, k))
                os.replace(dest, old)
            os.replace(new, dest)
            shutil.rmtree(old, ignore_errors=True)
            if lay["post_install"]:
                step("Setting it up")
                r = subprocess.run([os.path.join(dest, safe_rel(lay["post_install"]))], cwd=dest,
                                   env=dict(os.environ, RNDS_STORE_APP=app_id, RNDS_STORE_VERSION=v),
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if r.returncode != 0:
                    out("STEP Its setup script failed (%d)" % r.returncode)
            step("Adding it to the menu")
            list_in_menu(app, lay)
            relink()
        finally:
            menu.on()
    finally:
        shutil.rmtree(work, ignore_errors=True)
    out("DONE " + v)


def resolve_version(app, version, cache):
    rel = app.get("release") or {}
    if rel.get("url"):
        r = resolve(app, cache)
        return r if r and r["version"] == version else None
    repo, prefix, asset = rel.get("github"), rel.get("tag_prefix"), rel.get("asset")
    if not (repo and prefix and asset) or not VER_RE.match(version):
        return None
    url = DOWNLOAD.format(repo=repo, tag=prefix + version, asset=asset.format(version=version))
    return {"version": version, "url": url, "sha256_url": url + ".sha256", "size": 0}


def remove(app_id):
    app = app_by_id(app_id)
    if not installed_version(app):
        out("DONE")
        return
    lay = stored_layout(app)
    dest = P(lay["dest"])
    check_idle(lay)
    step("Removing it")
    menu = Menu()
    menu.off()
    try:
        if lay["pre_remove"] and os.path.exists(os.path.join(dest, safe_rel(lay["pre_remove"]))):
            subprocess.run([os.path.join(dest, lay["pre_remove"])], cwd=dest,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        unlist(lay["folder"], lay)
        unlist(PORTS, lay)
        keep = set(safe_rel(k).split("/")[0] for k in lay["keep"])
        for f in os.listdir(dest):
            if f in keep:
                continue
            p = os.path.join(dest, f)
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p)
            else:
                os.remove(p)
        if not os.listdir(dest):
            os.rmdir(dest)
        # the tile's folder, once nothing but the list and its empty pictures folder are left
        folder = P(lay["folder"])
        imgs = os.path.join(folder, "images")
        if os.path.isdir(folder) and set(os.listdir(folder)) <= {"images", "gamelist.xml"} and \
                not (os.path.isdir(imgs) and os.listdir(imgs)):
            shutil.rmtree(folder, ignore_errors=True)
        relink()
    finally:
        menu.on()
    out("DONE")


# ---- refresh, list, status ----------------------------------------------------------------------------------------
def refresh():
    c = fetch_catalog()
    if c is None:
        out("OFFLINE")
        return
    if c.get("schema", 1) > SCHEMA:
        c["newer_schema"] = True
    save_json(data("catalog.json"), c)
    cache, latest = {}, {}
    for a in apps():
        try:
            r = resolve(a, cache)
        except Exception:                                # a bad entry never stops the others
            r = None
        if r:
            latest[a["id"]] = {"version": r["version"], "size": r.get("size", 0)}
    save_json(data("latest.json"), {"time": int(time.time()), "apps": latest})
    base = catalog_base()
    for a in apps():
        try:
            media_for(a, base)
        except Exception:
            pass
    out("OK")


def tsv(s):
    return str(s).replace("\\", "\\\\").replace("\t", " ").replace("\r", "").replace("\n", "\\n")


def rows():
    latest = load_json(data("latest.json"), {}).get("apps", {})
    dev, rv = device(), rocknixds_version()
    res = []
    for a in apps():
        try:
            have = installed_version(a)
        except Fail:
            continue
        new = (latest.get(a["id"]) or {}).get("version", "")
        size = (latest.get(a["id"]) or {}).get("size", 0) or (a.get("release") or {}).get("size", 0)
        need = (a.get("requires") or {}).get("rocknixds")
        if a.get("devices") and dev not in a["devices"]:
            state = "unsupported"
        elif need and rv and newer(need, rv) and not have:
            state = "needs-" + need
        elif have and new and newer(new, have):
            state = "update"
        elif have:
            state = "installed"
        elif new:
            state = "install"
        else:
            state = "unavailable"
        res.append((a, have, new, state, size))
    return res


def cmd_list():
    stamp = load_json(data("latest.json"), {}).get("time", 0)
    out("CATALOG\t%d\t%d" % (len(apps()), stamp))
    for a, have, new, state, size in rows():
        if a.get("hidden"):                              # updated, not shown
            continue
        out("APP\t" + "\t".join(tsv(x) for x in (
            a["id"], a.get("kind", "app"), a.get("name", a["id"]), a.get("developer", ""), have, new, state,
            size, a.get("summary", ""), a.get("accent", ""), a.get("genre", ""), a.get("players", ""))))
        out("DESC\t%s\t%s" % (a["id"], tsv(a.get("description") or a.get("summary", ""))))


def cmd_status():
    print("%-14s %-24s %-10s %-10s %s" % ("ID", "NAME", "INSTALLED", "NEWEST", "STATE"))
    for a, have, new, state, _ in rows():
        print("%-14s %-24s %-10s %-10s %s" % (a["id"], a.get("name", "")[:24], have or "-", new or "?", state))
    if not load_json(data("latest.json"), {}).get("time"):
        print("(run rocknixds-store refresh for the newest versions)")


def update(app_id=None):
    if app_id:
        return install(app_id)
    todo = [a["id"] for a, have, new, state, _ in rows() if state == "update"]
    if not todo:
        out("DONE")
        return
    failed = []
    for i in todo:
        try:
            install(i)
        except Fail as e:
            failed.append("%s: %s" % (i, e))
            out("STEP %s failed: %s" % (i, e))
    if failed:
        raise Fail("; ".join(failed))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd, args = argv[0], argv[1:]
    os.makedirs(DATA, exist_ok=True)
    lockf = open(data(".lock"), "w")
    if cmd in ("install", "update", "remove", "relink", "refresh"):
        try:
            fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            out("FAIL The Store is busy with another job")
            return 1
    try:
        if cmd == "refresh":
            refresh()
        elif cmd == "list":
            cmd_list()
        elif cmd == "status":
            cmd_status()
        elif cmd == "install" and args:
            ver = None
            if "--version" in args:
                k = args.index("--version")
                ver = args[k + 1] if k + 1 < len(args) else None
                args = args[:k] + args[k + 2:]
            if os.geteuid() != 0 and not ROOT:
                raise Fail("Run it as root")
            install(args[0], ver)
        elif cmd == "update":
            update(args[0] if args else None)
        elif cmd == "remove" and args:
            if args[0] == "store" and not os.environ.get("RNDS_STORE_FORCE"):
                raise Fail("The Store doesn't remove itself (RNDS_STORE_FORCE=1 to insist)")
            remove(args[0])
        elif cmd == "relink":
            relink()
            out("DONE")
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except Fail as e:
        out("FAIL %s" % e)
        return 1
    except OSError as e:
        out("FAIL %s" % (e.strerror or e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
